@@ -3431,22 +3774,38 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
 
     /** Follows the keyboard while the sheet is open, so it never covers the field or the list. */
     private void onWindowLayout() {
-        if (!mOpen || !isSheetChrome()) return;
+        if (mInWindowLayout || !mOpen || !isSheetChrome()) return;
+        mInWindowLayout = true;
