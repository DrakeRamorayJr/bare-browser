+    /** Asks for the search keyboard once the sheet's window is focused. No-glass uses the activity. */
+    private void requestSearchIme() {
+        if (mSearchImeShownThisFocus) return;
+        EditText field = mSearchField;
+        if (field == null || !mOpen || !mSearchExpanded || !mSearchImeWanted) return;
+        pumpSearchIme();
+    }
+
+    private void pumpSearchIme() {
+        if (mSearchImeShownThisFocus) return;
+        EditText field = mSearchField;
+        if (field == null || !mOpen || !mSearchExpanded || !mSearchImeWanted) {
+            cancelSearchImeWait();
+            return;
+        }
+        if (!field.hasFocus() && !mRequestingSearchIme) {
+            mRequestingSearchIme = true;
+            try {
+                field.requestFocus();
+            } finally {
+                mRequestingSearchIme = false;
+            }
+        }
+        if (mSearchImeShownThisFocus || !mSearchImeWanted) return;
+        View decor = searchImeDecor();
+        if (field.hasFocus() && decor != null && windowIsFocused(decor)) {
+            showSearchImeNow(field);
+            return;
+        }
+        if (!mSearchImeWaiting) {
+            mSearchImeWaiting = true;
+            mSearchImeAttemptsLeft = FOCUS_IME_ATTEMPTS;
+            registerSearchImeFocusListener(decor);
+        }
+        if (mSearchImeRetry != null || mSearchImeAttemptsLeft <= 0) return;
+        mSearchImeAttemptsLeft--;
+        View target = decor != null ? decor : field;
+        Runnable retry =
+                new Runnable() {
+                    @Override
+                    public void run() {
+                        if (mSearchImeRetry != this) return;
+                        mSearchImeRetry = null;
+                        pumpSearchIme();
+                    }
+                };
+        mSearchImeRetry = retry;
+        mSearchImePostTarget = target;
+        target.post(retry);
+    }
+
+    private void registerSearchImeFocusListener(@Nullable View decor) {
+        if (decor == null || mSearchImeFocusListener != null) return;
+        ViewTreeObserver observer = decor.getViewTreeObserver();
+        if (!observer.isAlive()) return;
+        ViewTreeObserver.OnWindowFocusChangeListener listener =
+                hasFocus -> {
+                    if (hasFocus) requestSearchIme();
+                };
+        observer.addOnWindowFocusChangeListener(listener);
+        mSearchImeFocusListener = listener;
+        mSearchImeFocusView = decor;
+    }
+
+    private void showSearchImeNow(EditText field) {
+        if (mSearchImeShownThisFocus) return;
+        mSearchImeShownThisFocus = true;
+        cancelSearchImeWait();
+        Window window = searchImeWindow();
+        if (window != null
+                && (Build.VERSION.SDK_INT < Build.VERSION_CODES.R
+                        || window.getInsetsController() != null)) {
+            new WindowInsetsControllerCompat(window, field).show(WindowInsetsCompat.Type.ime());
+        }
+        InputMethodManager imm = mActivity.getSystemService(InputMethodManager.class);
+        if (imm != null) imm.showSoftInput(field, InputMethodManager.SHOW_IMPLICIT);
+        mSearchImeShows++;
+        View decor = window == null ? null : window.getDecorView();
+        if (decor != null) decor.post(this::onWindowLayout);
+    }
+
+    private void cancelSearchImeWait() {
+        mSearchImeWaiting = false;
+        Runnable retry = mSearchImeRetry;
+        mSearchImeRetry = null;
+        View postTarget = mSearchImePostTarget;
+        mSearchImePostTarget = null;
+        if (retry != null && postTarget != null) postTarget.removeCallbacks(retry);
+        View focusView = mSearchImeFocusView;
+        ViewTreeObserver.OnWindowFocusChangeListener listener = mSearchImeFocusListener;
+        mSearchImeFocusListener = null;
+        mSearchImeFocusView = null;
+        if (focusView != null && listener != null) {
+            ViewTreeObserver observer = focusView.getViewTreeObserver();
+            if (observer.isAlive()) observer.removeOnWindowFocusChangeListener(listener);
+        }
+    }
+
+    private @Nullable Window searchImeWindow() {
+        if (mGlass) {
+            Dialog dialog = mGlassWindow;
+            Window window = dialog != null ? dialog.getWindow() : null;
+            if (window != null) return window;
+        }
+        return mActivity.getWindow();
+    }
+
+    private @Nullable View searchImeDecor() {
+        Window window = searchImeWindow();
+        return window == null ? null : window.getDecorView();
+    }
+
+    private boolean windowIsFocused(@Nullable View decor) {
+        if (sWindowFocusedForTesting != null) return sWindowFocusedForTesting;
+        return decor != null && decor.hasWindowFocus();
+    }
+
+    /** Runs a remembered pill tap once the activity window has focus. */
+    private void deliverPendingOmniboxFocus() {
+        if (!mPendingOmniboxFocus || mOpen) return;
+        pumpOmniboxFocus();
+    }
+
+    private void pumpOmniboxFocus() {
+        if (!mPendingOmniboxFocus || mOpen) {
+            cancelPendingOmniboxFocus();
             return;
         }
-        if ((w.getAttributes().flags & WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE) == 0) {
-            w.addFlags(WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE);
+        Window window = mActivity.getWindow();
+        View decor = window == null ? null : window.getDecorView();
+        if (decor != null && windowIsFocused(decor)) {
+            runPendingOmniboxFocus();
+            return;
+        }
+        if (!mOmniboxFocusWaiting) {
+            mOmniboxFocusWaiting = true;
+            mOmniboxFocusAttemptsLeft = FOCUS_IME_ATTEMPTS;
+            if (decor != null) {
+                ViewTreeObserver observer = decor.getViewTreeObserver();
+                if (observer.isAlive()) {
+                    ViewTreeObserver.OnWindowFocusChangeListener listener =
+                            hasFocus -> {
+                                if (hasFocus) pumpOmniboxFocus();
+                            };
+                    observer.addOnWindowFocusChangeListener(listener);
+                    mOmniboxFocusListener = listener;
+                    mOmniboxFocusView = decor;
+                }
+            }
+        }
+        if (decor == null || mOmniboxFocusRetry != null || mOmniboxFocusAttemptsLeft <= 0) return;
+        mOmniboxFocusAttemptsLeft--;
+        Runnable retry =
+                new Runnable() {
+                    @Override
+                    public void run() {
+                        if (mOmniboxFocusRetry != this) return;
+                        mOmniboxFocusRetry = null;
+                        pumpOmniboxFocus();
+                    }
+                };
+        mOmniboxFocusRetry = retry;
+        mOmniboxFocusPostTarget = decor;
+        decor.post(retry);
+    }
+
+    private void runPendingOmniboxFocus() {
+        if (!mPendingOmniboxFocus || mOpen) {
+            cancelPendingOmniboxFocus();
+            return;
+        }
+        mPendingOmniboxFocus = false;
+        cancelOmniboxFocusWait();
+        mOmniboxFocusRequests++;
+        if (!(mActivity instanceof ChromeActivity chromeActivity)) return;
+        if (chromeActivity.getToolbarManager() == null) return;
+        chromeActivity
+                .getToolbarManager()
+                .focusAndSelectAllUrlBarText(OmniboxFocusReason.OMNIBOX_TAP);
+    }
+
+    private void cancelPendingOmniboxFocus() {
+        mPendingOmniboxFocus = false;
+        cancelOmniboxFocusWait();
+    }
+
+    private void cancelOmniboxFocusWait() {
+        mOmniboxFocusWaiting = false;
+        Runnable retry = mOmniboxFocusRetry;
+        mOmniboxFocusRetry = null;
+        View postTarget = mOmniboxFocusPostTarget;
+        mOmniboxFocusPostTarget = null;
+        if (retry != null && postTarget != null) postTarget.removeCallbacks(retry);
+        View focusView = mOmniboxFocusView;
+        ViewTreeObserver.OnWindowFocusChangeListener listener = mOmniboxFocusListener;
+        mOmniboxFocusListener = null;
+        mOmniboxFocusView = null;
+        if (focusView != null && listener != null) {
+            ViewTreeObserver observer = focusView.getViewTreeObserver();
+            if (observer.isAlive()) observer.removeOnWindowFocusChangeListener(listener);
         }
     }
 
+    /** Glass search reads the dialog window. Any other keyboard is on the activity window. */
+    private @Nullable View imeInsetDecor() {
+        View activityDecor =
+                mActivity.getWindow() == null ? null : mActivity.getWindow().getDecorView();
+        if (!(mGlass && mSearchExpanded)) return activityDecor;
+        Dialog dialog = mGlassWindow;
+        Window window = dialog != null ? dialog.getWindow() : null;
+        View dialogDecor = window != null ? window.getDecorView() : null;
+        if (dialogDecor == null) return activityDecor;
+        if (imeInsetBottom(dialogDecor) > 0 || imeInsetVisible(dialogDecor)) return dialogDecor;
+        return activityDecor;
+    }
+
+    private static int imeInsetBottom(@Nullable View decor) {
+        if (decor == null) return 0;
+        WindowInsets raw = decor.getRootWindowInsets();
+        if (raw == null) return 0;
+        return WindowInsetsCompat.toWindowInsetsCompat(raw)
+                .getInsets(WindowInsetsCompat.Type.ime())
+                .bottom;
+    }
+
+    private static boolean imeInsetVisible(@Nullable View decor) {
+        if (sImeVisibleForTesting != null) return sImeVisibleForTesting;
+        if (decor == null) return false;
+        WindowInsets raw = decor.getRootWindowInsets();
+        if (raw == null) return false;
+        return WindowInsetsCompat.toWindowInsetsCompat(raw)
+                .isVisible(WindowInsetsCompat.Type.ime());
+    }
