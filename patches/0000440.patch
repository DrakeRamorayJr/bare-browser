     /**
-     * The sheet's glass window is not focusable, which keeps taps outside it working, but a
-     * not-focusable window cannot take the keyboard. While the in-row field is up, that one
-     * window accepts text. {@code FLAG_ALT_FOCUSABLE_IM} stays set so the keyboard is not covered.
+     * The sheet's glass window is not focusable, which keeps taps outside it working, and
+     * {@code FLAG_ALT_FOCUSABLE_IM} keeps that not-focusable window behind the keyboard. Those
+     * two flags together mean "behind the keyboard". Clearing only {@code FLAG_NOT_FOCUSABLE}
+     * inverts the other flag: the window then refuses the keyboard and {@code showSoftInput} is
+     * ignored. While the in-row field is up, clear both and do not let the system resize the
+     * window. {@link #onWindowLayout} keeps the sheet above the keyboard. Ending the search puts
+     * both flags, and the previous soft-input mode, back.
      */
     private void setSheetWindowFocusForSearch(boolean allow) {
         Dialog dialog = mGlassWindow;
         Window w = dialog != null ? dialog.getWindow() : null;
         if (w == null || !mGlass || !isSheetChrome()) return;
         if (allow) {
-            w.clearFlags(WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE);
+            if (!mSoftInputModeSaved) {
+                mSavedSoftInputMode = w.getAttributes().softInputMode;
+                mSoftInputModeSaved = true;
+            }
+            w.clearFlags(
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                            | WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM);
+            w.setSoftInputMode(
+                    WindowManager.LayoutParams.SOFT_INPUT_ADJUST_NOTHING
+                            | WindowManager.LayoutParams.SOFT_INPUT_STATE_UNCHANGED);
+            return;
+        }
+        cancelSearchImeWait();
+        if (mSoftInputModeSaved) {
+            w.setSoftInputMode(mSavedSoftInputMode);
+            mSoftInputModeSaved = false;
+        }
+        int restore = 0;
+        int flags = w.getAttributes().flags;
+        if ((flags & WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE) == 0) {
+            restore |= WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE;
+        }
+        if ((flags & WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM) == 0) {
+            restore |= WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM;
+        }
+        if (restore != 0) w.addFlags(restore);
+    }
