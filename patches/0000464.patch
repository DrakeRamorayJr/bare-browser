+        // From half open on, the sheet covers the bar slot. The cover left in front
+        // is the blank band under a full sheet and the clip on the half-open row.
+        // close() clears mOpen before it lays this out, so the hand-off still paints it.
+        if (openBottomBarCoverYieldsToSheet()) {
+            if (cover.getVisibility() != View.GONE) cover.setVisibility(View.GONE);
+            hideBottomButtonCover();
+            tickGhostCover(root);
+            return;
+        }
         // Cover from the live location-bar top to the bottom of the sheet window.
