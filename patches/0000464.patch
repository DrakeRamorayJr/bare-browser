+    /**
+     * The opening drag below half still paints the bar cover, which hides the compositor
+     * pill while the five-button row slides off. At half and full the sheet covers that
+     * slot, so the cover would only clip the action row or leave a blank band under it.
+     * close() clears the open flag before the hand-off, which paints the cover again.
+     */
+    private boolean openBottomBarCoverYieldsToSheet() {
+        // mMorphClosing is also set while an open sheet is dragged down. That drag
+        // is not the hand-off. The hand-off runs with the sheet already closed.
+        if (!mOpen || mForceBarRect || mCloseReveal) return false;
+        if (mProgress < BareTabSheetSnap.HALF_RATIO) return false;
+        return buttonBarGone() >= 0.999f;
+    }
