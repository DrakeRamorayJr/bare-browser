+    @Test
+    public void testFullOpenSheetFillsDownToTheNavSeam() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        try {
+            View root = layOutStackedBottomBar(37, 0.05f);
+            mDrawer.applyProgressForTesting(1f);
+            layoutOverlay(root, px(400), px(800));
+            mDrawer.applyProgressForTesting(1f);
+            layoutOverlay(root, px(400), px(800));
+
+            View actions = findTag("sheet_actions");
+            View panel = (View) actions.getParent();
+            View cover = findTag("sheet_bottom_bar_cover");
+            View fill = mDrawer.seamFillForTesting();
+            assertNotNull(cover);
+            assertNotNull(fill);
+            assertEquals(View.GONE, cover.getVisibility());
+            assertEquals(View.VISIBLE, fill.getVisibility());
+            assertEquals(px(12), ((FrameLayout.LayoutParams) fill.getLayoutParams()).height);
+            assertEquals(px(8), panel.getTop(), 2f);
+            assertEquals(px(12), panelBottomMargin(panel));
+            assertTrue(root.getHeight() - panel.getBottom() <= px(12) + 2);
+            int actionsBottom = panel.getTop() + actions.getBottom();
+            assertTrue(
+                    "actions " + actionsBottom + " root " + root.getHeight(),
+                    actionsBottom + px(12) <= root.getHeight() + 1);
+            assertTrue(actions.getHeight() > px(48));
+        } finally {
+            removeStackedBottomChrome();
+        }
+    }
+
+    @Test
+    public void testHalfOpenActionRowClearsTheCover() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        try {
+            View root = layOutStackedBottomBar(37, BareTabSheetSnap.HALF_RATIO);
+            View actions = findTag("sheet_actions");
+            View panel = (View) actions.getParent();
+            View cover = findTag("sheet_bottom_bar_cover");
+            assertNotNull(cover);
+            assertEquals(View.GONE, cover.getVisibility());
+            assertTrue(actions.getHeight() > px(48));
+            assertEquals(0f, actions.getTranslationY(), 0f);
+            assertEquals(px(12), panelBottomMargin(panel));
+            assertEquals(
+                    Math.round(
+                            BareTabSheetSnap.HALF_RATIO
+                                    * (root.getHeight() - sheetGap() - px(12))),
+                    ((FrameLayout.LayoutParams) panel.getLayoutParams()).height);
+            int actionsBottom = panel.getTop() + actions.getBottom();
+            assertTrue(actions.getBottom() <= panel.getHeight());
+            assertTrue(
+                    "actions " + actionsBottom + " root " + root.getHeight(),
+                    actionsBottom + px(12) <= root.getHeight() + 1);
+        } finally {
+            removeStackedBottomChrome();
+        }
+    }
