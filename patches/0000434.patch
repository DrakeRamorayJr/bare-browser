+    /**
+     * The drawer's glass window covers the screen. The sheet's ends at the toolbars (see
+     * applySheetInsets), so the bars are neither blurred nor dimmed and their taps reach the
+     * activity: the window is not focusable, which also lets touches outside it through.
+     */
+    private void shapeGlassWindow() {
+        Dialog window = mGlassWindow;
+        Window w = window != null ? window.getWindow() : null;
+        if (w == null) return;
+        if (isSheetChrome()) {
+            applySheetInsets();
+            return;
+        }
+        WindowManager.LayoutParams attributes = w.getAttributes();
+        if (attributes.y == 0
+                && attributes.height == ViewGroup.LayoutParams.MATCH_PARENT
+                && attributes.gravity == Gravity.NO_GRAVITY) {
+            return;
+        }
+        attributes.y = 0;
+        attributes.gravity = Gravity.NO_GRAVITY;
+        attributes.width = ViewGroup.LayoutParams.MATCH_PARENT;
+        attributes.height = ViewGroup.LayoutParams.MATCH_PARENT;
+        w.setAttributes(attributes);
+    }
+
+    /** Bounds the sheet's glass window to the content between the toolbars. */
+    private void placeSheetGlassWindow(int top, int bottom) {
+        Dialog window = mGlassWindow;
+        Window w = window != null ? window.getWindow() : null;
+        View content = mActivity.findViewById(android.R.id.content);
+        if (w == null || content == null) return;
+        int[] location = new int[2];
+        content.getLocationOnScreen(location);
+        int contentHeight =
+                content.getHeight() > 0
+                        ? content.getHeight()
+                        : mActivity.getResources().getDisplayMetrics().heightPixels;
+        int y = location[1] + top;
+        int height = Math.max(1, contentHeight - top - bottom);
+        WindowManager.LayoutParams attributes = w.getAttributes();
+        int gravity = Gravity.TOP | Gravity.FILL_HORIZONTAL;
+        if (attributes.y == y && attributes.height == height && attributes.gravity == gravity) {
+            return;
+        }
+        attributes.gravity = gravity;
+        attributes.y = y;
+        attributes.width = ViewGroup.LayoutParams.MATCH_PARENT;
+        attributes.height = height;
+        w.setAttributes(attributes);
+    }
