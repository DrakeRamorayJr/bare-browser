+    @Test
+    public void testTheBottomSheetScalesAndDimsThePageAndRestoresIt() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        View page = attachPage();
+        WindowInsetsControllerCompat icons =
+                new WindowInsetsControllerCompat(
+                        mActivity.getWindow(), mActivity.getWindow().getDecorView());
+        icons.setAppearanceLightStatusBars(true);
+        mActivity.getWindow().setStatusBarColor(0xFF112233);
+
+        mDrawer.open();
+        mDrawer.finishAnimationForTesting();
+        Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();
+        assertEquals(BareTabSheetSnap.HALF_RATIO, mDrawer.progressForTesting(), 0.01f);
+        assertEquals(0.95f, page.getScaleX(), 0.02f);
+        assertEquals(0.95f, page.getScaleY(), 0.02f);
+        assertTrue(page.getClipToOutline());
+        View scrim = sheetScrim();
+        assertTrue(scrim.getAlpha() >= 0.3f && scrim.getAlpha() <= 0.4f);
+        assertEquals(0, mDrawer.blurRadiusForTesting());
+        View shade = mActivity.getWindow().getDecorView().findViewWithTag("page_dim_shade");
+        assertNotNull(shade);
+        assertEquals(0.35f, shade.getAlpha(), 0.02f);
+        int[] rootOnScreen = new int[2];
+        ((View) scrim.getParent()).getLocationOnScreen(rootOnScreen);
+        assertEquals(
+                Math.max(0, rootOnScreen[1]) + sheetGap(), shade.getLayoutParams().height);
+        FrameLayout.LayoutParams scrimParams = (FrameLayout.LayoutParams) scrim.getLayoutParams();
+        assertEquals(sheetGap(), scrimParams.topMargin);
+        assertEquals(android.graphics.Color.TRANSPARENT, mActivity.getWindow().getStatusBarColor());
+        assertFalse(icons.isAppearanceLightStatusBars());
+        View backdrop = page.getParent() instanceof ViewGroup parent
+                ? parent.findViewWithTag("page_card_backdrop")
+                : null;
+        assertNotNull(backdrop);
+        assertEquals(1f, backdrop.getAlpha(), 0.02f);
+
+        mDrawer.close();
+        mDrawer.finishAnimationForTesting();
+        Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();
+        assertEquals(1f, page.getScaleX(), 0.001f);
+        assertEquals(1f, page.getScaleY(), 0.001f);
+        assertFalse(page.getClipToOutline());
+        assertEquals(0f, scrim.getAlpha(), 0.001f);
+        assertTrue(icons.isAppearanceLightStatusBars());
+        assertEquals(0xFF112233, mActivity.getWindow().getStatusBarColor());
+        assertTrue(shade.getVisibility() == View.GONE || shade.getAlpha() == 0f);
+    }
