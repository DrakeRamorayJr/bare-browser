+    private void placeSheetScrim(View scrim, boolean leaveTopBand) {
+        if (!(scrim.getLayoutParams() instanceof FrameLayout.LayoutParams params)) return;
+        int top = leaveTopBand ? dp(SHEET_FULL_GAP_DP) : 0;
+        if (params.topMargin == top) return;
+        params.topMargin = top;
+        scrim.setLayoutParams(params);
+    }
+
+    /** Glass is off, so the sheet must not leave a blur radius on its window. */
+    private void clearBlur() {
+        if (mBlurRadius == 0) return;
+        mBlurRadius = 0;
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) return;
+        Dialog dialog = mGlassWindow;
+        Window w = dialog != null ? dialog.getWindow() : null;
+        if (w != null) w.setBackgroundBlurRadius(0);
+    }
+
+    /**
+     * Scales the page content under a bottom sheet and rounds it. {@code dim} is 0 when
+     * closed and 1 from half-open up. The compositor view is the page; the sheet, the bottom
+     * toolbar and the origin pill are not children of it, so they stay full size.
+     */
+    private void applyPageCard(float dim) {
+        boolean on = dim > 0.001f;
+        if (!on && !mPageCardArmed) return;
+        View page = mActivity.findViewById(R.id.compositor_view_holder);
+        if (page != null) {
+            if (on) {
+                float scale = 1f - dim * (1f - PAGE_SCALE);
+                page.setPivotX(page.getWidth() * 0.5f);
+                page.setPivotY(0f);
+                page.setScaleX(scale);
+                page.setScaleY(scale);
+                mPageCornerRadius = dp(PAGE_CORNER_DP) * dim;
+                page.setOutlineProvider(mPageOutline);
+                page.setClipToOutline(true);
+                page.invalidateOutline();
+                ensurePageBackdrop(page, dim);
+            } else {
+                page.setPivotX(page.getWidth() * 0.5f);
+                page.setPivotY(page.getHeight() * 0.5f);
+                page.setScaleX(1f);
+                page.setScaleY(1f);
+                page.setClipToOutline(false);
+                page.setOutlineProvider(ViewOutlineProvider.BACKGROUND);
+                hidePageBackdrop();
+            }
+        } else if (!on) {
+            hidePageBackdrop();
+        }
+        // The measured white band under the status bar is ~6.6dp. The full sheet already
+        // stops SHEET_FULL_GAP_DP (8dp) short of the overlay top, so a shade of that depth
+        // covers the band and does not cover the sheet or the origin pill.
+        applyPageShade(on ? dim * PAGE_DIM_ALPHA : 0f, on && !mGlass);
+        applyStatusBarForPageCard(on);
+        if (on && mGlass) flattenGlassDecor();
+        mPageCardArmed = on;
+    }
+
+    private void restorePageCard() {
+        applyPageCard(0f);
+    }
+
+    private void releasePageCard() {
+        restorePageCard();
+        detachView(mPageShade);
+        mPageShade = null;
+        detachView(mPageBackdrop);
+        mPageBackdrop = null;
+        mPageCardArmed = false;
+    }
+
+    private void ensurePageBackdrop(View page, float dim) {
+        if (!(page.getParent() instanceof ViewGroup parent)) return;
+        if (mPageBackdrop == null || mPageBackdrop.getParent() != parent) {
+            if (parent.isInLayout()) {
+                postPageCard(parent);
+                return;
+            }
+            detachView(mPageBackdrop);
+            View backdrop = new View(mActivity);
+            backdrop.setTag("page_card_backdrop");
+            backdrop.setBackgroundColor(Color.BLACK);
+            backdrop.setClickable(false);
+            backdrop.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+            parent.addView(
+                    backdrop,
+                    parent.indexOfChild(page),
+                    new ViewGroup.LayoutParams(
+                            ViewGroup.LayoutParams.MATCH_PARENT,
+                            ViewGroup.LayoutParams.MATCH_PARENT));
+            mPageBackdrop = backdrop;
+        }
+        mPageBackdrop.setAlpha(dim);
+        mPageBackdrop.setVisibility(View.VISIBLE);
+    }
+
+    private void hidePageBackdrop() {
+        if (mPageBackdrop == null) return;
+        mPageBackdrop.setAlpha(0f);
+        mPageBackdrop.setVisibility(View.GONE);
+    }
+
+    private void applyPageShade(float alpha, boolean coverTopBand) {
+        if (alpha <= 0.001f) {
+            if (mPageShade != null) {
+                mPageShade.setAlpha(0f);
+                mPageShade.setVisibility(View.GONE);
+            }
+            return;
+        }
+        View decorView = mActivity.getWindow().getDecorView();
+        if (!(decorView instanceof FrameLayout decor)) return;
+        FrameLayout root = mRoot;
+        if (root == null) return;
+        if (mPageShade == null) {
+            if (decor.isInLayout()) {
+                postPageCard(decor);
+                return;
+            }
+            View shade = new View(mActivity);
+            shade.setTag("page_dim_shade");
+            shade.setBackgroundColor(Color.BLACK);
+            shade.setOnClickListener(v -> close());
+            shade.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+            decor.addView(
+                    shade,
+                    new FrameLayout.LayoutParams(
+                            ViewGroup.LayoutParams.MATCH_PARENT, 0, Gravity.TOP));
+            mPageShade = shade;
+        }
+        int[] loc = new int[2];
+        root.getLocationOnScreen(loc);
+        int extra = coverTopBand ? dp(SHEET_FULL_GAP_DP) : 0;
+        int height = Math.max(0, loc[1]) + extra;
+        ViewGroup.LayoutParams lp = mPageShade.getLayoutParams();
+        if (lp.height != height) {
+            lp.height = height;
+            mPageShade.setLayoutParams(lp);
+        }
+        mPageShade.setAlpha(alpha);
+        mPageShade.setVisibility(height > 0 ? View.VISIBLE : View.GONE);
+        // bringChildToFront requests a layout. Only when something else has covered the shade.
+        if (height > 0 && decor.getChildAt(decor.getChildCount() - 1) != mPageShade) {
+            decor.bringChildToFront(mPageShade);
+        }
+    }
+
+    /** Re-reads progress after layout, so a view add is not done inside a layout pass. */
+    private void postPageCard(View host) {
+        if (mPageCardPost) return;
+        mPageCardPost = true;
+        host.post(
+                () -> {
+                    mPageCardPost = false;
+                    if (mRoot == null) return;
+                    if (!(isSheetChrome() && !sheetFromTop())) {
+                        restorePageCard();
+                        return;
+                    }
+                    float half = BareTabSheetSnap.HALF_RATIO;
+                    float dim = half <= 0f ? mProgress : Math.min(1f, mProgress / half);
+                    applyPageCard(dim);
+                });
+    }
+
+    /**
+     * The status bar stays transparent while the sheet is up, so the dim shows through it
+     * instead of a separate scrim band. Icons switch to light over that dim, and both the
+     * color and the icon appearance come back on close.
+     */
+    private void applyStatusBarForPageCard(boolean dimmed) {
+        Window window = mActivity.getWindow();
+        View decor = window.getDecorView();
+        WindowInsetsControllerCompat controller = new WindowInsetsControllerCompat(window, decor);
+        if (dimmed) {
+            if (!mHaveSavedLightStatusBar) {
+                mSavedLightStatusBar = controller.isAppearanceLightStatusBars();
+                mHaveSavedLightStatusBar = true;
+            }
+            if (!mHaveSavedStatusBarColor) {
+                mSavedStatusBarColor = window.getStatusBarColor();
+                mHaveSavedStatusBarColor = true;
+            }
+            if (window.getStatusBarColor() != Color.TRANSPARENT) {
+                window.setStatusBarColor(Color.TRANSPARENT);
+            }
+            // false: light icons over the dark dim. Skip the call when they are already light.
+            if (controller.isAppearanceLightStatusBars()) {
+                controller.setAppearanceLightStatusBars(false);
+            }
+            return;
+        }
+        if (mHaveSavedLightStatusBar) {
+            controller.setAppearanceLightStatusBars(mSavedLightStatusBar);
+            mHaveSavedLightStatusBar = false;
+        }
+        if (mHaveSavedStatusBarColor) {
+            window.setStatusBarColor(mSavedStatusBarColor);
+            mHaveSavedStatusBarColor = false;
+        }
+    }
+
+    /** The glass dialog must not paint a padded strip under the status bar. */
+    private void flattenGlassDecor() {
+        if (!isSheetChrome()) return;
+        Dialog dialog = mGlassWindow;
+        Window w = dialog != null ? dialog.getWindow() : null;
+        if (w == null) return;
+        WindowCompat.setDecorFitsSystemWindows(w, false);
+        View decor = w.getDecorView();
+        if (decor.getPaddingLeft() != 0
+                || decor.getPaddingTop() != 0
+                || decor.getPaddingRight() != 0
+                || decor.getPaddingBottom() != 0) {
+            decor.setPadding(0, 0, 0, 0);
+        }
+        if (w.getStatusBarColor() != Color.TRANSPARENT) w.setStatusBarColor(Color.TRANSPARENT);
+    }
+
+    private static void detachView(@Nullable View view) {
+        if (view == null || !(view.getParent() instanceof ViewGroup parent)) return;
+        if (parent.isInLayout()) {
+            parent.post(() -> detachView(view));
+            return;
+        }
+        parent.removeView(view);
+    }
+
     private void setStatusBarScrim(@ColorInt int color) {
         if (color == mStatusBarScrimColor) return;
         mStatusBarScrimColor = color;
