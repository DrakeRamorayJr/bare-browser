+    @Test
+    public void testTheActionRowUsesTheSheetSurface() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        try {
+            for (boolean night : new boolean[] {false, true}) {
+                setNightMode(night);
+                for (boolean glass : new boolean[] {false, true}) {
+                    if (mDrawer.isOpen()) {
+                        mDrawer.close();
+                        mDrawer.finishAnimationForTesting();
+                    }
+                    BareVerticalTabsDrawer.setGlassForTesting(glass);
+                    mDrawer.open();
+                    mDrawer.finishAnimationForTesting();
+                    View actions = sheetActions(glass);
+                    int expected =
+                            glass
+                                    ? (night ? 0xA61C1A20 : 0xB8F1EDF6)
+                                    : (night ? 0xFF1C1A20 : 0xFFF1EDF6);
+                    assertEquals(
+                            "night=" + night + " glass=" + glass,
+                            expected,
+                            drawableColor(((View) actions.getParent()).getBackground()));
+                    assertEquals(
+                            "night=" + night + " glass=" + glass,
+                            expected,
+                            drawableColor(actions.getBackground()));
+                }
+            }
+        } finally {
+            setNightMode(false);
+            BareVerticalTabsDrawer.setGlassForTesting(false);
+        }
+    }
+
+    @Test
+    public void testOnlyABottomBarSheetLeavesAGapAboveTheToolbar() {
+        setAddressBarOnTop(false);
+        LinearLayout panel = openSheetLaidOut(px(400), px(800));
+        assertEquals(px(8), panelBottomMargin(panel));
+        assertBottomCornersMatchTop(panel);
+
+        mDrawer.finishSheetDragForTesting(-10_000f);
+        mDrawer.finishAnimationForTesting();
+        View root = (View) panel.getParent();
+        layoutOverlay(root, px(400), px(800));
+        layoutOverlay(root, px(400), px(800));
+        assertEquals(px(8), panelBottomMargin(panel));
+        assertEquals(px(8), panel.getTop(), 1f);
+        assertEquals(px(8), root.getHeight() - panel.getBottom(), 1f);
+
+        findTag("sheet_search").performClick();
+        ShadowLooper.idleMainLooper();
+        mDrawer.finishAnimationForTesting();
+        layoutOverlay(root, px(400), px(800));
+        View field = findTag("sheet_search_field");
+        assertEquals(View.VISIBLE, field.getVisibility());
+        assertEquals(findTag("sheet_actions"), field.getParent());
+        assertEquals(px(8), panelBottomMargin(panel));
+
+        mDrawer.close();
+        mDrawer.finishAnimationForTesting();
+        setAddressBarOnTop(true);
+        panel = openSheetLaidOut(px(400), px(800));
+        assertEquals(0, panelBottomMargin(panel));
+        float[] topRadii = ((GradientDrawable) panel.getBackground()).getCornerRadii();
+        assertNotNull(topRadii);
+        for (int i = 0; i < 4; i++) assertEquals(0f, topRadii[i], 0.6f);
+        for (int i = 4; i < 8; i++) assertEquals((float) px(20), topRadii[i], 0.6f);
+
+        mDrawer.close();
+        mDrawer.finishAnimationForTesting();
+        BareTabsStyle.setStyle(BareTabsStyle.DRAWER);
+        mDrawer.open();
+        mDrawer.finishAnimationForTesting();
+        View drawerPanel = (View) findTag("sheet_actions").getParent();
+        assertEquals(0, panelBottomMargin(drawerPanel));
+    }
+
+    private void setNightMode(boolean night) {
+        android.content.res.Configuration config = mActivity.getResources().getConfiguration();
+        int mode =
+                night
+                        ? android.content.res.Configuration.UI_MODE_NIGHT_YES
+                        : android.content.res.Configuration.UI_MODE_NIGHT_NO;
+        config.uiMode =
+                (config.uiMode & ~android.content.res.Configuration.UI_MODE_NIGHT_MASK) | mode;
+        mActivity
+                .getResources()
+                .updateConfiguration(config, mActivity.getResources().getDisplayMetrics());
+    }
+
+    private View sheetActions(boolean glass) {
+        if (!glass) return findTag("sheet_actions");
+        android.app.Dialog dialog = mDrawer.glassWindowForTesting();
+        assertNotNull(dialog);
+        return findTag(dialog.getWindow().getDecorView(), "sheet_actions");
+    }
+
+    private static int drawableColor(Drawable drawable) {
+        assertNotNull(drawable);
+        if (drawable instanceof ColorDrawable color) return color.getColor();
+        return ((GradientDrawable) drawable).getColor().getDefaultColor();
+    }
+
+    private static int panelBottomMargin(View panel) {
+        return ((FrameLayout.LayoutParams) panel.getLayoutParams()).bottomMargin;
+    }
+
+    private void assertBottomCornersMatchTop(View panel) {
+        float[] radii = ((GradientDrawable) panel.getBackground()).getCornerRadii();
+        assertNotNull(radii);
+        float radius = px(20);
+        for (float corner : radii) assertEquals(radius, corner, 0.6f);
+    }
+
     private void layoutOverlay(View root, int width, int height) {
         root.measure(
                 View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
