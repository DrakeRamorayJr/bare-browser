-                mSheetActions.setBackgroundColor(color(0xFF1C1A20, 0xFFF1EDF6));
+                applyActionsSurface();
             }
             if (mList != null) {
                 mList.setPadding(0, 0, 0, 0);
@@ -1507,16 +1510,33 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
         }
         int radius = dp(20);
         GradientDrawable background = new GradientDrawable();
-        background.setColor(
-                mGlass ? color(0xA61C1A20, 0xB8F1EDF6) : color(0xFF1C1A20, 0xFFF1EDF6));
-        // The corners on the free edge are round: the top when rising, the bottom when dropping.
+        background.setColor(sheetSurfaceColor());
+        // Rising over the bottom toolbar, the sheet is a card: the bottom corners match
+        // the top. Dropping from a top bar, only the free bottom edge is round.
         background.setCornerRadii(
                 sheetFromTop()
                         ? new float[] {0f, 0f, 0f, 0f, radius, radius, radius, radius}
-                        : new float[] {radius, radius, radius, radius, 0f, 0f, 0f, 0f});
+                        : new float[] {
+                            radius, radius, radius, radius, radius, radius, radius, radius
+                        });
         panel.setBackground(background);
         panel.setClipToOutline(true);
         panel.setOutlineProvider(ViewOutlineProvider.BACKGROUND);
+        applyActionsSurface();
+    }
+
+    /** The sheet panel's fill: solid, or the same tint the panel uses when it is glass. */
+    private @ColorInt int sheetSurfaceColor() {
+        return mGlass ? color(0xA61C1A20, 0xB8F1EDF6) : color(0xFF1C1A20, 0xFFF1EDF6);
+    }
+
+    /**
+     * Paints the action row with the panel fill. The old flat opaque color stayed put when
+     * glass was on, so the row read as a second surface.
+     */
+    private void applyActionsSurface() {
+        if (mSheetActions == null || !isSheetChrome()) return;
+        mSheetActions.setBackgroundColor(sheetSurfaceColor());
     }
 
     private void updateSheetButtons() {
@@ -1935,7 +1955,8 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
      * How far the sheet can travel from hidden to full. This is the height of the
      * overlay less a small gap at the far end, not the panel's current height, so a
      * drag from half still covers the remaining distance. The gap keeps a sliver of
-     * the page visible when the sheet is full, as in the mockup.
+     * the page visible when the sheet is full, as in the mockup. A rising sheet also
+     * reserves the bottom seam, so that sliver stays at the top.
      */
     private int sheetRangeHeight() {
         FrameLayout root = mRoot;
@@ -1944,24 +1965,30 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
             // Once the overlay has grown over the address bar, the sheet still travels the
             // shorter distance it had before that growth.
             if (mSheetBottomLift > 0 && morphHostCoversBar()) height -= mSheetBottomLift;
-            return Math.max(1, height - dp(SHEET_FULL_GAP_DP));
+            return Math.max(1, height - dp(SHEET_FULL_GAP_DP) - sheetBottomSeam());
         }
         // Pulled from the toolbar, the sheet moves before the overlay has been laid out the
         // first time. Its margins are already set, so its height can be worked out.
         View content = mActivity.findViewById(android.R.id.content);
         if (root != null && content != null && content.getHeight() > 0) {
             int height = content.getHeight() - mOverlayTop - mOverlayBottom - mSheetBottomLift;
-            return Math.max(1, height - dp(SHEET_FULL_GAP_DP));
+            return Math.max(1, height - dp(SHEET_FULL_GAP_DP) - sheetBottomSeam());
         }
         return 1;
     }
 
+    /** Pixels kept clear under a rising sheet. None when the sheet drops from a top bar. */
+    private int sheetBottomSeam() {
+        return isSheetChrome() && !sheetFromTop() ? dp(SHEET_BOTTOM_SEAM_DP) : 0;
+    }
+
     /**
