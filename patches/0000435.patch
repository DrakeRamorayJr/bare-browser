+    // Search tabs: the address bar's morph.
+
+    /**
+     * Builds the Search tabs field that stands in for the address bar while the sheet is open. It
+     * is laid over the toolbar, in the activity's own window (also in glass, whose window stops at
+     * the toolbars), so it can take the keyboard. The address bar underneath is not changed.
+     */
+    private MorphBar buildSearchBar() {
+        MorphBar morph = new MorphBar(mActivity);
+        morph.setTag("sheet_search_bar");
+        morph.setVisibility(View.GONE);
+        morph.setClickable(true);
+        // Only swallows touches over the toolbar; its field and button speak for themselves.
+        morph.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        morph.setBackgroundColor(color(0xFF1C1A20, 0xFFF1EDF6));
+
+        LinearLayout pill = new LinearLayout(mActivity);
+        pill.setTag("sheet_search_pill");
+        pill.setOrientation(LinearLayout.HORIZONTAL);
+        pill.setGravity(Gravity.CENTER_VERTICAL);
+        pill.setPaddingRelative(dp(14), 0, dp(4), 0);
+        GradientDrawable pillShape = new GradientDrawable();
+        pillShape.setCornerRadius(dp(24));
+        pillShape.setColor(color(0xFF2B2930, 0xFFE6E0EC));
+        pill.setBackground(pillShape);
+
+        ImageView icon = new ImageView(mActivity);
+        icon.setImageResource(R.drawable.ic_search_24dp);
+        icon.setColorFilter(color(0xFFCAC4D0, 0xFF49454F));
+        icon.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        pill.addView(icon, new LinearLayout.LayoutParams(dp(22), dp(22)));
+
+        EditText field = new EditText(mActivity);
+        field.setTag("sheet_search_field");
+        field.setBackground(null);
+        field.setHint(R.string.bare_vtabs_search_tabs);
+        field.setHintTextColor(color(0xFF938F99, 0xFF79747E));
+        field.setTextColor(color(0xFFE6E1E5, 0xFF1C1B1F));
+        field.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+        field.setSingleLine(true);
+        field.setPaddingRelative(dp(12), 0, dp(8), 0);
+        field.setInputType(
+                InputType.TYPE_CLASS_TEXT
+                        | InputType.TYPE_TEXT_VARIATION_FILTER
+                        | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
+        field.setImeOptions(
+                EditorInfo.IME_ACTION_SEARCH
+                        | EditorInfo.IME_FLAG_NO_EXTRACT_UI
+                        | EditorInfo.IME_FLAG_NO_FULLSCREEN);
+        field.addTextChangedListener(
+                new TextWatcher() {
+                    @Override
+                    public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
+
+                    @Override
+                    public void onTextChanged(CharSequence s, int start, int before, int count) {}
+
+                    @Override
+                    public void afterTextChanged(Editable s) {
+                        onSearchChanged(s.toString());
+                    }
+                });
+        field.setOnFocusChangeListener(
+                (v, hasFocus) -> {
+                    if (hasFocus) onSearchFocused();
+                });
+        field.setOnEditorActionListener(
+                (v, actionId, event) -> {
+                    if (actionId != EditorInfo.IME_ACTION_SEARCH) return false;
+                    // The filter is already live; Search just puts the keyboard away.
+                    dropSearchFocus();
+                    return true;
+                });
+        pill.addView(
+                field,
+                new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT, 1f));
+
+        ImageButton clear = new ImageButton(mActivity);
+        clear.setTag("sheet_search_clear");
+        clear.setImageResource(R.drawable.ic_bare_close);
+        clear.setColorFilter(color(0xFFCAC4D0, 0xFF49454F));
+        clear.setBackground(null);
+        clear.setScaleType(ImageView.ScaleType.CENTER_INSIDE);
+        clear.setPadding(dp(10), dp(10), dp(10), dp(10));
+        clear.setContentDescription(mActivity.getString(R.string.bare_vtabs_search_clear));
+        clear.setVisibility(View.GONE);
+        clear.setOnClickListener(
+                v -> {
+                    ActionHaptics.tick(v);
+                    field.setText("");
+                });
+        pill.addView(clear, new LinearLayout.LayoutParams(dp(40), dp(40)));
+
+        FrameLayout.LayoutParams pillParams =
+                new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(44));
+        pillParams.gravity = Gravity.CENTER_VERTICAL;
+        pillParams.leftMargin = dp(8);
+        pillParams.rightMargin = dp(8);
+        morph.addView(pill, pillParams);
+
+        View thief = new View(mActivity);
+        thief.setFocusable(true);
+        thief.setFocusableInTouchMode(true);
+        thief.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        morph.addView(thief, new FrameLayout.LayoutParams(1, 1));
+
+        mSearchPill = pill;
+        mSearchField = field;
+        mSearchClear = clear;
+        mSearchIcon = icon;
+        mSearchThief = thief;
+        return morph;
+    }
+
+    /**
+     * Lays the search field over the toolbar the sheet opens from, and its pill over the address
+     * bar's, so the bar seems to turn into it. With the keyboard up, a bottom one is lifted above
+     * it.
+     */
+    private void positionMorph() {
+        MorphBar morph = mMorph;
+        View content = mActivity.findViewById(android.R.id.content);
+        if (morph == null || content == null) return;
+        if (!(morph.getLayoutParams() instanceof FrameLayout.LayoutParams params)) return;
+        View bar = mActivity.findViewById(R.id.control_container);
+        int width = ViewGroup.LayoutParams.MATCH_PARENT;
+        int height = dp(56);
+        int gravity = sheetFromTop() ? Gravity.TOP : Gravity.BOTTOM;
+        int left = 0;
+        int top = 0;
+        int pillStart = dp(8);
+        int pillEnd = dp(8);
+        if (bar != null && bar.getVisibility() == View.VISIBLE && bar.getHeight() > 0) {
+            int[] contentLoc = new int[2];
+            content.getLocationOnScreen(contentLoc);
+            int[] barLoc = new int[2];
+            bar.getLocationOnScreen(barLoc);
+            width = bar.getWidth();
+            height = bar.getHeight();
+            gravity = Gravity.TOP | Gravity.START;
+            left = barLoc[0] - contentLoc[0];
+            top = barLoc[1] - contentLoc[1];
+            View location = mActivity.findViewById(R.id.location_bar);
+            if (location != null && location.isShown() && location.getWidth() > 0) {
+                int[] locationLoc = new int[2];
+                location.getLocationOnScreen(locationLoc);
+                pillStart = Math.max(0, locationLoc[0] - barLoc[0]);
+                pillEnd = Math.max(0, barLoc[0] + width - locationLoc[0] - location.getWidth());
+            }
+        } else if (morph.getVisibility() == View.VISIBLE) {
+            // The toolbar is away for a moment, as while the keyboard comes up: stay put.
+            morph.setTranslationY(sheetFromTop() ? 0f : -mImeLift);
+            return;
+        }
+        if (params.width != width
+                || params.height != height
+                || params.gravity != gravity
+                || params.leftMargin != left
+                || params.topMargin != top) {
+            params.width = width;
+            params.height = height;
+            params.gravity = gravity;
+            params.leftMargin = left;
+            params.topMargin = top;
+            morph.setLayoutParams(params);
+        }
+        LinearLayout pill = mSearchPill;
+        if (pill != null && pill.getLayoutParams() instanceof FrameLayout.LayoutParams pillParams) {
+            if (pillParams.leftMargin != pillStart || pillParams.rightMargin != pillEnd) {
+                pillParams.leftMargin = pillStart;
+                pillParams.rightMargin = pillEnd;
+                pill.setLayoutParams(pillParams);
+            }
+        }
+        morph.setTranslationY(sheetFromTop() ? 0f : -mImeLift);
+    }
+
+    /**
+     * Fades the search field in over the address bar as the sheet opens, fully there by half, and
+     * out as it closes. The side drawer never shows it.
+     */
+    private void updateMorph() {
+        MorphBar morph = mMorph;
+        if (morph == null) return;
+        FrameLayout root = mRoot;
+        float shown =
+                isSheetChrome() && root != null && root.getVisibility() == View.VISIBLE
+                        ? Math.min(1f, mProgress / BareTabSheetSnap.HALF_RATIO)
+                        : 0f;
+        if (shown <= 0f) {
+            if (morph.getVisibility() != View.GONE) morph.setVisibility(View.GONE);
+            return;
+        }
+        if (morph.getVisibility() != View.VISIBLE) {
+            positionMorph();
+            morph.setVisibility(View.VISIBLE);
+            // Above the sheet's overlay when that shares the activity's content.
+            morph.bringToFront();
+        }
+        morph.setAlpha(shown);
+        View icon = mSearchIcon;
+        if (icon != null) {
+            float scale = 0.6f + 0.4f * shown;
+            icon.setScaleX(scale);
+            icon.setScaleY(scale);
+        }
+    }
+
+    /** Whether a search is under way: there is text, or the field has the keyboard. */
+    private boolean searching() {
+        EditText field = mSearchField;
+        return field != null && (field.length() > 0 || field.hasFocus());
+    }
+
+    private void onSearchChanged(String text) {
+        View clear = mSearchClear;
+        if (clear != null) clear.setVisibility(text.isEmpty() ? View.GONE : View.VISIBLE);
+        String query = text.trim();
+        if (query.equals(mQuery)) return;
+        mQuery = query;
+        // A new filter replaces the list at once and shows the current tab if it is in it.
+        mSnapNext = true;
+        mScrollToSelected = true;
+        if (mOpen) refresh();
+    }
+
+    /** The keyboard must not cover the list, so the sheet goes full for a search. */
+    private void onSearchFocused() {
+        if (!mOpen || !isSheetChrome()) return;
+        settleSheet(BareTabSheetSnap.State.FULL, /* announce= */ true);
+    }
+
+    /** Puts the field in focus with the keyboard, for a tap beside it. */
+    private void focusSearchField() {
+        EditText field = mSearchField;
+        if (field == null || !mOpen) return;
+        if (field.requestFocus()) {
+            InputMethodManager imm = mActivity.getSystemService(InputMethodManager.class);
+            if (imm != null) imm.showSoftInput(field, 0);
+        }
+    }
+
+    /** Puts the keyboard away and moves focus off the field, keeping its text. */
+    private void dropSearchFocus() {
+        EditText field = mSearchField;
+        if (field == null || !field.hasFocus()) return;
+        InputMethodManager imm = mActivity.getSystemService(InputMethodManager.class);
+        if (imm != null) imm.hideSoftInputFromWindow(field.getWindowToken(), 0);
+        View thief = mSearchThief;
+        if (thief == null || !thief.requestFocus()) field.clearFocus();
+    }
+
+    /** Empties the field, which lists every tab again, and puts the keyboard away. */
+    private void clearSearch() {
+        EditText field = mSearchField;
+        if (field != null && field.length() > 0) field.setText("");
+        mQuery = "";
+        dropSearchFocus();
+    }
+
+    /** Follows the keyboard while the sheet is open, so it never covers the field or the list. */
+    private void onWindowLayout() {
+        if (!mOpen || !isSheetChrome()) return;
+        int lift = 0;
+        int cover = 0;
+        View decor = mActivity.getWindow().getDecorView();
