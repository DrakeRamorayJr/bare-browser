+    static boolean matchesSearch(String query, @Nullable String title, @Nullable String url) {
+        String haystackTitle = title == null ? "" : title.toLowerCase(Locale.ROOT);
+        String haystackUrl = url == null ? "" : url.toLowerCase(Locale.ROOT);
+        for (String word : query.toLowerCase(Locale.ROOT).trim().split("\\s+")) {
+            if (word.isEmpty()) continue;
+            if (!haystackTitle.contains(word) && !haystackUrl.contains(word)) return false;
+        }
+        return true;
+    }
