+    /** Saves the chrome bar once, before this sheet replaces it. */
+    private void rememberStatusBar() {
+        if (mHaveSavedStatusBarColor) return;
+        Window window = mActivity.getWindow();
+        WindowInsetsControllerCompat controller =
+                new WindowInsetsControllerCompat(window, window.getDecorView());
+        mSavedStatusBarColor = window.getStatusBarColor();
+        mHaveSavedStatusBarColor = true;
+        mSavedLightStatusBar = controller.isAppearanceLightStatusBars();
+        mHaveSavedLightStatusBar = true;
+    }
+
+    /** Puts the backdrop colour back if the status-bar controller painted over it. */
+    private void armStatusBarGuard() {
+        if (mStatusBarGuardOn) return;
+        View decor = mActivity.getWindow().getDecorView();
+        mStatusBarGuard =
+                new ViewTreeObserver.OnPreDrawListener() {
+                    @Override
+                    public boolean onPreDraw() {
+                        if (!mPageCardArmed) {
+                            disarmStatusBarGuard();
+                            return true;
+                        }
+                        applyStatusBarForPageCard(true, mPageDim);
+                        return true;
+                    }
+                };
+        decor.getViewTreeObserver().addOnPreDrawListener(mStatusBarGuard);
+        mStatusBarGuardOn = true;
+    }
+
+    private void disarmStatusBarGuard() {
+        if (!mStatusBarGuardOn) return;
+        View decor = mActivity.getWindow().getDecorView();
+        ViewTreeObserver observer = decor.getViewTreeObserver();
+        if (observer.isAlive() && mStatusBarGuard != null) {
+            observer.removeOnPreDrawListener(mStatusBarGuard);
+        }
+        mStatusBarGuardOn = false;
+        mStatusBarGuard = null;
     }
 
