+            if (controller.isAppearanceLightStatusBars() != wantAppearanceLight) {
+                controller.setAppearanceLightStatusBars(wantAppearanceLight);
             }
+            armStatusBarGuard();
             return;
         }
+        setStatusBarScrim(Color.TRANSPARENT);
         if (mHaveSavedLightStatusBar) {
             controller.setAppearanceLightStatusBars(mSavedLightStatusBar);
             mHaveSavedLightStatusBar = false;
@@ -2360,6 +2409,50 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
             window.setStatusBarColor(mSavedStatusBarColor);
             mHaveSavedStatusBarColor = false;
