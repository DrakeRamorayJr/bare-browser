+    /**
+     * Opaque black mixed over the chrome status-bar colour by {@code dim}. {@code dim} is 0
+     * closed and 1 from half-open up, the same curve as the page-card backdrop. At 1 this is
+     * black, so the bar matches the margin around the card.
+     */
+    private @ColorInt int backdropColor(float dim) {
+        float clamped = Math.max(0f, Math.min(1f, dim));
+        @ColorInt int base = mHaveSavedStatusBarColor ? mSavedStatusBarColor : Color.BLACK;
+        if (Color.alpha(base) != 255) {
+            base = ChromeColors.getDefaultThemeColor(mActivity, /* isIncognito= */ false);
+        }
+        return ColorUtils.overlayColor(base, Color.argb(Math.round(clamped * 255f), 0, 0, 0));
+    }
