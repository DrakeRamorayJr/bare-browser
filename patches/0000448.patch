-    private CharSequence cachedBarUrl() {
-        String cached = mCachedBarUrl;
-        if (cached != null) return cached;
+    /**
+     * Text the origin pill shows. A normal page uses the host. The new-tab page, a chrome page,
+     * and an empty URL use the address bar hint, or the page title when the bar has no hint.
+     * A raw chrome:// or chrome-native:// URL is never returned.
+     */
+    static String originPillLabel(
+            @Nullable GURL url,
+            @Nullable CharSequence barText,
+            @Nullable CharSequence barHint,
+            @Nullable CharSequence pageTitle) {
+        if (url != null && !isHintPage(url)) {
+            String host = url.getHost();
+            if (!TextUtils.isEmpty(host)) return host;
+            String spec = url.getSpec();
+            return isRawInternalUrl(spec) ? "" : spec;
+        }
+        String shown = safeDisplayText(barText);
+        if (!shown.isEmpty()) return shown;
+        String hint = safeDisplayText(barHint);
+        if (!hint.isEmpty()) return hint;
+        return safeDisplayText(pageTitle);
+    }
+
+    /** New-tab page, chrome and chrome-native pages, about: pages, and an empty URL. */
+    static boolean isHintPage(@Nullable GURL url) {
+        if (url == null || GURL.isEmptyOrInvalid(url)) return true;
+        if (UrlUtilities.isNtpUrl(url) || UrlUtilities.isChromeScheme(url)) return true;
+        String scheme = url.getScheme();
+        return "about".equalsIgnoreCase(scheme) || isRawInternalUrl(url.getSpec());
+    }
+
+    static boolean isRawInternalUrl(@Nullable String text) {
+        if (text == null) return false;
+        String trimmed = text.trim().toLowerCase(Locale.US);
+        return trimmed.startsWith("chrome-native:")
+                || trimmed.startsWith("chrome:")
+                || trimmed.startsWith("about:");
+    }
+
+    private static String safeDisplayText(@Nullable CharSequence text) {
+        if (text == null) return "";
+        String value = text.toString().trim();
+        if (value.isEmpty() || isRawInternalUrl(value)) return "";
+        return value;
+    }
+
+    /**
+     * Text in the address field. An empty url bar is the real state (the hint is showing) and
+     * is not replaced by the location-bar container.
+     */
+    private @Nullable CharSequence shownBarText() {
         View url = mActivity.findViewById(R.id.url_bar);
-        if (url instanceof TextView urlText) {
-            CharSequence shown = urlText.getText();
-            if (shown != null && shown.length() > 0) {
-                cached = shown.toString();
-                mCachedBarUrl = cached;
-                return cached;
-            }
-        }
+        if (url instanceof TextView urlText) return urlText.getText();
         View location = mActivity.findViewById(R.id.location_bar);
-        if (location instanceof TextView locationText) {
-            CharSequence shown = locationText.getText();
-            if (shown != null && shown.length() > 0) {
-                cached = shown.toString();
-                mCachedBarUrl = cached;
-                return cached;
-            }
-        }
+        if (location instanceof TextView locationText) return locationText.getText();
+        return null;
+    }
+
+    private @Nullable CharSequence shownBarHint() {
+        View url = mActivity.findViewById(R.id.url_bar);
+        if (url instanceof TextView urlText) return urlText.getHint();
+        View location = mActivity.findViewById(R.id.location_bar);
+        if (location instanceof TextView locationText) return locationText.getHint();
+        return null;
+    }
+
+    private @Nullable Tab currentTab() {
         TabModel model = currentModel();
-        if (model != null) {
-            int index = model.index();
-            if (index >= 0 && index < model.getCount()) {
-                Tab tab = model.getTabAt(index);
-                if (tab != null
-                        && tab.getUrl() != null
-                        && !TextUtils.isEmpty(tab.getUrl().getSpec())) {
-                    cached = tab.getUrl().getSpec();
-                    mCachedBarUrl = cached;
-                    return cached;
-                }
-            }
+        if (model == null) return null;
+        int index = model.index();
+        if (index < 0 || index >= model.getCount()) return null;
+        return model.getTabAt(index);
+    }
+
+    private CharSequence cachedBarUrl() {
+        if (mCachedBarUrl != null) return mCachedBarUrl;
+        Tab tab = currentTab();
+        GURL url = tab == null ? null : tab.getUrl();
+        CharSequence barText = shownBarText();
+        CharSequence hint = shownBarHint();
+        CharSequence title = tab == null ? null : tab.getTitle();
+        boolean rawBar = isRawInternalUrl(barText == null ? null : barText.toString());
+        String resolved;
+        if (isHintPage(url) || rawBar || TextUtils.isEmpty(barText)) {
+            resolved = originPillLabel(url, barText, hint, title);
+        } else {
+            resolved = barText.toString();
         }
-        cached = mOriginLabel;
-        mCachedBarUrl = cached;
-        return cached;
+        if (!resolved.isEmpty()) mCachedBarUrl = resolved;
+        return resolved;
     }
 
