+    @Test
+    public void testOriginPillLabelUsesTheHintForInternalPagesAndTheHostForHttps() {
+        String hint = "Search DuckDuckGo (No AI) or type URL";
+        assertEquals(
+                hint,
+                BareVerticalTabsDrawer.originPillLabel(
+                        JUnitTestGURLs.NTP_NATIVE_URL, "", hint, "New tab"));
+        assertEquals(
+                hint,
+                BareVerticalTabsDrawer.originPillLabel(
+                        JUnitTestGURLs.NTP_NATIVE_URL, "chrome-native://newtab/", hint, "New tab"));
+        assertEquals(
+                hint,
+                BareVerticalTabsDrawer.originPillLabel(
+                        JUnitTestGURLs.NTP_URL, "chrome://newtab/", hint, "New tab"));
+        assertEquals(
+                hint,
+                BareVerticalTabsDrawer.originPillLabel(
+                        new org.chromium.url.GURL("chrome://flags/"),
+                        "chrome://flags/",
+                        hint,
+                        "Flags"));
+        assertEquals(
+                "Settings",
+                BareVerticalTabsDrawer.originPillLabel(
+                        new org.chromium.url.GURL("chrome://settings/"),
+                        "chrome://settings/",
+                        "",
+                        "Settings"));
+        assertEquals(
+                hint,
+                BareVerticalTabsDrawer.originPillLabel(null, "", hint, "New tab"));
+        assertEquals(
+                "www.one.com",
+                BareVerticalTabsDrawer.originPillLabel(
+                        JUnitTestGURLs.URL_1_WITH_PATH,
+                        "www.one.com/some_path.html",
+                        hint,
+                        "One"));
+        assertFalse(
+                BareVerticalTabsDrawer.originPillLabel(
+                                JUnitTestGURLs.NTP_NATIVE_URL,
+                                "chrome-native://newtab/",
+                                null,
+                                null)
+                        .contains("chrome"));
+    }
+
+    @Test
+    public void testTheMorphingPillShowsTheBarHintOnTheNewTabPage() {
+        when(mSecond.getUrl()).thenReturn(JUnitTestGURLs.NTP_NATIVE_URL);
+        when(mSecond.getTitle()).thenReturn("New tab");
+        TextView url = new TextView(mActivity);
+        url.setId(org.chromium.chrome.R.id.url_bar);
+        url.setText("");
+        url.setHint("Search DuckDuckGo (No AI) or type URL");
+        content().addView(url);
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        int range = beginPullAndLayOut();
+        mDrawer.updateToolbarPull(range * 0.02f);
+        TextView origin = (TextView) findTag("sheet_pill_origin");
+        assertEquals("Search DuckDuckGo (No AI) or type URL", origin.getText().toString());
+        mDrawer.updateToolbarPull(range * BareTabSheetSnap.HALF_RATIO);
+        assertEquals("Search DuckDuckGo (No AI) or type URL", origin.getText().toString());
+        mDrawer.updateToolbarPull(range);
+        assertEquals("Search DuckDuckGo (No AI) or type URL", origin.getText().toString());
+        assertFalse(origin.getText().toString().contains("chrome"));
+    }
+
