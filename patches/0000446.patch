+    /**
+     * How far the sheet window sits above the content bottom so it ends on the keyboard.
+     * {@code chromeBottom} is the toolbar inset used when the keyboard is hidden. The same
+     * keyboard returns the same inset on every call, and the window keeps {@code minHeight}.
+     */
+    static int bottomInsetForKeyboard(
+            int contentTop,
+            int contentHeight,
+            int topInset,
+            int chromeBottom,
+            int keyboardTop,
+            int minHeight) {
+        if (keyboardTop < 0 || contentHeight <= 0) return Math.max(0, chromeBottom);
+        int inset = contentTop + contentHeight - keyboardTop;
+        if (inset < 0) inset = 0;
+        int cap = contentHeight - Math.max(0, topInset) - Math.max(1, minHeight);
+        if (cap < 1) cap = 1;
+        if (inset > cap) inset = cap;
+        return inset;
+    }
