+    @Test
+    public void testTheUrlBarCannotTakeFocusWhileTheSheetIsOpen() {
+        setAddressBarOnTop(false);
+        android.widget.EditText url = new android.widget.EditText(mActivity);
+        url.setId(org.chromium.chrome.R.id.url_bar);
+        url.setFocusable(true);
+        url.setFocusableInTouchMode(true);
+        content().addView(url, new FrameLayout.LayoutParams(200, 50));
+        openSheetLaidOut(px(400), px(800));
+        assertTrue(mDrawer.isOpen());
+        assertFalse(url.isFocusable());
+        assertFalse(url.isFocusableInTouchMode());
+
+        url.setFocusable(true);
+        url.setFocusableInTouchMode(true);
+        url.requestFocus();
+        ShadowLooper.idleMainLooper();
+        mDrawer.finishAnimationForTesting();
+        assertTrue(mDrawer.isOpen());
+        assertFalse(url.hasFocus());
+        assertFalse(url.isFocusable());
+    }
+
+    @Test
+    public void testClosingTheSheetLetsTheUrlBarTakeFocusAgain() {
+        setAddressBarOnTop(false);
+        android.widget.EditText url = new android.widget.EditText(mActivity);
+        url.setId(org.chromium.chrome.R.id.url_bar);
+        url.setFocusable(true);
+        url.setFocusableInTouchMode(true);
+        content().addView(url, new FrameLayout.LayoutParams(200, 50));
+        openSheetLaidOut(px(400), px(800));
+        assertFalse(url.isFocusable());
+        mDrawer.close();
+        mDrawer.finishAnimationForTesting();
+        assertFalse(mDrawer.isOpen());
+        assertTrue(url.isFocusable());
+        assertTrue(url.isFocusableInTouchMode());
+        assertTrue(url.requestFocus());
+        assertTrue(url.hasFocus());
+    }
+
