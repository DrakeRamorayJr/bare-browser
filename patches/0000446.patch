+    private boolean isUrlBar(View focused) {
+        View url = mActivity.findViewById(R.id.url_bar);
+        if (url == null) return false;
+        for (View view = focused; view != null; ) {
+            if (view == url) return true;
+            view = view.getParent() instanceof View parent ? parent : null;
+        }
+        return false;
+    }
+
+    /** Drops focus the address bar took. A search puts it back on the in-row field. */
+    private void refuseUrlBarFocus() {
+        guardUrlBarFocus();
+        View url = mActivity.findViewById(R.id.url_bar);
+        if (url != null && url.hasFocus()) url.clearFocus();
+        EditText field = mSearchField;
+        if (mSearchExpanded && field != null && !field.hasFocus()) field.requestFocus();
+    }
+
+    /**
+     * The address bar cannot take focus while a sheet is on screen. It is focusable again
+     * once the sheet is gone, so a pill tap can still focus it after the close finishes.
+     */
+    private void guardUrlBarFocus() {
+        boolean block = isSheetChrome() && (mOpen || mProgress > 0.001f);
+        View url = mActivity.findViewById(R.id.url_bar);
+        if (url == null) return;
+        if (block) {
+            mUrlBarBlocked = true;
+            if (url.isFocusable()) url.setFocusable(false);
+            if (url.isFocusableInTouchMode()) url.setFocusableInTouchMode(false);
+            if (url.hasFocus()) url.clearFocus();
+            return;
+        }
+        releaseUrlBarFocusGuard();
+    }
+
+    private void releaseUrlBarFocusGuard() {
+        if (!mUrlBarBlocked) return;
+        mUrlBarBlocked = false;
+        View url = mActivity.findViewById(R.id.url_bar);
+        if (url == null) return;
+        url.setFocusable(true);
+        url.setFocusableInTouchMode(true);
+    }
