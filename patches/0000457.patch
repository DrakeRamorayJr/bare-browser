+    /** Has a size, and nothing above it is gone. A gone view keeps its old rect. */
+    private static boolean isLaidOutIcon(View view) {
+        if (view.getWidth() <= 0 || view.getHeight() <= 0) return false;
+        View current = view;
+        while (current.getVisibility() != View.GONE) {
+            if (!(current.getParent() instanceof View parent)) return true;
+            current = parent;
+        }
+        return false;
+    }
+
+    /**
+     * Draws {@code source} as it looks on the real bar, padding, scale type, tint and any badge
+     * included, into a bitmap the copy shows at the same size. A copy that only held the icon's
+     * drawable filled the whole padded box and came out larger than the real icon. Returns
+     * false when the view is too big to copy or cannot be drawn into a bitmap, and the copy
+     * keeps the icon's drawable instead.
+     */
+    private boolean drawIconSnapshot(ImageView ghost, ImageView source) {
+        int w = source.getWidth();
+        int h = source.getHeight();
+        int limit = dp(ICON_SNAPSHOT_MAX_DP);
+        if (w <= 0 || h <= 0 || w > limit || h > limit) return false;
+        GhostSnapshot held = mGhostSnapshots.get(ghost);
+        if (held != null
+                && held.mSource == source
+                && held.mBitmap.getWidth() == w
+                && held.mBitmap.getHeight() == h
+                && ghost.getDrawable() == held.mDrawable) {
+            held.mBitmap.eraseColor(Color.TRANSPARENT);
+        } else {
+            Bitmap bitmap = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+            held =
+                    new GhostSnapshot(
+                            source,
+                            bitmap,
+                            new BitmapDrawable(mActivity.getResources(), bitmap));
+            mGhostSnapshots.put(ghost, held);
+        }
+        try {
+            source.draw(new Canvas(held.mBitmap));
+        } catch (IllegalStateException e) {
+            // A hardware bitmap in the icon cannot be drawn into a software canvas.
+            mGhostSnapshots.remove(ghost);
+            return false;
+        }
+        if (ghost.getScaleType() != ImageView.ScaleType.FIT_XY) {
+            ghost.setScaleType(ImageView.ScaleType.FIT_XY);
+        }
+        if (ghost.getDrawable() != held.mDrawable) {
+            ghost.setImageDrawable(held.mDrawable);
+        } else {
+            ghost.invalidate();
+        }
+        return true;
+    }
+
+    private void releaseGhostSnapshots() {
+        if (mGhostSnapshots.isEmpty()) return;
+        for (java.util.Map.Entry<ImageView, GhostSnapshot> entry : mGhostSnapshots.entrySet()) {
+            ImageView ghost = entry.getKey();
+            if (ghost.getDrawable() == entry.getValue().mDrawable) ghost.setImageDrawable(null);
+        }
+        mGhostSnapshots.clear();
+    }
