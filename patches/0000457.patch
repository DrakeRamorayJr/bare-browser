+    private void captureHandoffBar(@Nullable View location) {
+        mHandoffLive = false;
+        FrameLayout root = mRoot;
+        if (location == null
+                || root == null
+                || location.getWidth() <= 0
+                || location.getHeight() <= 0
+                || !location.isAttachedToWindow()
