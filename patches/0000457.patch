+        }
+        View buttons = bottomButtonBar();
+        if (buttons != null && Math.abs(buttons.getTranslationY()) > 1f) return;
+        if (Math.abs(location.getTranslationY()) > 1f) return;
+        if (mRestBarW > 0) {
+            int[] at = new int[2];
+            location.getLocationOnScreen(at);
+            int tolerance = dp(HANDOFF_RECAPTURE_TOLERANCE_DP);
+            if (Math.abs(at[0] - mRestBarX) > tolerance
+                    || Math.abs(at[1] - mRestBarY) > tolerance
+                    || Math.abs(location.getWidth() - mRestBarW) > tolerance
+                    || Math.abs(location.getHeight() - mRestBarH) > tolerance) {
+                return;
+            }
+        }
+        storeRestBar(location);
+        mHandoffLive = true;
