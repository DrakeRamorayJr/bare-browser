+    /**
+     * Sets the pill's text, with the colour spans of the real url text when {@code styled} is
+     * given. Only the chars are compared, so a view that holds spans is told apart by a flag.
+     */
+    private void setMorphText(TextView view, CharSequence plain, @Nullable CharSequence styled) {
+        boolean isOrigin = view == mPillOrigin;
+        boolean held = isOrigin ? mOriginTextStyled : mFromTextStyled;
+        if (styled != null) {
+            if (held && TextUtils.equals(view.getText(), styled)) return;
+            view.setText(colouredCopy(styled));
+        } else {
+            if (!held && TextUtils.equals(view.getText(), plain)) return;
+            view.setText(plain);
+        }
+        if (isOrigin) {
+            mOriginTextStyled = styled != null;
+        } else {
+            mFromTextStyled = styled != null;
+        }
+    }
+
+    /** The chars of {@code source} with its foreground colours, and nothing else it carries. */
+    private static CharSequence colouredCopy(CharSequence source) {
+        SpannableString copy = new SpannableString(source.toString());
+        if (!(source instanceof Spanned spanned)) return copy;
+        for (ForegroundColorSpan span :
+                spanned.getSpans(0, source.length(), ForegroundColorSpan.class)) {
+            int start = spanned.getSpanStart(span);
+            int end = spanned.getSpanEnd(span);
+            if (start < 0 || end <= start) continue;
+            copy.setSpan(
+                    new ForegroundColorSpan(span.getForegroundColor()),
+                    start,
+                    end,
+                    spanned.getSpanFlags(span));
+        }
+        return copy;
+    }
+
+    /** The real url text, or the location bar when that is the text itself. Null if unlaid. */
+    private @Nullable TextView liveBarText() {
+        View url = mActivity.findViewById(R.id.url_bar);
+        if (url instanceof TextView urlText && isLiveBarText(urlText)) return urlText;
+        View location = mActivity.findViewById(R.id.location_bar);
+        if (location instanceof TextView locationText && isLiveBarText(locationText)) {
+            return locationText;
+        }
+        return null;
+    }
+
+    private boolean isLiveBarText(TextView text) {
+        return text.getWidth() > 0
+                && text.getLayout() != null
+                && text.isAttachedToWindow()
+                && !isInside(text, mRoot)
+                && !isInside(text, mOriginPill);
+    }
+
+    /**
+     * Gives the pill's text views the typeface, font padding, spacing, scale and ellipsis of the
+     * real url text, so both lay the same string out the same way.
+     */
+    private void matchMorphTextLook(TextView real) {
+        matchTextLook(mPillOrigin, real);
+        matchTextLook(mMorphFromText, real);
+        mMorphTextMatched = true;
+    }
+
+    private static void matchTextLook(@Nullable TextView view, TextView real) {
+        if (view == null) return;
+        if (view.getTypeface() != real.getTypeface()) view.setTypeface(real.getTypeface());
+        if (view.getIncludeFontPadding() != real.getIncludeFontPadding()) {
+            view.setIncludeFontPadding(real.getIncludeFontPadding());
+        }
+        if (view.getLetterSpacing() != real.getLetterSpacing()) {
+            view.setLetterSpacing(real.getLetterSpacing());
+        }
+        if (view.getTextScaleX() != real.getTextScaleX()) view.setTextScaleX(real.getTextScaleX());
+        if (view.getEllipsize() != real.getEllipsize()) view.setEllipsize(real.getEllipsize());
+    }
+
+    /** Puts the pill's text back to the look it has outside a hand-off. */
+    private void clearMorphTextMatch() {
+        if (!mMorphTextMatched) return;
+        mMorphTextMatched = false;
+        resetTextLook(mPillOrigin);
+        resetTextLook(mMorphFromText);
+        // The flow icons were hidden for the hand-off. The copies hide them again if they apply.
+        settlePillIconsInFlow();
+    }
+
+    private static void resetTextLook(@Nullable TextView view) {
+        if (view == null) return;
+        view.setTranslationX(0f);
+        view.setTranslationY(0f);
+        view.setTypeface(null);
+        view.setIncludeFontPadding(true);
+        view.setLetterSpacing(0f);
+        view.setTextScaleX(1f);
+        view.setEllipsize(TextUtils.TruncateAt.END);
+    }
+
+    /**
+     * Moves the pill's text so its first glyph and its baseline sit exactly where the real url
+     * text draws them. The pill centres a text box and the bar lays its own out, so the two
+     * differ by a few pixels even with the same font. Reads the layouts, not constants.
+     */
+    private void alignMorphText(@Nullable TextView real) {
+        TextView[] views = {mPillOrigin, mMorphFromText};
+        float[] target = new float[2];
+        if (real == null || !glyphOrigin(real, false, target)) {
+            for (TextView view : views) {
+                if (view == null) continue;
+                view.setTranslationX(0f);
+                view.setTranslationY(0f);
+            }
+            return;
+        }
+        float[] own = new float[2];
+        for (TextView view : views) {
+            if (view == null) continue;
+            if (view.getVisibility() != View.VISIBLE || !glyphOrigin(view, true, own)) {
+                view.setTranslationX(0f);
+                view.setTranslationY(0f);
+                continue;
+            }
+            view.setTranslationX(target[0] - own[0]);
+            view.setTranslationY(target[1] - own[1]);
+        }
+    }
+
+    /**
+     * Screen x of the first glyph and screen y of the first baseline. A view's own translation
+     * is part of its screen position; {@code withoutTranslation} takes it out.
+     */
+    private static boolean glyphOrigin(TextView text, boolean withoutTranslation, float[] out) {
+        android.text.Layout layout = text.getLayout();
+        if (layout == null || layout.getLineCount() == 0 || !text.isAttachedToWindow()) {
+            return false;
+        }
+        int[] at = new int[2];
+        text.getLocationOnScreen(at);
+        float x = at[0];
+        float y = at[1];
+        if (withoutTranslation) {
+            x -= text.getTranslationX();
+            y -= text.getTranslationY();
+        }
+        out[0] = x - text.getScrollX() + text.getCompoundPaddingLeft() + layout.getLineLeft(0);
+        out[1] = y - text.getScrollY() + text.getBaseline();
+        return true;
+    }
