+    private TextView parkOnABarWithOffsetText(TextView bar, android.widget.ImageView shield) {
+        android.text.SpannableString text = new android.text.SpannableString("https://example.com/");
+        text.setSpan(
+                new android.text.style.ForegroundColorSpan(0xFF336699),
+                8,
+                19,
+                android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        bar.setText(text);
+        bar.setPadding(px(18), px(9), px(6), px(1));
+        bar.setLetterSpacing(0.04f);
+        bar.setIncludeFontPadding(false);
+        parkTheCloseMorph(bar, shield);
+        return (TextView) findTag("morph_from_text");
+    }
