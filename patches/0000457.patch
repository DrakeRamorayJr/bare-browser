+    private void assertSameScreenPosition(View expected, View actual) {
+        int[] want = new int[2];
+        int[] got = new int[2];
+        expected.getLocationOnScreen(want);
+        actual.getLocationOnScreen(got);
+        assertTrue("x " + got[0] + " vs " + want[0], Math.abs(got[0] - want[0]) <= 1);
+        assertTrue("y " + got[1] + " vs " + want[1], Math.abs(got[1] - want[1]) <= 1);
+    }
+
+    /** Screen x of the first glyph and screen y of the first baseline of a laid-out text view. */
+    private static float[] glyphOrigin(TextView text) {
+        int[] at = new int[2];
+        text.getLocationOnScreen(at);
+        android.text.Layout layout = text.getLayout();
+        return new float[] {
+            at[0] - text.getScrollX() + text.getCompoundPaddingLeft() + layout.getLineLeft(0),
+            at[1] - text.getScrollY() + text.getBaseline()
+        };
+    }
+
+    /**
+     * Parks a close on a bar whose url text is inset, spaced and coloured in ways the pill's own
+     * text layout does not give it. Returns the pill's copy of the bar text.
