+
+    /** Bottom-bar sheet only. The top-bar sheet and the side drawer keep the anchored pill. */
+    private boolean bottomBarMorph() {
+        return isSheetChrome() && !sheetFromTop();
+    }
+
+    /** Smoothstep. Flat at both ends, so a capture slowed to 10x stays on one path. */
+    private static float morphEase(float t) {
+        if (t <= 0f) return 0f;
+        if (t >= 1f) return 1f;
+        return t * t * (3f - 2f * t);
+    }
+
+    private static float lerp(float from, float to, float t) {
+        return from + (to - from) * t;
+    }
+
+    private static @ColorInt int blendColor(@ColorInt int from, @ColorInt int to, float t) {
+        float u = 1f - t;
+        return Color.argb(
+                Math.round(Color.alpha(from) * u + Color.alpha(to) * t),
+                Math.round(Color.red(from) * u + Color.red(to) * t),
+                Math.round(Color.green(from) * u + Color.green(to) * t),
+                Math.round(Color.blue(from) * u + Color.blue(to) * t));
+    }
+
+    private float modernBarRadiusPx() {
+        if (mModernBarRadiusPx >= 0f) return mModernBarRadiusPx;
+        int id =
+                mActivity
+                        .getResources()
+                        .getIdentifier(
+                                "modern_toolbar_background_corner_radius",
+                                "dimen",
+                                mActivity.getPackageName());
+        mModernBarRadiusPx = id == 0 ? dp(16) : mActivity.getResources().getDimension(id);
+        return mModernBarRadiusPx;
+    }
+
+    /** True once the sheet window includes the bottom of the real address bar. */
+    private boolean morphHostCoversBar() {
+        FrameLayout root = mRoot;
+        View bar = mActivity.findViewById(R.id.location_bar);
+        if (root == null || bar == null || root.getHeight() <= 0 || bar.getHeight() <= 0) {
+            return false;
+        }
+        if (!root.isAttachedToWindow() || !bar.isAttachedToWindow()) return false;
+        root.getLocationOnScreen(mHostOnScreen);
+        bar.getLocationOnScreen(mBarOnScreen);
+        return mHostOnScreen[1] + root.getHeight() + 1 >= mBarOnScreen[1] + bar.getHeight();
+    }
+
+    /** Copies the real bar rect, fill and corner radius. Positions are in the host space. */
+    private void readBarChrome(@Nullable View location) {
+        FrameLayout root = mRoot;
+        mBarWidthPx = 0;
+        mBarHeightPx = 0;
+        mBarTextPadStart = dp(10);
+        mBarTextPadEnd = dp(12);
+        mBarTextColor = color(0xFFE6E1E5, 0xFF1C1B1F);
+        mBarTextSizePx =
+                TypedValue.applyDimension(
+                        TypedValue.COMPLEX_UNIT_SP,
+                        16f,
+                        mActivity.getResources().getDisplayMetrics());
+        Drawable bg = null;
+        View bgView = mActivity.findViewById(R.id.location_bar_background_view);
+        if (bgView != null && bgView.getBackground() != null && !isInside(bgView, root)) {
+            bg = bgView.getBackground();
+        } else if (location != null) {
+            bg = location.getBackground();
+        }
+        mBarFillColor = color(0xFF2B2930, 0xFFE8EAED);
+        mBarCornerRadius = modernBarRadiusPx();
+        GradientDrawable gradient = null;
+        if (bg instanceof LocationBarBackgroundDrawable drawable) {
+            gradient = drawable.getBackgroundGradient();
+        } else if (bg instanceof GradientDrawable shape) {
+            gradient = shape;
+        }
+        if (gradient != null) {
+            if (gradient.getColor() != null) {
+                mBarFillColor = gradient.getColor().getDefaultColor();
+            }
+            if (gradient.getCornerRadius() > 0f) mBarCornerRadius = gradient.getCornerRadius();
+        }
+        View url = mActivity.findViewById(R.id.url_bar);
+        TextView text = null;
+        if (url instanceof TextView urlText) {
+            text = urlText;
+        } else if (location instanceof TextView locationText) {
+            text = locationText;
+        }
+        if (text != null) {
+            mBarTextColor = text.getCurrentTextColor();
+            if (text.getTextSize() > 0f) mBarTextSizePx = text.getTextSize();
+        }
+        if (location == null
+                || root == null
+                || location.getWidth() <= 0
+                || location.getHeight() <= 0
+                || root.getWidth() <= 0
+                || isInside(location, root)
+                || !root.isAttachedToWindow()
+                || !location.isAttachedToWindow()) {
+            return;
+        }
+        location.getLocationOnScreen(mBarOnScreen);
+        root.getLocationOnScreen(mHostOnScreen);
+        mBarWidthPx = location.getWidth();
+        mBarHeightPx = location.getHeight();
+        mBarLeftPx = mBarOnScreen[0] - mHostOnScreen[0];
+        mBarTopPx = mBarOnScreen[1] - mHostOnScreen[1];
+        if (url != null && url.getWidth() > 0 && url.isAttachedToWindow()) {
+            url.getLocationOnScreen(mUrlOnScreen);
+            mBarTextPadStart = Math.max(0, mUrlOnScreen[0] - mBarOnScreen[0]);
+            mBarTextPadEnd =
+                    Math.max(
+                            0,
+                            mBarOnScreen[0]
+                                    + location.getWidth()
+                                    - (mUrlOnScreen[0] + url.getWidth()));
+        }
+    }
+
+    private CharSequence cachedBarUrl() {
+        String cached = mCachedBarUrl;
+        if (cached != null) return cached;
+        View url = mActivity.findViewById(R.id.url_bar);
+        if (url instanceof TextView urlText) {
+            CharSequence shown = urlText.getText();
+            if (shown != null && shown.length() > 0) {
+                cached = shown.toString();
+                mCachedBarUrl = cached;
+                return cached;
+            }
+        }
+        View location = mActivity.findViewById(R.id.location_bar);
+        if (location instanceof TextView locationText) {
+            CharSequence shown = locationText.getText();
+            if (shown != null && shown.length() > 0) {
+                cached = shown.toString();
+                mCachedBarUrl = cached;
+                return cached;
+            }
+        }
+        TabModel model = currentModel();
+        if (model != null) {
+            int index = model.index();
+            if (index >= 0 && index < model.getCount()) {
+                Tab tab = model.getTabAt(index);
+                if (tab != null
+                        && tab.getUrl() != null
+                        && !TextUtils.isEmpty(tab.getUrl().getSpec())) {
+                    cached = tab.getUrl().getSpec();
+                    mCachedBarUrl = cached;
+                    return cached;
+                }
+            }
+        }
+        cached = mOriginLabel;
+        mCachedBarUrl = cached;
+        return cached;
+    }
+
+    /** Width of the 32dp pill from the host, not from the full URL shown mid-morph. */
+    private int settledPillWidth() {
+        TextView origin = mPillOrigin;
+        float endSize =
+                TypedValue.applyDimension(
+                        TypedValue.COMPLEX_UNIT_SP,
+                        13f,
+                        mActivity.getResources().getDisplayMetrics());
+        int text = dp(48);
+        if (origin != null) {
+            float saved = origin.getPaint().getTextSize();
+            origin.getPaint().setTextSize(endSize);
+            text = Math.round(origin.getPaint().measureText(mOriginLabel));
+            origin.getPaint().setTextSize(saved);
+        }
+        int icons = 0;
+        if (mPillLockVisibility == View.VISIBLE) icons += dp(20);
+        if (mPillIconVisibility == View.VISIBLE) icons += dp(20);
+        int width = text + icons + dp(28);
+        int min = dp(PILL_MIN_WIDTH_DP);
+        int max = dp(PILL_MAX_WIDTH_DP);
+        if (width < min) width = min;
+        if (width > max) width = max;
+        return width;
+    }
+
+    private void applyMorphText(float shrink, float eased) {
+        TextView origin = mPillOrigin;
+        LinearLayout pill = mOriginPill;
+        if (origin == null || pill == null) return;
+        float endSize =
+                TypedValue.applyDimension(
+                        TypedValue.COMPLEX_UNIT_SP,
+                        13f,
+                        mActivity.getResources().getDisplayMetrics());
+        float size = lerp(mBarTextSizePx, endSize, eased);
+        if (Math.abs(origin.getTextSize() - size) > 0.25f) {
+            origin.setTextSize(TypedValue.COMPLEX_UNIT_PX, size);
+        }
+        boolean host = shrink >= 0.2f;
+        CharSequence want = host ? mOriginLabel : cachedBarUrl();
+        if (!TextUtils.equals(origin.getText(), want)) origin.setText(want);
+        float textAlpha = 1f;
+        if (shrink < 0.2f) {
+            if (shrink > 0.12f) textAlpha = (0.2f - shrink) / 0.08f;
+        } else if (shrink < 0.28f) {
+            textAlpha = (shrink - 0.2f) / 0.08f;
+        }
+        if (origin.getAlpha() != textAlpha) origin.setAlpha(textAlpha);
+        int endColor = color(0xFFE6E1E5, 0xFF1C1B1F);
+        origin.setTextColor(eased >= 1f ? endColor : blendColor(mBarTextColor, endColor, eased));
+        int lockVis = host ? mPillLockVisibility : View.GONE;
+        int iconVis = host ? mPillIconVisibility : View.GONE;
+        if (mPillLock != null && mPillLock.getVisibility() != lockVis) {
+            mPillLock.setVisibility(lockVis);
+        }
+        if (mPillIcon != null && mPillIcon.getVisibility() != iconVis) {
+            mPillIcon.setVisibility(iconVis);
+        }
+        int padStart = Math.round(lerp(Math.max(0, mBarTextPadStart), dp(10), eased));
+        int padEnd = Math.round(lerp(Math.max(0, mBarTextPadEnd), dp(12), eased));
+        if (pill.getPaddingStart() != padStart || pill.getPaddingEnd() != padEnd) {
+            pill.setPaddingRelative(padStart, 0, padEnd, 0);
+        }
+    }
+
+    /** Holds the handle row height while the pill is drawn outside it. */
+    private void ensurePillSlot() {
+        if (!(mHandleRow instanceof LinearLayout row)) return;
+        if (row.findViewWithTag("sheet_pill_slot") != null) return;
+        View slot = new View(mActivity);
+        slot.setTag("sheet_pill_slot");
+        slot.setVisibility(View.INVISIBLE);
+        slot.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        LinearLayout.LayoutParams params =
+                new LinearLayout.LayoutParams(dp(PILL_MIN_WIDTH_DP), dp(PILL_HEIGHT_DP));
+        params.gravity = Gravity.CENTER_HORIZONTAL;
+        row.addView(slot, 0, params);
+    }
+
+    private void removePillSlot() {
+        if (!(mHandleRow instanceof ViewGroup row)) return;
+        View slot = row.findViewWithTag("sheet_pill_slot");
+        if (slot != null) row.removeView(slot);
+    }
+
+    private void placePillOnRoot(
+            LinearLayout pill, FrameLayout root, int width, int height, float left, float top) {
+        ensurePillSlot();
+        if (pill.getParent() != root) {
+            if (pill.getParent() instanceof ViewGroup parent) parent.removeView(pill);
+            pill.setElevation(dp(24));
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                pill.setOutlineAmbientShadowColor(Color.TRANSPARENT);
+                pill.setOutlineSpotShadowColor(Color.TRANSPARENT);
+            }
+            root.setClipChildren(false);
+            root.setClipToPadding(false);
+            root.addView(
+                    pill,
+                    new FrameLayout.LayoutParams(width, height, Gravity.TOP | Gravity.START));
+        }
+        // Re-asserted on every frame: closing resets the elevation while the pill can stay on
+        // the root, and the list or actions row can be re-added after it. The travelling pill
+        // must draw above every sheet child at every progress.
+        float z = morphPillZ();
+        if (pill.getElevation() != z) pill.setElevation(z);
+        if (root.indexOfChild(pill) != root.getChildCount() - 1) pill.bringToFront();
+        FrameLayout.LayoutParams params;
+        if (pill.getLayoutParams() instanceof FrameLayout.LayoutParams existing) {
+            params = existing;
+        } else {
+            params = new FrameLayout.LayoutParams(width, height, Gravity.TOP | Gravity.START);
+            pill.setLayoutParams(params);
+        }
+        if (params.width != width
+                || params.height != height
