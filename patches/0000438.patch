         mSearchExpanded = true;
         beginSearchRowTransition();
         applySearchRow();
@@ -3259,6 +3263,7 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
     private void onSearchFocused() {
         if (!mOpen || !isSheetChrome()) return;
         if (!mSearchExpanded) {
+            rememberStopBeforeSearch();
             mSearchExpanded = true;
             applySearchRow();
             setSheetWindowFocusForSearch(true);
@@ -3291,9 +3296,65 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
         if (thief == null || !thief.requestFocus()) field.clearFocus();
     }
 
-    /** Empties the field, collapses it back to the magnifier, and lists every tab again. */
+    /**
+     * Records the sheet's stop once, before a search sends it to full. A sheet already on
+     * full stays there when the field later collapses; one that was at half returns to half.
+     */
+    private void rememberStopBeforeSearch() {
+        if (mStopBeforeSearch != null) return;
+        // A move that has already reached a stop counts, even if its end callback has not run.
+        if (mProgress >= 1f - 0.001f) {
+            mStopBeforeSearch = BareTabSheetSnap.State.FULL;
+            return;
+        }
+        if (Math.abs(mProgress - BareTabSheetSnap.HALF_RATIO) <= 0.001f) {
+            mStopBeforeSearch = BareTabSheetSnap.State.HALF;
+            return;
+        }
+        BareTabSheetSnap.State settled = mSettledState;
+        if (settled == BareTabSheetSnap.State.HALF || settled == BareTabSheetSnap.State.FULL) {
+            mStopBeforeSearch = settled;
+            return;
+        }
+        mStopBeforeSearch =
+                BareTabSheetSnap.nearest(mProgress) == BareTabSheetSnap.State.FULL
+                        ? BareTabSheetSnap.State.FULL
+                        : BareTabSheetSnap.State.HALF;
+    }
+
+    /**
+     * Snaps back to the stop from before this search. Closing has already marked the sheet
+     * shut, so that path forgets the search without this snap.
+     */
+    private boolean willRestoreStopAfterSearch() {
+        BareTabSheetSnap.State stop = mStopBeforeSearch;
+        if (!mOpen || !isSheetChrome()) return false;
+        if (stop != BareTabSheetSnap.State.HALF && stop != BareTabSheetSnap.State.FULL) return false;
+        float target = BareTabSheetSnap.progressOf(stop);
+        return !(stop == mSettledState && mAnimator == null && Math.abs(mProgress - target) < 0.001f);
+    }
+
+    private void restoreStopAfterSearch() {
+        BareTabSheetSnap.State stop = mStopBeforeSearch;
+        mStopBeforeSearch = null;
+        if (!mOpen || !isSheetChrome()) return;
+        if (stop != BareTabSheetSnap.State.HALF && stop != BareTabSheetSnap.State.FULL) return;
+        float target = BareTabSheetSnap.progressOf(stop);
+        if (stop == mSettledState && mAnimator == null && Math.abs(mProgress - target) < 0.001f) {
+            return;
+        }
+        settleSheet(stop, /* announce= */ true);
+    }
+
+    /**
+     * Empties the field, collapses it back to the magnifier, and lists every tab again. While
+     * the sheet stays open, it returns to the stop it had when the search opened.
+     */
     private void clearSearch() {
-        if (mSearchExpanded) beginSearchRowTransition();
+        boolean wasExpanded = mSearchExpanded;
+        // When the clear also moves the sheet back to its stop, the row's fade would be cut off
+        // by the settle and leave the actions row half faded; the sheet's motion carries it.
+        if (wasExpanded && !willRestoreStopAfterSearch()) beginSearchRowTransition();
         mSearchExpanded = false;
         EditText field = mSearchField;
         if (field != null && field.length() > 0) field.setText("");
@@ -3305,6 +3366,11 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
             mSnapNext = true;
             refresh();
         }
+        if (wasExpanded) {
+            restoreStopAfterSearch();
+        } else {
+            mStopBeforeSearch = null;
+        }
     }
 
