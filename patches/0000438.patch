+    private BareTabSheetSnap.@Nullable State mStopBeforeSearch;
     // How many times a pill tap has asked the omnibox to take focus.
     private int mOmniboxFocusRequests;
     // How far the keyboard lifts the bottom search field, and the sheet with it; and how much of
@@ -946,7 +948,8 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
 
                         @Override
                         public void handleOnBackPressed() {
-                            // 1) hide the keyboard, 2) clear and collapse the field, 3) close.
+                            // 1) hide the keyboard, 2) clear and collapse the field, which
+                            // returns the sheet to the stop it had before the search, 3) close.
                             // The system takes the first Back to hide a soft keyboard. A field
                             // that still has focus with no keyboard (hidden, or a hardware
                             // keyboard) goes straight to clearing, so it is never a dead press.
@@ -3235,6 +3238,7 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
     /** Magnifier: the row becomes the search field, the keyboard comes up, and the sheet goes full. */
     private void expandSearch() {
         if (!mOpen || !isSheetChrome() || mSearchField == null || mSearchExpanded) return;
