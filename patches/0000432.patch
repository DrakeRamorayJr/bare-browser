+    /**
+     * Puts the sheet chrome on the right ends of the panel. Rising from the bottom, the handle is at
+     * the top and the actions sit on the toolbar. Dropping from the top, the actions sit under the
+     * address bar and the handle is at the bottom, so the sheet is the same one mirrored. The
+     * drawer hides both, so it keeps the rising order.
+     */
+    private void orderSheetChrome() {
+        Panel panel = mPanel;
+        View handleRow = mHandleRow;
+        View actions = mSheetActions;
+        if (panel == null || handleRow == null || actions == null) return;
+        boolean fromTop = sheetFromTop();
+        int last = panel.getChildCount() - 1;
+        boolean ordered =
+                fromTop
+                        ? panel.indexOfChild(actions) == 0 && panel.indexOfChild(handleRow) == last
+                        : panel.indexOfChild(handleRow) == 0 && panel.indexOfChild(actions) == last;
+        if (!ordered) {
+            panel.removeView(handleRow);
+            panel.removeView(actions);
+            if (fromTop) {
+                panel.addView(actions, 0);
+                panel.addView(handleRow);
+            } else {
+                panel.addView(handleRow, 0);
+                panel.addView(actions);
+            }
+        }
+        if (handleRow instanceof LinearLayout row) {
+            View handle = row.findViewWithTag("sheet_handle");
+            View domain = mDomain;
+            if (handle == null || domain == null) return;
+            boolean handleFirst = row.indexOfChild(handle) < row.indexOfChild(domain);
+            if (handleFirst == fromTop) {
+                row.removeView(handle);
+                row.addView(handle, fromTop ? row.getChildCount() : 0);
+            }
+            if (handle.getLayoutParams() instanceof LinearLayout.LayoutParams params) {
+                int top = fromTop ? 0 : dp(2);
+                int bottom = fromTop ? dp(2) : 0;
+                if (params.topMargin != top || params.bottomMargin != bottom) {
+                    params.topMargin = top;
+                    params.bottomMargin = bottom;
+                    handle.setLayoutParams(params);
+                }
+            }
+        }
+    }
