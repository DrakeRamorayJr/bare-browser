+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.bare.BareTabSheetSnap.State;
+
+/** Snap decisions for the tab sheet: position and fling velocity choose the next stop. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE)
+public class BareTabSheetSnapUnitTest {
+    private static final float FLING = 100f;
+
+    @Test
+    public void progressOfEachState() {
+        assertEquals(0f, BareTabSheetSnap.progressOf(State.HIDDEN), 0f);
+        assertEquals(0.5f, BareTabSheetSnap.progressOf(State.HALF), 0f);
+        assertEquals(1f, BareTabSheetSnap.progressOf(State.FULL), 0f);
+    }
+
+    @Test
+    public void aSlowDragSettlesAtTheNearestStop() {
+        assertEquals(State.HIDDEN, BareTabSheetSnap.nearest(0f));
+        assertEquals(State.HIDDEN, BareTabSheetSnap.nearest(0.24f));
+        assertEquals(State.HALF, BareTabSheetSnap.nearest(0.25f));
+        assertEquals(State.HALF, BareTabSheetSnap.nearest(0.5f));
+        assertEquals(State.HALF, BareTabSheetSnap.nearest(0.74f));
+        assertEquals(State.FULL, BareTabSheetSnap.nearest(0.75f));
+        assertEquals(State.FULL, BareTabSheetSnap.nearest(1f));
+    }
+
+    @Test
+    public void aTiePrefersTheMoreOpenStop() {
+        // Midway between hidden and half is 0.25; midway between half and full is 0.75.
+        assertEquals(State.HALF, BareTabSheetSnap.nearest(0.25f));
+        assertEquals(State.FULL, BareTabSheetSnap.nearest(0.75f));
+    }
+
+    @Test
+    public void aFlingUpFromBelowHalfOpensToHalf() {
+        assertEquals(State.HALF, BareTabSheetSnap.snap(0.1f, -FLING, FLING));
+        assertEquals(State.HALF, BareTabSheetSnap.snap(0.49f, -200f, FLING));
+    }
+
+    @Test
+    public void aFlingUpFromHalfOrAboveGoesToFull() {
+        assertEquals(State.FULL, BareTabSheetSnap.snap(0.5f, -FLING, FLING));
+        assertEquals(State.FULL, BareTabSheetSnap.snap(0.7f, -FLING, FLING));
+        assertEquals(State.FULL, BareTabSheetSnap.snap(1f, -FLING, FLING));
+    }
+
+    @Test
+    public void aFlingDownFromAboveHalfSettlesAtHalf() {
+        assertEquals(State.HALF, BareTabSheetSnap.snap(0.51f, FLING, FLING));
+        assertEquals(State.HALF, BareTabSheetSnap.snap(0.9f, 250f, FLING));
+        assertEquals(State.HALF, BareTabSheetSnap.snap(1f, FLING, FLING));
+    }
+
+    @Test
+    public void aFlingDownFromHalfOrBelowCloses() {
+        assertEquals(State.HIDDEN, BareTabSheetSnap.snap(0.5f, FLING, FLING));
+        assertEquals(State.HIDDEN, BareTabSheetSnap.snap(0.2f, FLING, FLING));
+        assertEquals(State.HIDDEN, BareTabSheetSnap.snap(0f, FLING, FLING));
+    }
+
+    @Test
+    public void aVelocityBelowTheFlingThresholdUsesTheNearestStop() {
+        assertEquals(State.FULL, BareTabSheetSnap.snap(0.9f, 99f, FLING));
+        assertEquals(State.HIDDEN, BareTabSheetSnap.snap(0.1f, -99f, FLING));
+        assertEquals(State.HALF, BareTabSheetSnap.snap(0.4f, 50f, FLING));
+    }
+
+    @Test
+    public void aVelocityAtTheFlingThresholdCountsAsAFling() {
+        assertEquals(State.FULL, BareTabSheetSnap.snap(0.6f, -FLING, FLING));
+        assertEquals(State.HIDDEN, BareTabSheetSnap.snap(0.4f, FLING, FLING));
+    }
+}
