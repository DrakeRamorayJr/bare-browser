+    /**
+     * How far the sheet can travel from hidden to full. This is the height of the
+     * overlay, not the panel's current height, so a drag from half still covers
+     * the remaining distance to the top.
+     */
+    private int sheetRangeHeight() {
+        FrameLayout root = mRoot;
+        if (root != null && root.getHeight() > 0) return root.getHeight();
+        return 1;
+    }
+
+    /**
+     * Makes the sheet only as tall as its current progress and sits it on the
+     * bottom, so the actions stay on the toolbar and the list ends above them.
+     * The old translation plus a counter-move of the actions left the last cards
+     * under the row at half height.
+     */
+    private void layoutSheetPanel(Panel panel) {
+        int height = Math.max(1, Math.round(mProgress * sheetRangeHeight()));
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) panel.getLayoutParams();
+        if (params.width != ViewGroup.LayoutParams.MATCH_PARENT
+                || params.height != height
+                || params.gravity != Gravity.BOTTOM
+                || params.bottomMargin != 0) {
+            params.width = ViewGroup.LayoutParams.MATCH_PARENT;
+            params.height = height;
+            params.gravity = Gravity.BOTTOM;
+            params.bottomMargin = 0;
+            panel.setLayoutParams(params);
+        }
+    }
+
+    /** Lets the handle (and a downward over-pull at the top of the list) move the sheet. */
+    private void bindSheetHandle() {
+        View handleRow = mHandleRow;
+        if (handleRow == null) return;
+        if (!isSheetChrome()) {
+            handleRow.setOnTouchListener(null);
+            return;
+        }
+        handleRow.setOnTouchListener(this::onSheetHandleTouch);
+    }
+
+    private boolean onSheetHandleTouch(View view, MotionEvent ev) {
+        int slop = ViewConfiguration.get(view.getContext()).getScaledTouchSlop();
+        switch (ev.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mSheetHandleDragging = false;
+                mSheetDragStartY = ev.getRawY();
+                mSheetDragStartProgress = mProgress;
+                if (mSheetTracker != null) mSheetTracker.recycle();
+                mSheetTracker = VelocityTracker.obtain();
+                mSheetTracker.addMovement(ev);
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (mSheetTracker != null) mSheetTracker.addMovement(ev);
+                float dy = ev.getRawY() - mSheetDragStartY;
+                if (!mSheetHandleDragging && Math.abs(dy) > slop) {
+                    mSheetHandleDragging = true;
+                    mSheetDragStartY = ev.getRawY();
+                    mSheetDragStartProgress = mProgress;
+                    if (mAnimator != null) mAnimator.cancel();
+                    if (view.getParent() != null) {
+                        view.getParent().requestDisallowInterceptTouchEvent(true);
+                    }
+                    dy = 0f;
+                }
+                if (mSheetHandleDragging) {
+                    applyProgress(mSheetDragStartProgress - dy / sheetRangeHeight());
+                }
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                if (mSheetTracker != null) mSheetTracker.addMovement(ev);
+                if (mSheetHandleDragging) {
+                    float velocity = 0f;
+                    if (mSheetTracker != null) {
+                        mSheetTracker.computeCurrentVelocity(1000);
+                        velocity = mSheetTracker.getYVelocity();
+                    }
+                    finishSheetDrag(velocity);
+                }
+                mSheetHandleDragging = false;
+                if (mSheetTracker != null) {
+                    mSheetTracker.recycle();
+                    mSheetTracker = null;
+                }
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private void dragSheetBy(float dyDown) {
+        if (mAnimator != null) mAnimator.cancel();
+        applyProgress(mProgress - dyDown / sheetRangeHeight());
+    }
+
+    private void finishSheetDrag(float velocityY) {
+        BareTabSheetSnap.State next =
+                BareTabSheetSnap.snap(mProgress, velocityY, dp(SHEET_FLING_DP_PER_S));
+        if (next == BareTabSheetSnap.State.HIDDEN) {
+            close();
+        } else {
+            animateTo(BareTabSheetSnap.progressOf(next), null);
+        }
+    }
