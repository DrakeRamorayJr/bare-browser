+package org.chromium.chrome.browser.bare;
+
+/**
+ * Snap points for the tab sheet.
+ *
+ * <p>Progress is 0 when the sheet is hidden, {@link #HALF_RATIO} when it is half-open (the page
+ * stays visible above it), and 1 when it is full (a small gap remains below the status bar). A
+ * fling up settles at the next stop above the finger; a fling down settles at the next stop
+ * below it, and closes when that stop is hidden. A slow drag settles at the nearest stop.
+ *
+ * <p>The rules follow Material's BottomSheetBehavior (position plus velocity), but the sheet
+ * itself stays a custom view: this class has no dependency on BottomSheetBehavior.
+ */
+final class BareTabSheetSnap {
+    enum State {
+        HIDDEN,
+        HALF,
+        FULL
+    }
+
+    /** Fraction of the full height at which the sheet sits when half-open. */
+    static final float HALF_RATIO = 0.5f;
+
+    private BareTabSheetSnap() {}
+
+    static float progressOf(State state) {
+        switch (state) {
+            case FULL:
+                return 1f;
+            case HALF:
+                return HALF_RATIO;
+            case HIDDEN:
+            default:
+                return 0f;
+        }
+    }
+
+    /** The nearest of the three stops to {@code progress}. Ties prefer the more open stop. */
+    static State nearest(float progress) {
+        float hidden = Math.abs(progress - 0f);
+        float half = Math.abs(progress - HALF_RATIO);
+        float full = Math.abs(progress - 1f);
+        if (full <= half && full <= hidden) return State.FULL;
+        if (half <= hidden) return State.HALF;
+        return State.HIDDEN;
+    }
+
+    /**
+     * Where the sheet should settle after a drag.
+     *
+     * @param progress how open the sheet is now, from 0 (hidden) to 1 (full)
+     * @param velocityY pixels per second, in the same sense as translation Y: positive is a
+     *     downward fling, toward closed
+     * @param flingVelocity the smallest |velocityY| that counts as a fling, in the same units
+     */
+    static State snap(float progress, float velocityY, float flingVelocity) {
+        if (Math.abs(velocityY) >= flingVelocity) {
+            if (velocityY < 0f) {
+                return progress >= HALF_RATIO ? State.FULL : State.HALF;
+            }
+            return progress > HALF_RATIO ? State.HALF : State.HIDDEN;
+        }
+        return nearest(progress);
+    }
+}
