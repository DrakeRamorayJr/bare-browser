+    private boolean isCloseBarHandoffPath() {
+        return mMorphClosing || mForceBarRect || mCloseReveal;
+    }
+
+    /** Cover fill: sheet surface until reveal, then eases into the real bar surface over the fade. */
+    private @ColorInt int bottomBarCoverColor() {
+        int base = liveBottomChromeColor();
+        if (!mCloseReveal) return base;
+        float t = morphEase(unitRange(mHandoffFade));
+        return t <= 0f ? base : blendColor(base, realBottomBarSurfaceColor(), t);
+    }
+
+    private @ColorInt int realBottomBarSurfaceColor() {
+        int painted = opaqueBackgroundColor(mActivity.findViewById(R.id.toolbar));
+        if (painted != 0) return painted;
+        painted = opaqueBackgroundColor(mActivity.findViewById(R.id.control_container));
+        if (painted != 0) return painted;
+        return ChromeColors.getDefaultThemeColor(mActivity, currentIncognito());
+    }
+
+    private int toolbarTopInRoot(
+            FrameLayout root, View bar, int barTopOnScreen, int rootTopOnScreen) {
+        int best = barTopOnScreen - rootTopOnScreen;
+        int[] at = new int[2];
+        for (int id : new int[] {R.id.toolbar, R.id.control_container}) {
+            View container = mActivity.findViewById(id);
+            if (container == null || container.getHeight() <= 0 || !container.isAttachedToWindow()
+                    || isInside(container, root)) continue;
+            container.getLocationOnScreen(at);
+            int delta = barTopOnScreen - at[1];
+            if (delta > 0 && delta <= bar.getHeight()) {
+                best = Math.min(best, at[1] - rootTopOnScreen);
+            }
+        }
+        return best;
+    }
+
+    private static void applyBottomBarCoverShadow(View cover, boolean suppressShadow) {
+        ViewOutlineProvider want =
+                suppressShadow ? NO_SHADOW_OUTLINE : ViewOutlineProvider.BACKGROUND;
+        if (cover.getOutlineProvider() != want) {
+            cover.setOutlineProvider(want);
+            cover.invalidateOutline();
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            int shadow = suppressShadow ? Color.TRANSPARENT : Color.BLACK;
+            if (cover.getOutlineAmbientShadowColor() != shadow) {
+                cover.setOutlineAmbientShadowColor(shadow);
+            }
+            if (cover.getOutlineSpotShadowColor() != shadow) {
+                cover.setOutlineSpotShadowColor(shadow);
+            }
+        }
+    }
