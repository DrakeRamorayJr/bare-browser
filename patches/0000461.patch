+    @Test
+    public void testCloseHandoffCoverBandHasNoShadowAndFadesContinuouslyIntoRealBar() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        View buttons = new View(mActivity);
+        buttons.setId(BareVerticalTabsDrawer.bottomBarIdForTesting());
+        buttons.setBackgroundColor(0xFFE0E0E0);
+        content().addView(buttons, new FrameLayout.LayoutParams(px(400), px(36), Gravity.BOTTOM));
+        View toolbar = new View(mActivity);
+        toolbar.setId(org.chromium.chrome.R.id.toolbar);
+        toolbar.setBackgroundColor(0xFFFFFFFF);
+        content().addView(toolbar, new FrameLayout.LayoutParams(px(400), px(60), Gravity.BOTTOM));
+        TextView bar = new TextView(mActivity);
+        android.widget.ImageView shield = new android.widget.ImageView(mActivity);
+        parkTheCloseMorph(bar, shield);
+
+        View cover = findTag("sheet_bottom_bar_cover");
+        assertNotNull(cover);
+        assertEquals(View.VISIBLE, cover.getVisibility());
+        // Before the ghost-cover tick runs, the cover sits one bar + 16dp above toolbar top.
+        assertEquals(
+                (float) (toolbar.getTop() - bar.getHeight() - px(16)),
+                cover.getTranslationY(),
+                1f);
+        assertNotEquals(ViewOutlineProvider.BACKGROUND, cover.getOutlineProvider());
+        Outline parkedOutline = new Outline();
+        cover.getOutlineProvider().getOutline(cover, parkedOutline);
+        assertEquals(0f, parkedOutline.getAlpha(), 0.001f);
+        int parkedColor = drawableColor(cover.getBackground());
+        float parkedAlpha = cover.getAlpha();
+        assertEquals(0xFFE0E0E0, parkedColor);
+        assertEquals(1f, parkedAlpha, 0.001f);
+
+        // Hand-off reveal frame matches the previous parked frame: no one-frame jump.
+        mDrawer.revealCloseHandoffForTesting();
+        assertEquals((float) toolbar.getTop(), cover.getTranslationY(), 1f);
+        assertEquals(parkedColor, drawableColor(cover.getBackground()));
+        assertEquals(parkedAlpha, cover.getAlpha(), 0.001f);
+        Outline revealOutline = new Outline();
+        cover.getOutlineProvider().getOutline(cover, revealOutline);
+        assertEquals(0f, revealOutline.getAlpha(), 0.001f);
+
+        // Cover colour eases monotonically to the real white bar while cover alpha clears.
+        int prevChannel = android.graphics.Color.red(parkedColor);
+        float prevAlpha = parkedAlpha;
+        for (float fade : new float[] {0.25f, 0.5f, 0.75f, 1f}) {
+            mDrawer.setCloseHandoffFadeForTesting(fade);
+            int channel = android.graphics.Color.red(drawableColor(cover.getBackground()));
+            float alpha = cover.getAlpha();
+            assertTrue("fade=" + fade + " ch=" + channel + " prev=" + prevChannel,
+                    channel > prevChannel);
+            assertTrue("fade=" + fade + " alpha=" + alpha + " prev=" + prevAlpha,
+                    alpha <= prevAlpha);
+            prevChannel = channel;
+            prevAlpha = alpha;
+        }
+        assertEquals(0xFFFFFFFF, drawableColor(cover.getBackground()));
+        assertEquals(0f, cover.getAlpha(), 0.01f);
+
+        mDrawer.flushCloseHandoffForTesting();
+        assertEquals(View.GONE, cover.getVisibility());
+    }
+
+    @Test
+    public void testCloseHandoffBottomBarRowTravelAndAlphaEaseContinuouslyWithoutJump() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        View buttons = new View(mActivity);
+        buttons.setId(BareVerticalTabsDrawer.bottomBarIdForTesting());
+        buttons.setAlpha(1f);
+        buttons.setVisibility(View.VISIBLE);
+        content().addView(buttons, new FrameLayout.LayoutParams(px(400), px(36), Gravity.BOTTOM));
+        TextView bar = new TextView(mActivity);
+        android.widget.ImageView shield = new android.widget.ImageView(mActivity);
+        parkTheCloseMorph(bar, shield);
+
+        float parkedTravel = mDrawer.bottomBarTravelForTesting();
+        float parkedAlpha = buttons.getAlpha();
+        assertTrue("parked travel " + parkedTravel, parkedTravel > 0.5f);
+        assertEquals(1f - parkedTravel, parkedAlpha, 0.001f);
+        assertEquals(0f, buttons.getTranslationY(), 0.001f);
+
+        // Hand-off reveal matches the previous frame: no snap at J2.
+        mDrawer.revealCloseHandoffForTesting();
+        assertEquals(parkedTravel, mDrawer.bottomBarTravelForTesting(), 0.001f);
+        assertEquals(parkedAlpha, buttons.getAlpha(), 0.001f);
+        assertEquals(0f, buttons.getTranslationY(), 0.001f);
+
+        // Travel eases strictly down to 0 and row alpha eases strictly up to 1 across the fade.
+        float prevTravel = parkedTravel;
+        float prevAlpha = parkedAlpha;
+        for (float fade : new float[] {0.25f, 0.5f, 0.75f, 1f}) {
+            mDrawer.setCloseHandoffFadeForTesting(fade);
+            float travel = mDrawer.bottomBarTravelForTesting();
+            float alpha = buttons.getAlpha();
+            assertTrue("fade=" + fade + " travel=" + travel + " prev=" + prevTravel,
+                    travel < prevTravel);
+            assertTrue("fade=" + fade + " alpha=" + alpha + " prev=" + prevAlpha,
+                    alpha > prevAlpha);
+            assertEquals(0f, buttons.getTranslationY(), 0.001f);
+            prevTravel = travel;
+            prevAlpha = alpha;
+        }
+        assertEquals(0f, mDrawer.bottomBarTravelForTesting(), 0.001f);
+        assertEquals(1f, buttons.getAlpha(), 0.001f);
+        assertEquals(View.VISIBLE, buttons.getVisibility());
+
+        mDrawer.flushCloseHandoffForTesting();
+        assertEquals(0f, mDrawer.bottomBarTravelForTesting(), 0.001f);
+        assertEquals(1f, buttons.getAlpha(), 0.001f);
+        assertEquals(0f, buttons.getTranslationY(), 0.001f);
+        assertEquals(View.VISIBLE, buttons.getVisibility());
+    }
