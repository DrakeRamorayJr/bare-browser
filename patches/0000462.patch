+    /** Status-bar colour while the page card is up: transparent until the close hand-off eases it back. */
+    private @ColorInt int pageCardHandoffStatusBarColor() {
+        if (!pageCardHandoffWanted()) return Color.TRANSPARENT;
+        float handoff = morphHandoffAlpha();
+        if (handoff >= 0.999f) return Color.TRANSPARENT;
+        @ColorInt int base =
+                mHaveSavedStatusBarColor
+                        ? mSavedStatusBarColor
+                        : ChromeColors.getDefaultThemeColor(mActivity, /* isIncognito= */ false);
