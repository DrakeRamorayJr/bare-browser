+    /**
+     * Stores the bar rect on the first frames, before the button row slides.
+     * Later frames keep that rect so the morph returns to the resting slot.
+     */
+    private void captureRestBar(View location) {
+        if (location.getWidth() <= 0 || !location.isAttachedToWindow()) return;
+        boolean settled =
+                mProgress <= 0.001f && !mMorphActive && !mForceBarRect && !mCloseReveal;
+        if (!settled && mRestBarW > 0) return;
+        if (!settled && buttonBarGone() > 0.02f) return;
+        View buttons = bottomButtonBar();
+        if (buttons != null && Math.abs(buttons.getTranslationY()) > 1f) return;
+        if (Math.abs(location.getTranslationY()) > 1f) return;
+        location.getLocationOnScreen(mBarOnScreen);
+        mRestBarX = mBarOnScreen[0];
+        mRestBarY = mBarOnScreen[1];
+        mRestBarW = location.getWidth();
+        mRestBarH = location.getHeight();
+        captureRestContent(location);
+    }
+
+    /** URL inset and icon rects while the bar is on its resting coordinates. */
+    private void captureRestContent(View location) {
+        View url = mActivity.findViewById(R.id.url_bar);
+        mRestTextLead = -1;
+        mRestTextTrail = -1;
+        if (url instanceof TextView text && url.getWidth() > 0 && url.isAttachedToWindow()) {
+            int[] at = new int[2];
+            url.getLocationOnScreen(at);
+            mRestTextLead = Math.max(0, at[0] + text.getCompoundPaddingStart() - mRestBarX);
+            int textRight = at[0] + url.getWidth() - text.getCompoundPaddingEnd();
+            mRestTextTrail = Math.max(0, mRestBarX + mRestBarW - textRight);
+        }
+        int savedW = mBarWidthPx;
+        int savedH = mBarHeightPx;
+        mBarWidthPx = mRestBarW;
+        mBarHeightPx = mRestBarH;
+        mRestIconCount = 0;
+        try {
+            ImageView[] sources = new ImageView[24];
+            int n = 0;
+            n = collectBarIcons(mActivity.findViewById(R.id.control_container), sources, n);
+            n = collectBarIcons(mActivity.findViewById(R.id.toolbar), sources, n);
+            n = collectBarIcons(mActivity.findViewById(R.id.toolbar_buttons), sources, n);
+            n = collectBarIcons(location, sources, n);
+            if (location.getParent() instanceof View barParent) {
+                n = collectBarIcons(barParent, sources, n);
+            }
+            n = addBarIcon(sources, n, mActivity.findViewById(R.id.location_bar_status));
+            n = addBarIcon(sources, n, mActivity.findViewById(R.id.location_bar_site_favicon));
+            n = addBarIcon(sources, n, mActivity.findViewById(R.id.location_bar_site_settings_button));
+            int shareId =
+                    mActivity
+                            .getResources()
+                            .getIdentifier("bare_share_button", "id", mActivity.getPackageName());
+            int copyId =
+                    mActivity
+                            .getResources()
+                            .getIdentifier("bare_copy_button", "id", mActivity.getPackageName());
+            if (shareId != 0) n = addBarIcon(sources, n, mActivity.findViewById(shareId));
+            if (copyId != 0) n = addBarIcon(sources, n, mActivity.findViewById(copyId));
+            for (int i = 0; i < n && mRestIconCount < mRestIconId.length; i++) {
+                ImageView source = sources[i];
+                if (source.getId() == View.NO_ID || source.getWidth() <= 0) continue;
+                if (source.getVisibility() != View.VISIBLE) continue;
+                if (!iconSitsOnBar(source)) continue;
+                int[] at = new int[2];
+                source.getLocationOnScreen(at);
+                int slot = mRestIconCount++;
+                mRestIconId[slot] = source.getId();
+                mRestIconL[slot] = at[0] - mRestBarX;
+                mRestIconT[slot] = at[1] - mRestBarY;
+                mRestIconW[slot] = source.getWidth();
+                mRestIconH[slot] = source.getHeight();
+            }
+        } finally {
+            mBarWidthPx = savedW;
+            mBarHeightPx = savedH;
+        }
+    }
