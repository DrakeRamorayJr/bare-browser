+    /** Resting rect of this icon, or null when it was not on the settled bar. */
+    private boolean restIconRect(View view, int[] out) {
+        int id = view.getId();
+        if (id == View.NO_ID) return false;
+        for (int i = 0; i < mRestIconCount; i++) {
+            if (mRestIconId[i] != id) continue;
+            out[0] = mRestIconL[i];
+            out[1] = mRestIconT[i];
+            out[2] = mRestIconW[i];
+            out[3] = mRestIconH[i];
+            return true;
+        }
+        return false;
+    }
