+    /**
+     * One frame of the morph, sitting on the real bar rect, before the texture returns.
+     * A drag that is still down does not park: the finger can open the sheet again.
+     */
+    private boolean shouldParkClose() {
+        // mOpen is cleared at the start of close(). Parking on that flag alone
+        // jumped the sheet to the bar on the first frame and left only the dim
+        // moving. Park on the last frame, once progress has arrived.
+        return bottomBarMorph()
+                && !mToolbarPulling
+                && !mOpen
+                && mProgress <= 0.001f
+                && !mCloseCommit
+                && !mHandlingDismiss
+                && mMorphActive
+                && mRoot != null
+                && mRoot.getVisibility() == View.VISIBLE;
+    }
+
+    private void scheduleCloseHandoff() {
+        if (mCloseHandoffPosted) return;
+        mCloseHandoffPosted = true;
+        View host = handoffHost();
+        host.removeCallbacks(mCloseHandoffRunnable);
+        host.postOnAnimation(mCloseHandoffRunnable);
+    }
+
+    /**
+     * First posted frame: the real bar is shown under the morph, which stays on the
+     * resting rect. Next posted frame: the morph leaves. Removing both in one frame
+     * left the slot empty until the texture was captured.
+     */
+    private void commitCloseHandoff() {
+        mCloseHandoffPosted = false;
+        if (mOpen || mProgress > 0.001f) {
+            mForceBarRect = false;
+            mCloseReveal = false;
+            return;
+        }
+        // A hold posted for a capture must not reopen a close that already finished.
+        if (!mCloseReveal
+                && !mMorphActive
+                && (mRoot == null || mRoot.getVisibility() != View.VISIBLE)) {
+            return;
+        }
+        if (!mCloseReveal) {
+            mCloseReveal = true;
+            mForceBarRect = true;
+            applyProgress(0f);
+            // One next frame only. commit removes any earlier copy before this post.
+            View host = handoffHost();
+            host.removeCallbacks(mCloseHandoffRunnable);
+            mCloseHandoffPosted = true;
+            host.postOnAnimation(mCloseHandoffRunnable);
+            return;
+        }
+        mCloseReveal = false;
+        mCloseCommit = true;
+        try {
+            mForceBarRect = false;
+            applyProgress(0f);
+            finishCloseChrome();
+        } finally {
+            mCloseCommit = false;
+        }
+    }
+
+    /** Glass window, page card, and focus, after the last morph frame has been drawn. */
+    private void finishCloseChrome() {
+        if (mOpen) return;
+        FrameLayout root = mRoot;
+        if (root != null) foldHaptic(root);
+        if (root != null) root.setVisibility(View.GONE);
+        setBackProgress(0f);
+        mSettledState = null;
+        mImeLift = 0;
+        mImeCover = 0;
+        mLatchedImeTop = -1;
+        updateHandleAccessibility();
+        Dialog glass = mGlassWindow;
+        if (glass != null && glass.isShowing()) {
+            // No exit animation: the parked morph already matches the bar.
+            killWindowAnimations(glass.getWindow());
+            glass.dismiss();
+        }
+        restorePageCard();
+        releaseObservers();
+        deliverPendingOmniboxFocus();
+    }
