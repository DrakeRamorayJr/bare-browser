+package org.chromium.chrome.browser.bare;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/**
+ * Whether the Vertical tabs button opens the side drawer or the tab sheet.
+ *
+ * <p>The side drawer is the default, and is what Bare ships: nothing is stored until the user
+ * picks the sheet. The two UIs share the same tab list; this only says which chrome it sits in.
+ */
+@NullMarked
+public final class BareTabsStyle {
+    /** Stored value, and the default, for the side drawer. */
+    public static final String DRAWER = "drawer";
+
+    /** Stored value for the bottom (or top) tab sheet. */
+    public static final String SHEET = "sheet";
+
+    private BareTabsStyle() {}
+
+    /** Whether the Vertical tabs button should open the sheet rather than the side drawer. */
+    public static boolean isSheet() {
+        return SHEET.equals(
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_TABS_STYLE, DRAWER));
+    }
+
+    /**
+     * Records the style, or forgets it when the user is back on the default drawer so a reset and
+     * a fresh profile look the same.
+     */
+    public static void setStyle(String style) {
+        if (SHEET.equals(style)) {
+            ChromeSharedPreferences.getInstance()
+                    .writeString(ChromePreferenceKeys.BARE_TABS_STYLE, SHEET);
+        } else {
+            ChromeSharedPreferences.getInstance().removeKey(ChromePreferenceKeys.BARE_TABS_STYLE);
+        }
+    }
+}
