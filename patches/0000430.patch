+    /** Insets the overlay so it does not cover the real toolbar, which stays tappable. */
+    private void applySheetInsets() {
+        FrameLayout root = mRoot;
+        if (root == null || !(root.getLayoutParams() instanceof FrameLayout.LayoutParams)) return;
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) root.getLayoutParams();
+        int top = 0;
+        int bottom = 0;
+        if (isSheetChrome()) {
+            int[] inset = toolbarInsets();
+            top = inset[0];
+            bottom = inset[1];
+        }
+        if (params.topMargin == top && params.bottomMargin == bottom) return;
+        params.topMargin = top;
+        params.bottomMargin = bottom;
+        root.setLayoutParams(params);
+    }
+
+    /**
+     * How much of the activity's content the top and bottom toolbars occupy, so the sheet can sit
+     * in the gap. When the address bar is on top, this also leaves that bar clear (the five-button
+     * bar stays at the bottom). Full visual mirroring of the sheet is a later step.
+     */
+    private int[] toolbarInsets() {
+        View content = mActivity.findViewById(android.R.id.content);
+        if (content == null) return new int[] {0, 0};
+        int[] contentLoc = new int[2];
+        content.getLocationOnScreen(contentLoc);
+        int contentTop = contentLoc[1];
+        int contentBottom = contentLoc[1] + content.getHeight();
+        if (content.getHeight() <= 0) return new int[] {0, 0};
+        int top = 0;
+        int bottom = 0;
+        int[] ids =
+                new int[] {
+                    R.id.control_container,
+                    org.chromium.chrome.browser.ui.bottombar.R.id.bottom_bar_container
+                };
+        // The edge-to-edge chin sits below the bottom bar, so the bar's bottom is not flush
+        // with the content's bottom. Treat a bar as bottom chrome if it lives in the lower
+        // third of the window, and as top chrome if it lives in the upper third.
+        int third = Math.max(dp(80), content.getHeight() / 3);
+        int[] loc = new int[2];
+        for (int id : ids) {
+            View bar = mActivity.findViewById(id);
+            if (bar == null || bar.getVisibility() != View.VISIBLE || bar.getHeight() <= 0) {
+                continue;
+            }
+            bar.getLocationOnScreen(loc);
+            int barTop = loc[1];
+            int barBottom = loc[1] + bar.getHeight();
+            if (barTop <= contentTop + third) {
+                top = Math.max(top, barBottom - contentTop);
+            }
+            if (barBottom >= contentBottom - third) {
+                bottom = Math.max(bottom, contentBottom - barTop);
+            }
+        }
+        return new int[] {Math.max(0, top), Math.max(0, bottom)};
+    }
