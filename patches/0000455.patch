+package org.chromium.chrome.browser.ui.bottombar;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Pulls the tab sheet from an upward drag on the five-button bar.
+ *
+ * <p>The bar cannot see the sheet. Whatever builds the bar hands it an implementation that
+ * forwards to the same begin, update, and end the address bar uses.
+ */
+@NullMarked
+public interface BareBottomBarSheetPull {
+    /** Whether an upward drag should open the sheet. False for the side drawer and a top bar. */
+    boolean wantsPull();
+
+    /** The drag has passed touch slop. Show the sheet where it is, without animating. */
+    void beginPull();
+
+    /** The finger is {@code openingPx} pixels above where the drag locked. */
+    void updatePull(float openingPx);
+
+    /**
+     * The finger has lifted. {@code velocityY} is pixels per second on the screen, positive
+     * downward, or 0 when the touch was cancelled.
+     */
+    void endPull(float velocityY);
+}
