+    @Test
+    public void testTheButtonBarPullsOnlyTheBottomSheet() {
+        // Side drawer.
+        assertFalse(BareTabSheetToolbarSwipe.wantsButtonBarPull(false, false, true));
+        // Top address bar: the sheet opens downward, so the button bar is left alone.
