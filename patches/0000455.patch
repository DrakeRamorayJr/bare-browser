+        long t = SystemClock.uptimeMillis();
+        barTouch(bar, t, t, MotionEvent.ACTION_DOWN, at[0], at[1]);
+        barTouch(bar, t, t + 16, MotionEvent.ACTION_MOVE, at[0] + slop + 30, at[1]);
+        barTouch(bar, t, t + 32, MotionEvent.ACTION_UP, 1000f, at[1]);
+        assertEquals(0, pull.mBegun);
+        assertEquals(0, pull.mEnded);
+        assertEquals(0, clicks[0]);
+        assertEquals(View.GONE, bar.findViewById(R.id.bottom_bar_swipe_slider).getVisibility());
+    }
