+    @Test
+    public void testSideDrawerModeIgnoresAnUpwardDrag() {
+        BottomBarView bar = inflateBar();
+        RecordingPull pull = new RecordingPull();
+        pull.mWants = false;
+        bar.setSheetPull(pull);
+        View plus = bar.findViewById(R.id.new_tab_button);
+        // A real button is clickable, which is what makes it the touch target.
+        plus.setOnClickListener(view -> {});
+        int[] cancels = new int[1];
+        int[] ups = new int[1];
+        plus.setOnTouchListener(
+                (view, event) -> {
+                    int action = event.getActionMasked();
+                    if (action == MotionEvent.ACTION_CANCEL) cancels[0]++;
+                    if (action == MotionEvent.ACTION_UP) ups[0]++;
+                    return false;
+                });
+        float[] at = centerOf(bar, plus);
+        int slop = ViewConfiguration.get(mActivity).getScaledTouchSlop();
+        long t = SystemClock.uptimeMillis();
+        barTouch(bar, t, t, MotionEvent.ACTION_DOWN, at[0], at[1]);
+        barTouch(bar, t, t + 16, MotionEvent.ACTION_MOVE, at[0], at[1] - slop - 40);
+        barTouch(bar, t, t + 32, MotionEvent.ACTION_UP, at[0], at[1] - slop - 40);
+        assertEquals(0, pull.mBegun);
+        assertEquals(0, pull.mEnded);
+        assertEquals(0, cancels[0]);
+        assertEquals(1, ups[0]);
+    }
 }
