+    @Test
+    public void testATapOnNewTabStillClicks() {
+        BottomBarView bar = inflateBar();
+        // Attached, a tap posts its click onto the window's looper. Unattached, that
+        // runnable sits on a queue the test looper does not run.
+        mActivity.setContentView(bar);
+        bar.measure(
+                View.MeasureSpec.makeMeasureSpec(1080, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(160, View.MeasureSpec.EXACTLY));
+        bar.layout(0, 0, 1080, 160);
+        View plus = bar.findViewById(R.id.new_tab_button);
+        int[] clicks = new int[1];
+        plus.setOnClickListener(view -> clicks[0]++);
+        float[] at = centerOf(bar, plus);
+        long t = SystemClock.uptimeMillis();
+        barTouch(bar, t, t, MotionEvent.ACTION_DOWN, at[0], at[1]);
+        barTouch(bar, t, t + 30, MotionEvent.ACTION_UP, at[0], at[1]);
+        ShadowLooper.idleMainLooper();
+        assertEquals(1, clicks[0]);
+    }
+
+    @Test
+    public void testAnUpwardDragFromNewTabOpensTheSheetAndDoesNotClick() {
+        BottomBarView bar = inflateBar();
+        RecordingPull pull = new RecordingPull();
+        bar.setSheetPull(pull);
+        View plus = bar.findViewById(R.id.new_tab_button);
+        int[] clicks = new int[1];
+        int[] cancels = new int[1];
+        plus.setOnClickListener(view -> clicks[0]++);
+        plus.setOnTouchListener(
+                (view, event) -> {
+                    if (event.getActionMasked() == MotionEvent.ACTION_CANCEL) cancels[0]++;
+                    return false;
+                });
+        float[] at = centerOf(bar, plus);
+        int slop = ViewConfiguration.get(mActivity).getScaledTouchSlop();
+        long t = SystemClock.uptimeMillis();
+        float y = at[1];
+        barTouch(bar, t, t, MotionEvent.ACTION_DOWN, at[0], y);
+        // Past slop, straight up: the lock. The sheet has not moved yet.
+        barTouch(bar, t, t + 16, MotionEvent.ACTION_MOVE, at[0], y - slop - 4);
+        barTouch(bar, t, t + 24, MotionEvent.ACTION_UP, at[0], y - slop - 4 - 160);
+        assertEquals(0, clicks[0]);
+        assertEquals(1, cancels[0]);
+        assertEquals(1, pull.mBegun);
+        assertEquals(1, pull.mEnded);
+        assertEquals(160f, pull.mLastOpening, 1f);
+        // Flung upward: negative on the screen, which is what the sheet spring consumes.
+        assertTrue(pull.mVelocity < 0f);
+    }
+
+    @Test
+    public void testAHorizontalDragDoesNotOpenTheSheet() {
+        BottomBarView bar = inflateBar();
