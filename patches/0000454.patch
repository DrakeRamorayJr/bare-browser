+    /**
+     * Underdamped settle for a bottom sheet. Stiffness 700 and damping 0.9 match
+     * androidx SpringForce (mass 1). Shown progress is clamped to 0..1. A close that
+     * dips below 0 stays just open until the spring is at rest, so the page card and
+     * the morph park once.
+     */
+    private final class SheetSpring implements Choreographer.FrameCallback {
+        private float mValue;
+        private float mVelocity;
+        private float mTarget;
+        private float mScale = 1f;
+        private float mSim;
+        private long mLastNanos;
+        private boolean mStarted;
+        private boolean mDiscarded;
+        private @Nullable Runnable mSettled;
+        private @Nullable Runnable mDelayed;
+        private @Nullable View mDelayHost;
+        private ViewTreeObserver.@Nullable OnPreDrawListener mPreDraw;
+
+        void prepare(float from, float velocity, float target, float scale, Runnable settled) {
+            mValue = from;
+            mVelocity = velocity;
+            mTarget = target;
+            mScale = scale <= 0f ? 1f : scale;
+            mSettled = settled;
+        }
+
+        void start() {
+            if (mDiscarded || mStarted) return;
+            mStarted = true;
+            clearDelay();
+            postFrame();
+        }
+
+        /** Lets a test step a spring that is still waiting for the first draw. */
+        void ensureStarted() {
+            mStarted = true;
+        }
+
+        void armDelayed(View host) {
+            mDelayHost = host;
+            Runnable delayed =
+                    () -> {
+                        if (mDiscarded || mStarted) return;
+                        start();
+                    };
+            mDelayed = delayed;
+            mPreDraw =
+                    new ViewTreeObserver.OnPreDrawListener() {
+                        @Override
+                        public boolean onPreDraw() {
+                            ViewTreeObserver observer = host.getViewTreeObserver();
+                            if (observer.isAlive()) observer.removeOnPreDrawListener(this);
+                            host.post(delayed);
+                            return true;
+                        }
+                    };
+            host.getViewTreeObserver().addOnPreDrawListener(mPreDraw);
+            host.invalidate();
+            host.postDelayed(delayed, 150);
+        }
+
+        void cancel() {
+            mDiscarded = true;
+            mSettled = null;
+            clearDelay();
+            removeFrame();
+        }
+
+        void end() {
+            if (mDiscarded) return;
+            mDiscarded = true;
+            clearDelay();
+            removeFrame();
+            Runnable settled = mSettled;
+            mSettled = null;
+            if (settled != null) settled.run();
+        }
+
+        boolean atRest() {
+            return Math.abs(mValue - mTarget) < 0.001f && Math.abs(mVelocity) < 0.05f;
+        }
+
+        float shown() {
+            float shown = mValue;
+            if (shown < 0f) shown = 0f;
+            if (shown > 1f) shown = 1f;
+            // Hold just above the park threshold until end() applies the real 0.
+            if (mTarget <= 0.001f && shown < 0.002f) shown = 0.002f;
+            return shown;
+        }
+
+        void step(float dt) {
+            if (dt <= 0f) return;
+            double wn = Math.sqrt(SHEET_SPRING_STIFFNESS);
+            double zeta = SHEET_SPRING_DAMPING;
+            double wd = wn * Math.sqrt(Math.max(0.0, 1.0 - zeta * zeta));
+            if (wd < 1e-4) {
+                mValue = mTarget;
+                mVelocity = 0f;
+                return;
+            }
+            double x0 = mValue - mTarget;
+            double v0 = mVelocity;
+            double exp = Math.exp(-zeta * wn * dt);
+            double cos = Math.cos(wd * dt);
+            double sin = Math.sin(wd * dt);
+            double cosCoeff = x0;
+            double sinCoeff = (v0 + zeta * wn * x0) / wd;
+            double offset = exp * (cosCoeff * cos + sinCoeff * sin);
+            double vel =
+                    exp
+                            * (-zeta * wn * (cosCoeff * cos + sinCoeff * sin)
+                                    + wd * (-cosCoeff * sin + sinCoeff * cos));
+            mValue = (float) (mTarget + offset);
+            mVelocity = (float) vel;
+        }
+
+        @Override
+        public void doFrame(long frameTimeNanos) {
+            if (mDiscarded || mSheetSpring != this) return;
+            float dtReal;
+            if (mLastNanos == 0L) {
+                dtReal = 0.016f;
+            } else {
+                dtReal = (frameTimeNanos - mLastNanos) / 1_000_000_000f;
+                if (dtReal < 0f) dtReal = 0f;
+                if (dtReal > 0.05f) dtReal = 0.05f;
+            }
+            mLastNanos = frameTimeNanos;
+            float dt = dtReal / mScale;
+            mSim += dt;
+            step(dt);
+            if (mDiscarded || mSheetSpring != this) return;
+            applyProgress(shown());
+            if (mDiscarded || mSheetSpring != this) return;
+            if (atRest() || mSim > 4f) {
+                end();
+                return;
+            }
+            postFrame();
+        }
+
+        private void postFrame() {
+            try {
+                Choreographer.getInstance().postFrameCallback(this);
+            } catch (RuntimeException ex) {
+                // Unit tests step the spring themselves.
+            }
+        }
+
+        private void removeFrame() {
+            try {
+                Choreographer.getInstance().removeFrameCallback(this);
+            } catch (RuntimeException ex) {
+                // No choreographer in this test.
+            }
+        }
+
+        private void clearDelay() {
+            View host = mDelayHost;
+            Runnable delayed = mDelayed;
+            ViewTreeObserver.OnPreDrawListener preDraw = mPreDraw;
+            if (host != null) {
+                if (delayed != null) host.removeCallbacks(delayed);
+                ViewTreeObserver observer = host.getViewTreeObserver();
+                if (preDraw != null && observer.isAlive()) {
+                    observer.removeOnPreDrawListener(preDraw);
+                }
+            }
+            mPreDraw = null;
+            mDelayed = null;
+        }
+    }
+
 }
