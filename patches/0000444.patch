+    @Test
+    public void testNothingBlursThePageInAnyMode() {
+        try {
+            for (boolean glass : new boolean[] {false, true}) {
+                assertBlurStaysOff(glass, BareTabsStyle.DRAWER, false, "drawer");
+                assertBlurStaysOff(glass, BareTabsStyle.SHEET, false, "bottom");
+                assertBlurStaysOff(glass, BareTabsStyle.SHEET, true, "top");
+            }
+        } finally {
+            setAddressBarOnTop(false);
+            BareTabsStyle.setStyle(BareTabsStyle.DRAWER);
+            BareVerticalTabsDrawer.setGlassForTesting(false);
+            if (mDrawer.isOpen()) {
+                mDrawer.close();
+                mDrawer.finishAnimationForTesting();
+            }
+            mDrawer.destroy();
+        }
+    }
+
+    private void assertBlurStaysOff(
+            boolean glass, String style, boolean addressOnTop, String mode) {
+        if (mDrawer.isOpen()) {
+            mDrawer.close();
+            mDrawer.finishAnimationForTesting();
+        }
+        BareVerticalTabsDrawer.setGlassForTesting(glass);
+        BareTabsStyle.setStyle(style);
+        setAddressBarOnTop(addressOnTop);
+        mDrawer.open();
+        mDrawer.finishAnimationForTesting();
+        assertEquals(mode + " open glass=" + glass, 0, mDrawer.blurRadiusForTesting());
+        if (glass) {
+            Dialog dialog = mDrawer.glassWindowForTesting();
+            assertNotNull(dialog);
+            assertEquals(
+                    0,
+                    dialog.getWindow().getAttributes().flags
+                            & WindowManager.LayoutParams.FLAG_BLUR_BEHIND);
+        }
+        mDrawer.close();
+        mDrawer.finishAnimationForTesting();
+        assertEquals(mode + " closed glass=" + glass, 0, mDrawer.blurRadiusForTesting());
+    }
