+    /** Copies the status-bar strip and reads the pixels under the clock and the system icons. */
+    private void scheduleStatusBarSample() {
+        if (!mPageCardArmed || mStatusBarSampleInFlight) return;
+        long now = SystemClock.uptimeMillis();
+        if (mStatusBarSampledDim >= 0f
+                && Math.abs(mPageDim - mStatusBarSampledDim) < 0.03f
+                && now - mStatusBarSampleAtMs < 100) {
+            return;
+        }
+        Window window = mActivity.getWindow();
+        View decor = window.getDecorView();
+        int width = decor.getWidth();
+        int bar = statusBarSampleHeight();
+        if (width <= 0 || bar <= 0) return;
+        Bitmap bitmap = mStatusBarSampleBitmap;
+        if (bitmap == null || bitmap.getWidth() != width || bitmap.getHeight() != bar) {
+            if (bitmap != null) bitmap.recycle();
+            bitmap = Bitmap.createBitmap(width, bar, Bitmap.Config.ARGB_8888);
+            mStatusBarSampleBitmap = bitmap;
+        }
+        int gen = ++mStatusBarSampleGen;
+        mStatusBarSampleInFlight = true;
+        Bitmap target = bitmap;
+        try {
+            PixelCopy.request(
+                    window,
+                    new Rect(0, 0, width, bar),
+                    target,
+                    result -> {
+                        mStatusBarSampleInFlight = false;
+                        mStatusBarSampleAtMs = SystemClock.uptimeMillis();
+                        mStatusBarSampledDim = mPageDim;
+                        if (gen != mStatusBarSampleGen
+                                || !mPageCardArmed
+                                || result != PixelCopy.SUCCESS) {
+                            return;
+                        }
+                        float luminance = iconStripLuminance(target);
+                        // An empty copy is not a dark page. Wait for pixels.
+                        if (luminance < 0f) return;
+                        applyStatusBarIconsForLuminance(luminance);
+                    },
+                    new Handler(Looper.getMainLooper()));
+        } catch (RuntimeException ignored) {
+            // No surface yet: unit tests, or the first frame. The next pre-draw tries
+            // again. Icons stay as they were until a sample lands.
+            mStatusBarSampleInFlight = false;
+        }
+    }
+
+    private void recycleStatusBarSample() {
+        mStatusBarSampleGen++;
+        mStatusBarSampleInFlight = false;
+        Bitmap bitmap = mStatusBarSampleBitmap;
+        mStatusBarSampleBitmap = null;
+        if (bitmap != null) bitmap.recycle();
+    }
+
+    /** Status-bar strip. A zero inset still samples the top of the window. */
+    private int statusBarSampleHeight() {
+        int bar = mTopInset > 0 ? mTopInset : systemDimension("status_bar_height");
+        if (bar <= 0) bar = dp(24);
+        View decor = mActivity.getWindow().getDecorView();
+        if (decor.getHeight() > 0) bar = Math.min(bar, decor.getHeight());
+        return Math.max(bar, 1);
+    }
+
+    /**
+     * Luminance under the clock and under the system icons. The corner cutouts sit outside
+     * those clusters. The darker cluster wins, so one dark end still switches to light icons.
+     */
+    private float iconStripLuminance(Bitmap bitmap) {
+        int width = bitmap.getWidth();
+        int height = bitmap.getHeight();
+        if (width <= 0 || height <= 0) return 1f;
+        int edge = Math.min(dp(12), Math.max(width / 4, 0));
+        int leftEnd = Math.max(edge + 1, width * 2 / 5);
+        int rightStart = Math.min(width - edge - 1, width * 3 / 5);
+        float left = regionLuminance(bitmap, edge, leftEnd, 0, height);
+        float right = regionLuminance(bitmap, rightStart, width - edge, 0, height);
+        if (left < 0f) return right;
+        if (right < 0f) return left;
+        return Math.min(left, right);
+    }
+
+    /** Negative when the strip has no opaque pixel yet. */
+    private float regionLuminance(Bitmap bitmap, int left, int right, int top, int bottom) {
+        if (right <= left || bottom <= top) return -1f;
+        long sum = 0;
+        int count = 0;
+        int stepX = Math.max(1, (right - left) / 24);
+        int stepY = Math.max(1, (bottom - top) / 8);
+        for (int y = top; y < bottom; y += stepY) {
+            for (int x = left; x < right; x += stepX) {
+                int pixel = bitmap.getPixel(x, y);
+                if (Color.alpha(pixel) < 16) continue;
+                sum += Math.round(ColorUtils.calculateLuminance(pixel) * 1000f);
+                count++;
+            }
+        }
+        if (count == 0) return -1f;
+        return (sum / (float) count) / 1000f;
+    }
