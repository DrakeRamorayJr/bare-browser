+    /**
+     * Light icons when the sampled strip is dark. A band around 0.5 keeps one noisy frame
+     * from flipping the icons. {@link ColorUtils#calculateLuminance} is Android's region
+     * sample (0 black, 1 white).
+     */
+    private void applyStatusBarIconsForLuminance(float luminance) {
+        boolean wantLight;
+        if (!mStatusBarIconLatched) {
+            wantLight = luminance < 0.5f;
+        } else if (mStatusBarWantLightIcons) {
+            wantLight = luminance < 0.58f;
+        } else {
+            wantLight = luminance < 0.42f;
+        }
+        mStatusBarIconLatched = true;
+        mStatusBarWantLightIcons = wantLight;
+        Window window = mActivity.getWindow();
+        applyLatchedStatusBarIcons(
+                new WindowInsetsControllerCompat(window, window.getDecorView()));
+    }
