+    /** Puts the latched icon appearance back if the status-bar controller replaced it. */
+    private void applyLatchedStatusBarIcons(WindowInsetsControllerCompat controller) {
+        if (!mStatusBarIconLatched) return;
+        boolean wantAppearanceLight = !mStatusBarWantLightIcons;
+        if (controller.isAppearanceLightStatusBars() != wantAppearanceLight) {
+            controller.setAppearanceLightStatusBars(wantAppearanceLight);
+        }
+    }
