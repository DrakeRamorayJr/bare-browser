+    /**
+     * While a bottom-bar sheet is open, the five-button bar uses the sheet surface so the
+     * two read as one. The saved fill is put back as the sheet closes. Driven by the sheet's
+     * progress, so the change tracks the open and the close. Top-bar sheets and the side
+     * drawer leave the bar alone.
+     */
+    private void applyToolbarSurface() {
+        View bar = bottomButtonBar();
+        if (bar == null || !isSheetChrome() || sheetFromTop() || mProgress <= 0.001f) {
+            restoreToolbarSurface();
+            return;
+        }
+        if (!mToolbarSurfaceHeld) {
+            Drawable background = bar.getBackground();
+            if (background != null && background.getConstantState() != null) {
+                mHeldToolbarBackground = background.getConstantState().newDrawable().mutate();
+            } else {
+                mHeldToolbarBackground = background;
+            }
+            mHeldToolbarColor =
+                    background instanceof ColorDrawable color
+                            ? color.getColor()
+                            : sheetJoinedSurfaceColor();
+            mToolbarSurfaceHeld = true;
+        }
+        float opened = BareTabSheetSnap.HALF_RATIO;
+        float t = opened <= 0f ? 1f : Math.min(1f, mProgress / opened);
+        int blended = blendColor(mHeldToolbarColor, sheetJoinedSurfaceColor(), t);
+        Drawable current = bar.getBackground();
+        if (!(current instanceof ColorDrawable color) || color.getColor() != blended) {
+            bar.setBackgroundColor(blended);
+        }
+    }
+
+    private void restoreToolbarSurface() {
+        if (!mToolbarSurfaceHeld) return;
+        View bar = bottomButtonBar();
+        if (bar != null) bar.setBackground(mHeldToolbarBackground);
+        mHeldToolbarBackground = null;
+        mToolbarSurfaceHeld = false;
+    }
+
+    private @Nullable View bottomButtonBar() {
+        return mActivity.findViewById(
+                org.chromium.chrome.browser.ui.bottombar.R.id.bottom_bar_container);
+    }
+
+    static int bottomBarIdForTesting() {
+        return org.chromium.chrome.browser.ui.bottombar.R.id.bottom_bar_container;
+    }
+
+    @Nullable View seamFillForTesting() {
+        return mSeamFill;
+    }
+
+    /** Fills the gap under a bottom-bar sheet with the sheet surface. */
+    private void applySeamFill() {
+        View fill = mSeamFill;
+        if (fill == null) return;
+        boolean show = isSheetChrome() && !sheetFromTop() && mProgress > 0.001f;
+        int seam = show ? sheetBottomSeam() : 0;
+        if (seam <= 0) {
+            if (fill.getVisibility() != View.GONE) fill.setVisibility(View.GONE);
+            return;
+        }
+        int color = sheetJoinedSurfaceColor();
+        Drawable background = fill.getBackground();
+        if (!(background instanceof ColorDrawable paint) || paint.getColor() != color) {
+            fill.setBackgroundColor(color);
+        }
+        int width = ViewGroup.LayoutParams.MATCH_PARENT;
+        Panel panel = mPanel;
+        if (panel != null
+                && panel.getLayoutParams() instanceof FrameLayout.LayoutParams panelParams
+                && panelParams.width > 0) {
+            width = panelParams.width;
+        }
+        int gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL;
+        if (fill.getLayoutParams() instanceof FrameLayout.LayoutParams params
+                && (params.height != seam || params.width != width || params.gravity != gravity)) {
+            params.width = width;
+            params.height = seam;
+            params.gravity = gravity;
+            fill.setLayoutParams(params);
+        }
+        if (fill.getVisibility() != View.VISIBLE) fill.setVisibility(View.VISIBLE);
+    }
