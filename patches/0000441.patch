+    @Test
+    public void testTheBottomToolbarMatchesTheSheetWhileItIsOpen() {
+        View bar = new View(mActivity);
+        bar.setId(BareVerticalTabsDrawer.bottomBarIdForTesting());
+        bar.setBackgroundColor(0xFF123456);
+        content().addView(bar, new FrameLayout.LayoutParams(px(400), px(56), Gravity.BOTTOM));
+
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        try {
+            for (boolean night : new boolean[] {false, true}) {
+                setNightMode(night);
+                for (boolean glass : new boolean[] {false, true}) {
+                    if (mDrawer.isOpen()) {
+                        mDrawer.close();
+                        mDrawer.finishAnimationForTesting();
+                    }
+                    BareVerticalTabsDrawer.setGlassForTesting(glass);
+                    mDrawer.open();
+                    mDrawer.finishAnimationForTesting();
+                    // Opaque RGB. A glass tint would show the page through the bar.
+                    int expected = night ? 0xFF1C1A20 : 0xFFF1EDF6;
+                    assertEquals(
+                            "night=" + night + " glass=" + glass,
+                            expected,
+                            drawableColor(bar.getBackground()));
+                    View fill = mDrawer.seamFillForTesting();
+                    assertNotNull(fill);
+                    assertEquals(View.VISIBLE, fill.getVisibility());
+                    assertEquals(expected, drawableColor(fill.getBackground()));
+                    assertEquals(
+                            px(12), ((FrameLayout.LayoutParams) fill.getLayoutParams()).height);
+                    mDrawer.close();
+                    mDrawer.finishAnimationForTesting();
+                    assertEquals(
+                            "restored night=" + night + " glass=" + glass,
+                            0xFF123456,
+                            drawableColor(bar.getBackground()));
+                    assertEquals(View.GONE, fill.getVisibility());
+                }
+            }
+
+            setNightMode(false);
+            BareVerticalTabsDrawer.setGlassForTesting(false);
+            setAddressBarOnTop(true);
+            mDrawer.open();
+            mDrawer.finishAnimationForTesting();
+            assertEquals(0xFF123456, drawableColor(bar.getBackground()));
+            assertEquals(View.GONE, mDrawer.seamFillForTesting().getVisibility());
+            mDrawer.close();
+            mDrawer.finishAnimationForTesting();
+
+            BareTabsStyle.setStyle(BareTabsStyle.DRAWER);
+            mDrawer.open();
+            mDrawer.finishAnimationForTesting();
+            assertEquals(0xFF123456, drawableColor(bar.getBackground()));
+            assertEquals(View.GONE, mDrawer.seamFillForTesting().getVisibility());
+        } finally {
