+    @Test
+    public void testActionButtonsClearTheToolbarByAtLeastEightDp() {
+        setAddressBarOnTop(false);
+        LinearLayout panel = openSheetLaidOut(px(400), px(800));
+        View root = (View) panel.getParent();
+        String[] tags =
+                new String[] {
+                    "sheet_list", "sheet_grid", "sheet_new", "sheet_close_all", "sheet_search"
+                };
+        for (String tag : tags) {
+            View button = findTag(tag);
+            assertNotNull(button);
+            assertTrue(tag + " touch height " + button.getHeight(), button.getHeight() >= px(48));
+            assertTrue(tag + " touch width " + button.getWidth(), button.getWidth() >= px(48));
+            int gap = root.getHeight() - bottomInAncestor(button, root);
+            assertTrue(tag + " gap " + gap, gap >= px(8));
+            // No delegate may reach into the toolbar past the button's own bottom.
+            assertTrue(button.getTouchDelegate() == null);
+        }
+    }
+
+    /** The view's bottom in {@code ancestor}'s coordinates. */
+    private static int bottomInAncestor(View view, View ancestor) {
+        int bottom = view.getHeight();
+        View current = view;
+        while (current != ancestor) {
+            bottom += current.getTop();
+            if (!(current.getParent() instanceof View parent)) break;
+            current = parent;
+        }
+        return bottom;
+    }
