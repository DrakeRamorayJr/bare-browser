+    /**
+     * Draws the real url view as one bitmap over the real one, in place of the pill's own text.
+     * That text is laid out again from the string, and a different width, end, ellipsis, fade
+     * or scroll puts glyphs a pixel or two off the real ones, and the two read as a doubled
+     * word while they cross-fade. A bitmap of the real view is the real layout. Only a
+     * hand-off that read the live bar does this, so it is bound by the same tolerance. The
+     * pill's text stays as the fallback when no copy could be made.
+     */
+    private void syncMorphUrlSnapshot(boolean live, float pillLeft, float pillTop) {
+        FrameLayout root = mRoot;
+        TextView real = live ? liveBarText() : null;
+        if (root == null || real == null) {
+            hideMorphUrlSnapshot();
+            return;
+        }
+        ImageView ghost = urlSnapshotView();
+        if (!drawViewSnapshot(
+                ghost,
+                real,
+                dp(URL_SNAPSHOT_MAX_WIDTH_DP),
+                dp(URL_SNAPSHOT_MAX_HEIGHT_DP))) {
+            hideMorphUrlSnapshot();
+            return;
+        }
+        int[] at = new int[2];
+        real.getLocationOnScreen(at);
+        float x = pillLeft + (at[0] - mBarOnScreen[0]);
+        float y = pillTop + (at[1] - mBarOnScreen[1]);
+        placeMorphFloat(ghost, root, real.getWidth(), real.getHeight(), x, y, morphHandoffAlpha());
+        if (ghost.getParent() != root) {
+            hideMorphUrlSnapshot();
+            return;
+        }
+        TextView origin = mPillOrigin;
+        if (origin != null && origin.getAlpha() != 0f) origin.setAlpha(0f);
+        TextView from = mMorphFromText;
+        if (from != null && from.getAlpha() != 0f) from.setAlpha(0f);
+        mUrlSnapshotCoversText = true;
+    }
