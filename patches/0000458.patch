+    /** Records the clip the url view is drawn under, which is where its scroll shows. */
+    private static final class RecordingText extends TextView {
+        android.graphics.Rect mClipSeen;
+
+        RecordingText(android.content.Context context) {
+            super(context);
+        }
+
+        @Override
+        public void draw(android.graphics.Canvas canvas) {
+            mClipSeen = canvas.getClipBounds();
+            super.draw(canvas);
+        }
+    }
+
+    /** Parks a close on a bar whose url is longer than the bar, inset and spaced. */
+    private void parkOnALongUrlBar(TextView bar, android.widget.ImageView shield) {
+        bar.setText("https://en.wikipedia.org/wiki/Android_(operating_system)#History_and_development");
+        bar.setSingleLine(true);
+        bar.setEllipsize(TextUtils.TruncateAt.END);
+        bar.setPadding(px(18), px(9), px(30), px(1));
+        bar.setLetterSpacing(0.03f);
+        parkTheCloseMorph(bar, shield);
+    }
+
+    private static void clipToACircle(View view) {
+        view.setOutlineProvider(
+                new ViewOutlineProvider() {
+                    @Override
+                    public void getOutline(View v, Outline outline) {
+                        outline.setOval(0, 0, v.getWidth(), v.getHeight());
+                    }
+                });
+        view.setClipToOutline(true);
+    }
+
+    /** The copy clips to a circle as big as itself, and casts no shadow in that shape. */
+    private static void assertClipsToACircle(android.widget.ImageView ghost) {
+        assertTrue(ghost.getClipToOutline());
+        int size = ghost.getLayoutParams().width;
+        assertTrue(size > 0);
+        assertEquals(size, ghost.getLayoutParams().height);
+        ghost.layout(0, 0, size, size);
+        Outline outline = new Outline();
+        ghost.getOutlineProvider().getOutline(ghost, outline);
+        assertFalse(outline.isEmpty());
+        assertTrue(outline.canClip());
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            android.graphics.Rect rect = new android.graphics.Rect();
+            assertTrue(outline.getRect(rect));
+            assertEquals(size, rect.width());
+            assertEquals(size, rect.height());
+            assertEquals(size / 2f, outline.getRadius(), 0.5f);
+            assertEquals(0f, outline.getAlpha(), 0.001f);
+        }
+    }
