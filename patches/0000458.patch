+    /**
+     * Takes the url bitmap down. A layout frame that does this has already given the pill's
+     * text its alphas back, because applyMorphText runs before it every frame. A teardown with
+     * no frame of its own has to do that itself, see {@link #clearMorphFloats}.
+     */
+    private void hideMorphUrlSnapshot() {
+        mUrlSnapshotCoversText = false;
+        ImageView ghost = mMorphUrlSnapshot;
+        if (ghost == null || ghost.getVisibility() == View.GONE) return;
+        if (ghost.getAlpha() != 0f) ghost.setAlpha(0f);
+        ghost.setVisibility(View.GONE);
+        GhostSnapshot held = mGhostSnapshots.remove(ghost);
+        if (held != null && ghost.getDrawable() == held.mDrawable) ghost.setImageDrawable(null);
+    }
