+    /**
+     * The outline a hand-off copy clips to. A view that clips to its outline is cut to it only
+     * by the compositor, so a bitmap drawn from that view keeps the corners the clip removes
+     * and the copy has to clip again. The real view's own provider is asked, on the copy, so
+     * the shape is whatever the real one is. The outline carries no alpha: a copy that is up
+     * on the morph's elevation would otherwise cast a shadow in that shape.
+     */
+    private static final class GhostClip extends ViewOutlineProvider {
+        @Nullable ViewOutlineProvider mReal;
+
+        @Override
+        public void getOutline(View view, Outline outline) {
+            if (mReal != null) {
+                mReal.getOutline(view, outline);
+                // An empty outline clips everything away. The provider of a view that is
+                // clipped by its background has nothing to give a copy that has none.
+                if (outline.isEmpty()) outline.setRect(0, 0, view.getWidth(), view.getHeight());
+            }
+            outline.setAlpha(0f);
+        }
+    }
