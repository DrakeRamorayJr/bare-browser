+    /**
+     * Clips the copy the way the real view is clipped. Only a view whose clip the platform
+     * would apply is mirrored: one that clips to an outline it can clip to. Every frame sets
+     * it, so a copy that moves on to another icon does not keep the last one's shape.
+     */
+    private void matchGhostClip(ImageView ghost, View source) {
+        if (!(ghost.getOutlineProvider() instanceof GhostClip clip)) return;
+        ViewOutlineProvider real = source.getClipToOutline() ? source.getOutlineProvider() : null;
+        if (real != null) {
+            Outline probe = mGhostClipProbe;
+            probe.setEmpty();
+            real.getOutline(source, probe);
+            if (probe.isEmpty() || !probe.canClip()) real = null;
+        }
+        if (clip.mReal != real) {
+            clip.mReal = real;
+            ghost.invalidateOutline();
+        }
+        boolean clips = real != null;
+        if (ghost.getClipToOutline() != clips) ghost.setClipToOutline(clips);
+    }
