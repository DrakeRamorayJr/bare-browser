+    private void onSafetyWindowFocus(boolean hasFocus) {
+        if (sWindowFocusedForTesting != null) hasFocus = sWindowFocusedForTesting;
+        if (hasFocus) return;
+        if (!sheetWindowPresent()) restorePageCard();
+    }
+
+    /** Same check the window-focus listener runs. Tests call it without a real focus event. */
+    void noteWindowFocusForTesting(boolean hasFocus) {
+        onSafetyWindowFocus(hasFocus);
+    }
