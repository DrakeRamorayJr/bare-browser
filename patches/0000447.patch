     /** Bounds the sheet's glass window to the content between the toolbars. */
     private void placeSheetGlassWindow(int top, int bottom) {
+        Dialog window = mGlassWindow;
+        Window w = window != null ? window.getWindow() : null;
+        View content = mActivity.findViewById(android.R.id.content);
+        if (w == null || content == null) return;
+        // This runs from a global-layout listener. Measuring during that traversal
+        // schedules another traversal, and Robolectric never finishes idling it.
+        if (content.isInLayout()) {
+            if (mGlassPlacePosted) return;
+            mGlassPlacePosted = true;
+            int topNow = top;
+            int bottomNow = bottom;
+            content.post(
+                    () -> {
+                        mGlassPlacePosted = false;
+                        placeSheetGlassWindowPosted(topNow, bottomNow);
+                    });
+            return;
+        }
+        placeSheetGlassWindowPosted(top, bottom);
+    }
