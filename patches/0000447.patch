+    private void registerHostCallbacks() {
+        if (mHostCallbacksRegistered) return;
+        if (sCallbackOwner != null && sCallbackOwner != this) {
+            sCallbackOwner.unregisterHostCallbacks();
+        }
+        sCallbackOwner = this;
+        mActivityCallbacks =
+                new Application.ActivityLifecycleCallbacks() {
+                    @Override
+                    public void onActivityCreated(Activity activity, @Nullable Bundle state) {}
+
+                    @Override
+                    public void onActivityStarted(Activity activity) {}
+
+                    @Override
+                    public void onActivityResumed(Activity activity) {
+                        if (activity != mActivity) return;
+                        mActivityObscured = false;
+                        if (mRoot == null) return;
+                        onSheetHostChanged();
+                    }
+
+                    @Override
+                    public void onActivityPaused(Activity activity) {
+                        if (activity != mActivity) return;
+                        mActivityObscured = true;
+                        // Night mode recreates the activity. Rotation does not. Drop the sheet
+                        // window first so its dialog is not still attached while tabs reparent.
+                        if (activity.isChangingConfigurations()) releaseSheetWindowForRecreation();
+                        restorePageCard();
+                    }
+
+                    @Override
+                    public void onActivityStopped(Activity activity) {
+                        if (activity != mActivity) return;
+                        mActivityObscured = true;
+                        restorePageCard();
+                    }
+
+                    @Override
+                    public void onActivitySaveInstanceState(Activity activity, Bundle outState) {}
+
+                    @Override
+                    public void onActivityDestroyed(Activity activity) {
+                        if (activity != mActivity) return;
+                        mActivityObscured = true;
+                        restorePageCard();
+                    }
+                };
+        mComponentCallbacks =
+                new ComponentCallbacks() {
+                    @Override
+                    public void onConfigurationChanged(Configuration newConfig) {
+                        onSheetHostChanged();
+                    }
+
+                    @Override
+                    public void onLowMemory() {}
+                };
+        Application app = mActivity.getApplication();
+        if (app != null) app.registerActivityLifecycleCallbacks(mActivityCallbacks);
+        mActivity.registerComponentCallbacks(mComponentCallbacks);
+        View decor = mActivity.getWindow() == null ? null : mActivity.getWindow().getDecorView();
+        if (decor != null) {
+            ViewTreeObserver observer = decor.getViewTreeObserver();
+            if (observer.isAlive()) {
+                observer.addOnGlobalLayoutListener(mSafetyLayoutListener);
+                observer.addOnWindowFocusChangeListener(mSafetyFocusListener);
+            }
+        }
+        mHostCallbacksRegistered = true;
+    }
+
+    private void unregisterHostCallbacks() {
+        if (!mHostCallbacksRegistered) return;
+        mHostCallbacksRegistered = false;
+        if (sCallbackOwner == this) sCallbackOwner = null;
+        Application app = mActivity.getApplication();
+        if (app != null && mActivityCallbacks != null) {
+            app.unregisterActivityLifecycleCallbacks(mActivityCallbacks);
+        }
+        if (mComponentCallbacks != null) mActivity.unregisterComponentCallbacks(mComponentCallbacks);
+        View decor = mActivity.getWindow() == null ? null : mActivity.getWindow().getDecorView();
+        if (decor != null) {
+            ViewTreeObserver observer = decor.getViewTreeObserver();
+            if (observer.isAlive()) {
+                observer.removeOnGlobalLayoutListener(mSafetyLayoutListener);
+                observer.removeOnWindowFocusChangeListener(mSafetyFocusListener);
+            }
+        }
     }
 
