+    private boolean pageCardVisuallyOn() {
+        if (mPageCardArmed || mUrlBarBlocked) return true;
+        if (mPageShade != null
+                && mPageShade.getVisibility() == View.VISIBLE
+                && mPageShade.getAlpha() > 0f) {
+            return true;
+        }
+        if (mPageBackdrop != null
+                && mPageBackdrop.getVisibility() == View.VISIBLE
+                && mPageBackdrop.getAlpha() > 0f) {
+            return true;
+        }
+        View page = mActivity.findViewById(R.id.compositor_view_holder);
+        return page != null
+                && (page.getScaleX() < 0.999f
+                        || page.getScaleY() < 0.999f
+                        || page.getClipToOutline());
+    }
