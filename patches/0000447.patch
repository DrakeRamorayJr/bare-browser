+    /**
+     * One restore for every way the sheet leaves. Scale, clip, scrim, backdrop, shade,
+     * status-bar colour, icon appearance, and the address-bar focus block all go back.
+     */
+    private void restoreSheetChrome() {
+        if (mRestoringSheet) return;
+        mRestoringSheet = true;
+        try {
+            View page = mActivity.findViewById(R.id.compositor_view_holder);
+            if (page != null) {
+                page.setPivotX(page.getWidth() * 0.5f);
+                page.setPivotY(page.getHeight() * 0.5f);
+                page.setScaleX(1f);
+                page.setScaleY(1f);
+                page.setClipToOutline(false);
+                page.setOutlineProvider(ViewOutlineProvider.BACKGROUND);
+            }
+            mPageTopInset = 0;
+            mPageDim = 0f;
+            mPageCardArmed = false;
+            hidePageBackdrop();
+            if (mPageShade != null) {
+                mPageShade.setAlpha(0f);
+                mPageShade.setVisibility(View.GONE);
+            }
+            disarmStatusBarGuard();
+            applyStatusBarForPageCard(false, 0f);
+            if (!pageCardWanted()) clearPageCardScrim();
+            releaseUrlBarFocusGuard();
+        } finally {
+            mRestoringSheet = false;
+        }
+    }
+
+    /** Drops the bottom-sheet dim. The drawer and the top sheet keep their own scrim. */
+    private void clearPageCardScrim() {
+        if (!isSheetChrome() || sheetFromTop()) return;
+        View scrim = mScrim;
+        if (scrim == null) return;
+        scrim.setAlpha(0f);
+        placeSheetScrim(scrim, false);
+    }
+
+    /** The glass dialog went away without a finished close animation. */
+    private void onSheetWindowDismissed() {
+        if (mRehosting || mHandlingDismiss) return;
+        if (!mOpen && mProgress <= 0.001f) {
+            restorePageCard();
+            return;
+        }
+        mHandlingDismiss = true;
+        try {
+            mOpen = false;
+            mProgress = 0f;
+            if (mAnimator != null) mAnimator.cancel();
+            watchFocus(false);
+            watchDialogLayout(false);
+            clearSearch();
+            if (mBackCallback != null) mBackCallback.setEnabled(false);
+            FrameLayout root = mRoot;
+            if (root != null && root.getVisibility() != View.GONE) root.setVisibility(View.GONE);
+            setBackProgress(0f);
+            mSettledState = null;
+            mImeLift = 0;
+            mImeCover = 0;
+            mLatchedImeTop = -1;
+            restoreSheetChrome();
+            releaseObservers();
+        } finally {
+            mHandlingDismiss = false;
+        }
+    }
+
+    /** Tabs style or address-bar side changed while the views still exist. */
+    private void applyChromeIfModeChanged() {
+        boolean sheet = isSheetChrome();
+        boolean fromTop = sheetFromTop();
+        if (!mChromeModeKnown) {
+            mChromeModeKnown = true;
+            mLastWasSheet = sheet;
+            mLastFromTop = fromTop;
+            return;
+        }
+        if (sheet == mLastWasSheet && fromTop == mLastFromTop) return;
+        mLastWasSheet = sheet;
+        mLastFromTop = fromTop;
+        if (mRoot == null) return;
+        applyChrome();
+        applyProgress(mProgress);
+    }
+
+    /** Layout, focus, pause, or a configuration change. Re-applies only if the sheet is up. */
+    private void onSheetHostChanged() {
+        if (mRestoringSheet) return;
+        applyChromeIfModeChanged();
+        if (pageCardWanted()) {
+            // Already drawing the card. Applying again from a layout pass schedules
+            // another pass, and the test looper never goes idle.
+            if (!pageCardVisuallyOn()) applyProgress(mProgress);
+            return;
+        }
+        restorePageCard();
+    }
+
+    private void onSafetyLayout() {
+        if (mRestoringSheet || mInWindowLayout) return;
+        mInWindowLayout = true;
+        try {
+            onSheetHostChanged();
+        } finally {
+            mInWindowLayout = false;
+        }
+    }
