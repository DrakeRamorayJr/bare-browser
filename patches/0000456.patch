+    /** 1 while the parked morph is opaque, falling to 0 as it fades over the revealed bar. */
+    private float morphHandoffAlpha() {
+        if (!mCloseReveal) return 1f;
+        return 1f - morphEase(mHandoffFade);
+    }
+
+    /**
+     * The cover only has to hide the bar for the first frames. It clears sooner than the
+     * pill, so the real icons and glyphs are visible under the fading pill.
+     */
+    private float coverHandoffAlpha() {
+        if (!mCloseReveal) return 1f;
+        return 1f - morphEase(unitRange(mHandoffFade / COVER_HANDOFF_SHARE));
+    }
+
+    private void startHandoffFade() {
+        float scale = animatorDurationScale();
+        long duration = Math.round(CLOSE_HANDOFF_FADE_MS * (scale > 0f ? scale : 1f));
+        mHandoffFade = 0f;
+        mHandoffStartMs = SystemClock.uptimeMillis();
+        mHandoffDurationMs = Math.max(1L, duration);
+        mHandoffFrames = 0;
+        // A frame is at least 8 ms. A clock that does not advance still ends the fade.
+        mHandoffMaxFrames = (int) (mHandoffDurationMs / 8L) + 4;
+        postHandoffFade();
+    }
+
+    private void stepHandoffFade() {
+        mHandoffFadePosted = false;
+        if (!mCloseReveal) return;
+        if (mOpen || mProgress > 0.001f) {
+            // Opened again mid-fade. The commit path resets the park flags.
+            commitCloseHandoff();
+            return;
+        }
+        mHandoffFrames++;
+        float elapsed = SystemClock.uptimeMillis() - mHandoffStartMs;
+        float fade = elapsed / (float) mHandoffDurationMs;
+        if (mHandoffFrames >= mHandoffMaxFrames) fade = 1f;
+        if (fade >= 1f) {
+            // Pill, icon copies and cover are clear now. Remove them and hand over.
+            commitCloseHandoff();
+            return;
+        }
+        mHandoffFade = Math.max(0f, fade);
+        layoutOriginPill();
+        postHandoffFade();
+    }
+
+    private void postHandoffFade() {
+        if (mHandoffFadePosted) return;
+        mHandoffFadePosted = true;
+        View host = handoffHost();
+        host.removeCallbacks(mHandoffFadeStep);
+        host.postOnAnimation(mHandoffFadeStep);
+    }
+
+    private void cancelHandoffFade() {
+        if (mHandoffFadePosted) {
+            handoffHost().removeCallbacks(mHandoffFadeStep);
+            mHandoffFadePosted = false;
+        }
+        mHandoffFade = 0f;
+    }
