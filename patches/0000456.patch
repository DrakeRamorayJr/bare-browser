+    /**
+     * Pulls a bottom-bar sheet up from a bar with a trailing icon on it, closes it, and stops
+     * with the morph parked on the bar. Nothing of the hand-off has run yet.
+     */
+    private void parkTheCloseMorph(TextView bar, android.widget.ImageView shield) {
+        bar.setId(org.chromium.chrome.R.id.location_bar);
+        bar.setText("https://example.com/");
+        GradientDrawable barBackground = new GradientDrawable();
+        barBackground.setColor(0xFF123456);
+        barBackground.setCornerRadius(px(12));
+        bar.setBackground(barBackground);
+        content().addView(bar, new FrameLayout.LayoutParams(px(280), px(48), Gravity.BOTTOM));
+        shield.setImageDrawable(new ColorDrawable(0xFFFF0000));
+        content().addView(shield, new FrameLayout.LayoutParams(px(24), px(24), Gravity.BOTTOM));
+        Runnable placeShield =
+                () ->
+                        shield.layout(
+                                bar.getLeft() + bar.getWidth() - px(32),
+                                bar.getTop() + px(12),
+                                bar.getLeft() + bar.getWidth() - px(8),
+                                bar.getTop() + px(36));
+
+        mDrawer.beginToolbarPull();
+        View root = (View) findTag("sheet_actions").getParent().getParent();
+        content().measure(
+                View.MeasureSpec.makeMeasureSpec(px(400), View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(px(800), View.MeasureSpec.EXACTLY));
+        content().layout(0, 0, px(400), px(800));
+        layoutOverlay(root, px(400), px(800));
+        placeShield.run();
+        int range = root.getHeight() - sheetGap();
+        mDrawer.updateToolbarPull(range * 0.2f);
+        content().layout(0, 0, px(400), px(800));
+        layoutOverlay(root, px(400), px(800));
+        placeShield.run();
+        mDrawer.updateToolbarPull(range * 0.2f);
+        mDrawer.endToolbarPull(0f);
+
+        mDrawer.close();
+        mDrawer.endAnimationForTesting();
+    }
+
+    @Test
+    public void testCloseFadesTheParkedMorphOverTheRevealedBarBeforeRemovingIt() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        TextView bar = new TextView(mActivity);
+        android.widget.ImageView shield = new android.widget.ImageView(mActivity);
+        parkTheCloseMorph(bar, shield);
+        View pill = originPill();
+        View cover = findTag("sheet_bottom_bar_cover");
+        View ghost = findTag("morph_extra_icon");
+        assertNotNull(cover);
+        assertNotNull(ghost);
+
+        // Parked: the morph is opaque on the bar. The real bar and its icon are hidden.
+        assertEquals(View.VISIBLE, pill.getVisibility());
+        assertEquals(1f, pill.getAlpha(), 0.001f);
+        assertEquals(View.INVISIBLE, bar.getVisibility());
+        assertEquals(0f, shield.getAlpha(), 0.001f);
+
+        // Reveal: the real bar and icon are back in their final layout under the opaque morph.
+        mDrawer.revealCloseHandoffForTesting();
+        assertEquals(View.VISIBLE, bar.getVisibility());
+        assertEquals(1f, bar.getAlpha(), 0.001f);
+        assertEquals(1f, shield.getAlpha(), 0.001f);
+        assertEquals(View.VISIBLE, pill.getVisibility());
+        assertEquals(1f, pill.getAlpha(), 0.001f);
+        assertEquals(1f, cover.getAlpha(), 0.001f);
+        assertTrue(ghost.getAlpha() > 0.99f);
+
+        // The morph, its icon copy and the cover clear over the real bar. Nothing jumps.
+        mDrawer.setCloseHandoffFadeForTesting(0.25f);
+        assertTrue("pill " + pill.getAlpha(), pill.getAlpha() > 0.5f && pill.getAlpha() < 1f);
+        assertTrue("cover " + cover.getAlpha(), cover.getAlpha() > 0f && cover.getAlpha() < 1f);
+        assertTrue("ghost " + ghost.getAlpha(), ghost.getAlpha() > 0.5f && ghost.getAlpha() < 1f);
+        assertEquals(View.VISIBLE, bar.getVisibility());
+        assertEquals(1f, shield.getAlpha(), 0.001f);
+
+        mDrawer.setCloseHandoffFadeForTesting(0.5f);
+        assertEquals(0.5f, pill.getAlpha(), 0.05f);
+        assertEquals(0.5f, ghost.getAlpha(), 0.05f);
+        assertTrue(cover.getAlpha() < pill.getAlpha());
+
+        // At the end of the fade everything that is still up is clear, so removing it is not
+        // a visible step.
+        mDrawer.setCloseHandoffFadeForTesting(1f);
+        assertEquals(View.VISIBLE, pill.getVisibility());
+        assertEquals(0f, pill.getAlpha(), 0.01f);
+        assertEquals(0f, cover.getAlpha(), 0.01f);
+        assertTrue(ghost.getVisibility() != View.VISIBLE || ghost.getAlpha() < 0.01f);
+        assertEquals(1f, bar.getAlpha(), 0.001f);
+        assertEquals(1f, shield.getAlpha(), 0.001f);
+
+        mDrawer.flushCloseHandoffForTesting();
+        assertFalse(mDrawer.isOpen());
+        assertEquals(View.GONE, pill.getVisibility());
+        assertEquals(View.VISIBLE, bar.getVisibility());
+        assertEquals(1f, bar.getAlpha(), 0.001f);
+        assertEquals(1f, shield.getAlpha(), 0.001f);
+    }
