+    private static int blendNav(int from, int to, float t) {
+        float u = 1f - t;
+        return android.graphics.Color.argb(
+                Math.round(
+                        android.graphics.Color.alpha(from) * u
+                                + android.graphics.Color.alpha(to) * t),
+                Math.round(
+                        android.graphics.Color.red(from) * u + android.graphics.Color.red(to) * t),
+                Math.round(
+                        android.graphics.Color.green(from) * u
+                                + android.graphics.Color.green(to) * t),
+                Math.round(
+                        android.graphics.Color.blue(from) * u
+                                + android.graphics.Color.blue(to) * t));
+    }
