+    /**
+     * The page-card backdrop is black, and a bottom-bar sheet scales the page up off the
+     * bottom, so the backdrop shows in the gesture-nav inset. Clip that inset out. The
+     * activity window already has the sheet colour there. Clipping does not request a layout,
+     * so a draw pass cannot reschedule itself.
+     */
+    /**
+     * The gesture-nav inset is not the colour {@link #paintNavigationBar} sets. Once the
+     * page-card backdrop is clipped off that inset, the page parent's theme surface shows
+     * through (light {@code #FFFFFF}, dark {@code #131314}). Paint the parent with the sheet
+     * colour. Skip the write when the colour is already applied so a pre-draw cannot loop.
+     */
+    private void paintPageParentGap(@ColorInt int color) {
+        View page = mActivity.findViewById(R.id.compositor_view_holder);
+        if (!(page != null && page.getParent() instanceof View parent)) return;
+        if (mPageParentPainted != parent) {
+            if (mPageParentPainted != null) restorePageParentGap();
+            mHeldPageParentBackground = parent.getBackground();
+            mPageParentPainted = parent;
+            mPageParentColorSet = false;
+        }
+        if (mPageParentColorSet && mPageParentColor == color) return;
+        mPageParentColor = color;
+        mPageParentColorSet = true;
+        parent.setBackgroundColor(color);
+    }
+
+    private void restorePageParentGap() {
+        View parent = mPageParentPainted;
+        if (parent == null) return;
+        parent.setBackground(mHeldPageParentBackground);
+        mHeldPageParentBackground = null;
+        mPageParentPainted = null;
+        mPageParentColorSet = false;
+    }
+
+    private void clipBackdropOffNavInset() {
+        View backdrop = mPageBackdrop;
+        if (backdrop == null) return;
+        if (backdrop != mBackdropClipView) {
+            mBackdropClipView = backdrop;
+            mBackdropClipW = -1;
+            mBackdropClipB = -1;
+        }
+        boolean cover =
+                isSheetChrome() && !sheetFromTop() && mProgress > 0.001f && mBottomInset > 0;
+        if (!cover) {
+            if (mBackdropClipW != 0) {
+                mBackdropClipW = 0;
+                mBackdropClipB = 0;
+                backdrop.setClipBounds(null);
+            }
+            return;
+        }
+        int width = backdrop.getWidth();
+        int height = backdrop.getHeight();
+        if ((width <= 0 || height <= 0) && backdrop.getParent() instanceof View parent) {
+            if (width <= 0) width = parent.getWidth();
+            if (height <= 0) height = parent.getHeight();
+        }
+        if (width <= 0 || height <= mBottomInset) return;
+        int bottom = height - mBottomInset;
+        if (mBackdropClipW == width && mBackdropClipB == bottom) return;
+        mBackdropClipW = width;
+        mBackdropClipB = bottom;
+        backdrop.setClipBounds(new Rect(0, 0, width, bottom));
     }
 
