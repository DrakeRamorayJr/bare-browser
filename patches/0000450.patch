+    private void paintNavigationBar(Window window, @ColorInt int color, boolean iconsFollowColor) {
+        WindowManager.LayoutParams attrs = window.getAttributes();
+        int mask =
+                WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS
+                        | WindowManager.LayoutParams.FLAG_TRANSLUCENT_NAVIGATION;
+        int want =
+                (attrs.flags | WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS)
+                        & ~WindowManager.LayoutParams.FLAG_TRANSLUCENT_NAVIGATION;
+        // setFlags notifies even when the bits are unchanged, and the pre-draw guard
+        // calls this every frame. Touch the window only when a bit actually changes.
+        if ((attrs.flags & mask) != (want & mask)) window.setFlags(want, mask);
+        if (window.isNavigationBarContrastEnforced()) {
+            window.setNavigationBarContrastEnforced(false);
+        }
+        if (window.getNavigationBarColor() != color) window.setNavigationBarColor(color);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P
+                && window.getNavigationBarDividerColor() != color) {
+            window.setNavigationBarDividerColor(color);
+        }
+        if (!iconsFollowColor) return;
+        boolean lightIcons = ColorUtils.shouldUseLightForegroundOnBackground(color);
+        WindowInsetsControllerCompat controller =
+                new WindowInsetsControllerCompat(window, window.getDecorView());
+        boolean wantLightBar = !lightIcons;
+        if (controller.isAppearanceLightNavigationBars() != wantLightBar) {
+            controller.setAppearanceLightNavigationBars(wantLightBar);
+        }
+    }
