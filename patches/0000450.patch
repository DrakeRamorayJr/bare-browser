+    private static @ColorInt int opaqueDrawableColor(@Nullable Drawable drawable) {
+        if (drawable instanceof ColorDrawable color) {
+            int value = color.getColor();
+            if (Color.alpha(value) == 255) return value;
+        }
+        if (drawable instanceof GradientDrawable gradient && gradient.getColor() != null) {
+            int value = gradient.getColor().getDefaultColor();
+            if (Color.alpha(value) == 255) return value;
+        }
+        return 0;
+    }
