-    private void assertBottomCornersMatchTop(View panel) {
+    @Test
+    public void testBottomBarSheetSquaresItsBottomCornersInGlassAndNight() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        try {
+            for (boolean night : new boolean[] {false, true}) {
+                setNightMode(night);
+                for (boolean glass : new boolean[] {false, true}) {
+                    if (mDrawer.isOpen()) {
+                        mDrawer.close();
+                        mDrawer.finishAnimationForTesting();
+                    }
+                    BareVerticalTabsDrawer.setGlassForTesting(glass);
+                    mDrawer.open();
+                    mDrawer.finishAnimationForTesting();
+                    View panel = (View) sheetActions(glass).getParent();
+                    View root = (View) panel.getParent();
+                    layoutOverlay(root, px(400), px(800));
+                    layoutOverlay(root, px(400), px(800));
+                    assertBottomCornersSquare(panel);
+                    if (glass) {
+                        Dialog dialog = mDrawer.glassWindowForTesting();
+                        assertNotNull(dialog);
+                        View decor = dialog.getWindow().getDecorView();
+                        assertFalse(decor.getClipToOutline());
+                        assertEquals(ViewOutlineProvider.BOUNDS, decor.getOutlineProvider());
+                    }
+                }
+            }
+        } finally {
+            setNightMode(false);
+            BareVerticalTabsDrawer.setGlassForTesting(false);
+            if (mDrawer.isOpen()) {
