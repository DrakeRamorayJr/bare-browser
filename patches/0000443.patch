+
+    private void assertBottomCornersSquare(View panel) {
         float[] radii = ((GradientDrawable) panel.getBackground()).getCornerRadii();
         assertNotNull(radii);
         float radius = px(20);
-        for (float corner : radii) assertEquals(radius, corner, 0.6f);
+        for (int i = 0; i < 4; i++) assertEquals(radius, radii[i], 0.6f);
+        for (int i = 4; i < 8; i++) assertEquals(0f, radii[i], 0.6f);
+        assertTrue(panel.getClipToOutline());
+        assertNotEquals(ViewOutlineProvider.BACKGROUND, panel.getOutlineProvider());
+        assertTrue(panel.getWidth() > 0);
+        assertTrue(panel.getHeight() > 0);
+        Outline outline = new Outline();
+        panel.getOutlineProvider().getOutline(panel, outline);
+        // API 29 does not clip this convex path (canClip is false). The drawable
+        // radii above are the corners on that SDK. Newer SDKs clip the path.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            assertTrue(outline.canClip());
+            float outlineRadius = outline.getRadius();
+            assertTrue("outline radius " + outlineRadius, outlineRadius < 1f);
+        }
     }
 
