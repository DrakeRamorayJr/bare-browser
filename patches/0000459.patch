@@ -5243,8 +5260,11 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
         int lead = mBarTextPadStart;
         int trail = mBarTextPadEnd;
         // Parked and the first frame use the resting glyph inset. Live url bounds
-        // move once the sheet changes toolbar layout.
-        if (eased <= 0.001f && mRestTextLead >= 0) {
+        // move once the sheet changes toolbar layout. A close keeps it the whole way down:
+        // the inset of the url view itself is the glyph inset less its own padding, and
