@@ -5396,6 +5416,55 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
         }
     }
 
+    /**
+     * The same alignment for the frames before the hand-off, while the pill is still on its way
+     * down to the bar. The shift is the gap between the real glyphs, as they sit in the bar, and
+     * the pill's glyphs, as they sit in the pill, and it fades out as the pill takes the shape of
+     * the small pill. At the bar rect it is the whole alignment the hand-off makes, so the first
+     * frame of the hand-off moves nothing.
+     */
+    private void alignMorphTextTowardsReal(float eased) {
+        TextView real = liveBarText();
+        View location = mActivity.findViewById(R.id.location_bar);
+        LinearLayout pill = mOriginPill;
+        float[] target = new float[2];
+        if (real == null
+                || location == null
+                || pill == null
+                || !location.isAttachedToWindow()
+                || !pill.isAttachedToWindow()
+                || !glyphOrigin(real, false, target)) {
+            resetMorphTextShift();
+            return;
+        }
+        int[] barAt = new int[2];
+        location.getLocationOnScreen(barAt);
+        int[] pillAt = new int[2];
+        pill.getLocationOnScreen(pillAt);
+        float keep = 1f - eased;
+        float[] own = new float[2];
+        for (TextView view : new TextView[] {mPillOrigin, mMorphFromText}) {
+            if (view == null) continue;
+            if (view.getVisibility() != View.VISIBLE || !glyphOrigin(view, true, own)) {
+                view.setTranslationX(0f);
+                view.setTranslationY(0f);
+                continue;
+            }
+            view.setTranslationX(keep * ((target[0] - barAt[0]) - (own[0] - pillAt[0])));
+            view.setTranslationY(keep * ((target[1] - barAt[1]) - (own[1] - pillAt[1])));
+        }
+        mMorphTextShifted = true;
+    }
+
+    private void resetMorphTextShift() {
+        mMorphTextShifted = false;
+        for (TextView view : new TextView[] {mPillOrigin, mMorphFromText}) {
+            if (view == null) continue;
+            view.setTranslationX(0f);
+            view.setTranslationY(0f);
+        }
+    }
+
     /**
      * Screen x of the first glyph and screen y of the first baseline. A view's own translation
      * is part of its screen position; {@code withoutTranslation} takes it out.
@@ -5617,6 +5686,7 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
         }
         mOriginTextStyled = false;
         clearMorphTextMatch();
+        if (mMorphTextShifted) resetMorphTextShift();
         if (mPillLock != null && mPillLock.getVisibility() != mPillLockVisibility) {
             mPillLock.setVisibility(mPillLockVisibility);
         }
@@ -5958,6 +6028,10 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
         // The hand-off reads every icon from its live view. The stored rects are from before
         // the sheet opened, and a view that has since gone has no place on the bar.
         boolean live = mHandoffLive && (mForceBarRect || mCloseReveal);
+        // The way down already shows what the hand-off will: a copy of the real icon, with its
+        // padding, scale type and badge. The bare drawable fills the whole padded box, so it is
+        // drawn larger than the real glyph, and the hand-off's first frame is a drop in size.
+        boolean closing = mMorphClosing;
         for (int i = 0; i < n && used < 16; i++) {
             ImageView source = sources[i];
             if (live && !isLaidOutIcon(source)) continue;
@@ -5999,7 +6073,10 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
             int w = Math.max(1, Math.round(sourceW * extraScale));
             int h = Math.max(1, Math.round(sourceH * extraScale));
             ImageView ghost = morphGhost(used);
-            if (!live || !drawIconSnapshot(ghost, source)) {
+            boolean copied =
+                    (live || (closing && isLaidOutIcon(source)))
+                            && drawIconSnapshot(ghost, source);
+            if (!copied) {
                 if (ghost.getScaleType() != ImageView.ScaleType.FIT_CENTER) {
                     ghost.setScaleType(ImageView.ScaleType.FIT_CENTER);
                 }
@@ -6353,6 +6430,11 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
             background.setColor(fill);
         }
         applyMorphText(shrink, eased);
+        // On the way down the text is walked onto the real glyphs, so the first frame the hand-off
+        // draws the real url text is not a step. The hand-off frames have their own alignment.
+        boolean shiftText =
+                mMorphClosing && eased < 1f && !(mHandoffLive && (mForceBarRect || mCloseReveal));
+        if (!shiftText && mMorphTextShifted) resetMorphTextShift();
         applyBottomSheetFamilyColors();
         // Below half the list can overlap the handle row, so the pill rides the sheet top on
         // the root, above the cards, and is parked in the handle row only from half up.
@@ -6393,7 +6475,11 @@ public final class BareVerticalTabsDrawer implements BareTabSheetToolbarSwipe.Sh
                 setTextStackMargin(0);
             }
             placePillOnRoot(pill, root, width, height, left, top);
-            if (live) alignMorphText(liveBarText());
+            if (live) {
+                alignMorphText(liveBarText());
+            } else if (shiftText) {
+                alignMorphTextTowardsReal(eased);
+            }
             syncMorphIcons(anchor, eased, left, top, width, height);
             syncMorphUrlSnapshot(live, left, top);
         }
diff --git a/chrome/android/junit/src/org/chromium/chrome/browser/bare/BareVerticalTabsDrawerUnitTest.java b/chrome/android/junit/src/org/chromium/chrome/browser/bare/BareVerticalTabsDrawerUnitTest.java
index c7c966d230..f92eed01b8 100755
--- a/chrome/android/junit/src/org/chromium/chrome/browser/bare/BareVerticalTabsDrawerUnitTest.java
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/bare/BareVerticalTabsDrawerUnitTest.java
@@ -2173,6 +2173,323 @@ public class BareVerticalTabsDrawerUnitTest {
         assertEquals(1f, origin.getAlpha(), 0.001f);
     }
 
+    /**
+     * Pulls a bottom-bar sheet up from {@code bar}, with {@code icon} on its right, through the
+     * given progress values, with a layout pass after each. The first value is a few pixels,
+     * which is early enough for the drawer to store the resting rects of the bar and its icons.
+     */
+    private void pullOpenOnABar(
+            View bar, android.widget.ImageView icon, float... progressFrames) {
+        GradientDrawable barBackground = new GradientDrawable();
+        barBackground.setColor(0xFF123456);
+        barBackground.setCornerRadius(px(12));
+        bar.setBackground(barBackground);
+        content().addView(bar, new FrameLayout.LayoutParams(px(280), px(48), Gravity.BOTTOM));
+        if (icon.getDrawable() == null) icon.setImageDrawable(new ColorDrawable(0xFFFF0000));
+        content().addView(icon, new FrameLayout.LayoutParams(px(24), px(24), Gravity.BOTTOM));
+        Runnable placeIcon =
+                () ->
+                        icon.layout(
+                                bar.getLeft() + bar.getWidth() - px(32),
+                                bar.getTop() + px(12),
+                                bar.getLeft() + bar.getWidth() - px(8),
+                                bar.getTop() + px(36));
+        mDrawer.beginToolbarPull();
+        View root = (View) findTag("sheet_actions").getParent().getParent();
+        content().measure(
+                View.MeasureSpec.makeMeasureSpec(px(400), View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(px(800), View.MeasureSpec.EXACTLY));
+        content().layout(0, 0, px(400), px(800));
+        layoutOverlay(root, px(400), px(800));
+        placeIcon.run();
+        int range = root.getHeight() - sheetGap();
+        for (float progress : progressFrames) {
+            mDrawer.updateToolbarPull(range * progress);
+            content().layout(0, 0, px(400), px(800));
+            layoutOverlay(root, px(400), px(800));
+            placeIcon.run();
+        }
+    }
+
+    /** Lets go of a pulled sheet into a close. The way down is not run: tests set its frames. */
+    private void startTheClose() {
+        mDrawer.endToolbarPull(0f);
+        mDrawer.close();
+    }
+
+    private TextView barWithInsetText() {
+        TextView bar = new TextView(mActivity);
+        bar.setId(org.chromium.chrome.R.id.location_bar);
+        bar.setText("https://example.com/some/path");
+        // The glyphs start well inside the view, and sit on a baseline of their own.
+        bar.setPadding(px(30), px(9), px(6), px(1));
+        bar.setIncludeFontPadding(false);
+        return bar;
+    }
+
+    /** The frames of a close that is still on its way to the bar. */
+    private static final float[] CLOSE_TRAVEL = {0.4f, 0.25f, 0.1f, 0.04f, 0.002f};
+
+    @Test
+    public void testClosingMorphIconCopyIsABitmapOfTheRealIconBoxBeforeTheHandoff() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        TextView bar = barWithInsetText();
+        android.widget.ImageView shield = new android.widget.ImageView(mActivity);
+        // A 24px box that draws a smaller glyph in its middle, like a padded toolbar button.
+        shield.setScaleType(android.widget.ImageView.ScaleType.CENTER);
+        shield.setPadding(px(6), px(6), px(6), px(6));
+        pullOpenOnABar(bar, shield, 0.004f, 0.2f, 0.45f);
+        startTheClose();
+
+        for (float progress : new float[] {0.1f, 0.04f, 0.002f}) {
+            mDrawer.applyProgressForTesting(progress);
+            android.widget.ImageView ghost =
+                    (android.widget.ImageView) findTag("morph_extra_icon");
+            assertNotNull(ghost);
+            String at = " at " + progress;
+            assertEquals("shown" + at, View.VISIBLE, ghost.getVisibility());
+            assertEquals(
+                    "box" + at,
+                    android.widget.ImageView.ScaleType.FIT_XY,
+                    ghost.getScaleType());
+            assertTrue(
+                    "bitmap" + at,
+                    ghost.getDrawable() instanceof android.graphics.drawable.BitmapDrawable);
+            Bitmap copy =
+                    ((android.graphics.drawable.BitmapDrawable) ghost.getDrawable()).getBitmap();
+            assertEquals("copy width" + at, shield.getWidth(), copy.getWidth());
+            assertEquals("copy height" + at, shield.getHeight(), copy.getHeight());
+        }
+    }
+
+    @Test
+    public void testClosingMorphIconCopyKeepsItsSizeAndPlaceAcrossTheHandoffFrame() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        TextView bar = barWithInsetText();
+        android.widget.ImageView shield = new android.widget.ImageView(mActivity);
+        shield.setScaleType(android.widget.ImageView.ScaleType.CENTER);
+        shield.setPadding(px(6), px(6), px(6), px(6));
+        pullOpenOnABar(bar, shield, 0.004f, 0.2f, 0.45f);
+        startTheClose();
+        mDrawer.applyProgressForTesting(0.1f);
+        mDrawer.applyProgressForTesting(0.04f);
+        mDrawer.applyProgressForTesting(0.002f);
+        android.widget.ImageView ghost = (android.widget.ImageView) findTag("morph_extra_icon");
+        assertNotNull(ghost);
+        int widthBefore = ghost.getLayoutParams().width;
+        int heightBefore = ghost.getLayoutParams().height;
+        int[] before = new int[2];
+        ghost.getLocationOnScreen(before);
+
+        // The frame the page shifts on and the pill hands over to the real bar.
+        mDrawer.endAnimationForTesting();
+        assertEquals(0f, mDrawer.progressForTesting(), 0.0005f);
+        assertEquals(View.VISIBLE, ghost.getVisibility());
+        int[] after = new int[2];
+        ghost.getLocationOnScreen(after);
+
+        // The copy already had the real icon's size, so the frame changes nothing of it.
+        assertEquals(shield.getWidth(), widthBefore, 1);
+        assertEquals(shield.getHeight(), heightBefore, 1);
+        assertEquals(widthBefore, ghost.getLayoutParams().width, 1);
+        assertEquals(heightBefore, ghost.getLayoutParams().height, 1);
+        assertEquals(before[0], after[0], 1);
+        assertEquals(before[1], after[1], 1);
+        assertSameScreenPosition(shield, ghost);
+    }
+
+    @Test
+    public void testOpeningMorphIconCopyStaysTheBareDrawableOnTheWayUp() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        TextView bar = barWithInsetText();
+        android.widget.ImageView shield = new android.widget.ImageView(mActivity);
+        shield.setScaleType(android.widget.ImageView.ScaleType.CENTER);
+        shield.setPadding(px(6), px(6), px(6), px(6));
+        pullOpenOnABar(bar, shield, 0.004f, 0.03f);
+
+        // Only a close ends on the real bar. The way up keeps the drawable copy.
+        android.widget.ImageView ghost = (android.widget.ImageView) findTag("morph_extra_icon");
+        assertNotNull(ghost);
+        assertEquals(View.VISIBLE, ghost.getVisibility());
+        assertEquals(android.widget.ImageView.ScaleType.FIT_CENTER, ghost.getScaleType());
+        assertFalse(ghost.getDrawable() instanceof android.graphics.drawable.BitmapDrawable);
+    }
+
+    @Test
+    public void testClosingMorphTextIsOnTheRealGlyphsForTheLastFrameBeforeTheHandoff() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        TextView bar = barWithInsetText();
+        pullOpenOnABar(bar, new android.widget.ImageView(mActivity), 0.004f, 0.2f, 0.45f);
+        startTheClose();
+        TextView copy = (TextView) findTag("morph_from_text");
+        assertNotNull(copy);
+        float[] real = glyphOrigin(bar);
+
+        for (float progress : CLOSE_TRAVEL) {
+            mDrawer.applyProgressForTesting(progress);
+        }
+        assertEquals(View.VISIBLE, copy.getVisibility());
+        float[] before = glyphOrigin(copy);
+        assertEquals("x before the hand-off", real[0], before[0], 1f);
+        assertEquals("baseline before the hand-off", real[1], before[1], 1f);
+
+        // The hand-off's first frame does not move the glyphs.
+        mDrawer.endAnimationForTesting();
+        assertEquals(View.VISIBLE, copy.getVisibility());
+        float[] after = glyphOrigin(copy);
+        assertEquals("x across the hand-off", before[0], after[0], 1f);
+        assertEquals("baseline across the hand-off", before[1], after[1], 1f);
+        assertEquals(real[0], after[0], 1f);
+        assertEquals(real[1], after[1], 1f);
+    }
+
+    @Test
+    public void testClosingMorphTextShiftFadesOutAsThePillTakesItsOwnShape() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        TextView bar = barWithInsetText();
+        pullOpenOnABar(bar, new android.widget.ImageView(mActivity), 0.004f, 0.2f, 0.45f);
+        startTheClose();
+        TextView copy = (TextView) findTag("morph_from_text");
+        TextView origin = (TextView) findTag("sheet_pill_origin");
+        assertNotNull(copy);
+        assertNotNull(origin);
+
+        // Near the top the bar text is already the label, which is the view that carries the shift.
+        mDrawer.applyProgressForTesting(0.4f);
+        float nearTheTop = Math.abs(origin.getTranslationX());
+        mDrawer.applyProgressForTesting(0.25f);
+        float aQuarter = Math.abs(copy.getTranslationX());
+        mDrawer.applyProgressForTesting(0.1f);
+        float aTenth = Math.abs(copy.getTranslationX());
+        mDrawer.applyProgressForTesting(0.002f);
+        float onTheBar = Math.abs(copy.getTranslationX());
+
+        // The glyphs sit 30px inside the real view, so the shift is real at the bar rect. It
+        // grows as the pill comes down, and is all but gone where the pill is the small pill.
+        assertTrue("shift on the bar " + onTheBar, onTheBar > 5f);
+        assertTrue("shift " + aTenth + " vs " + onTheBar, aTenth < onTheBar);
+        assertTrue("shift " + aQuarter + " vs " + aTenth, aQuarter < aTenth);
+        assertTrue(
+                "shift near the top " + nearTheTop + " vs " + onTheBar,
+                nearTheTop < 0.25f * onTheBar);
+    }
+
+    @Test
+    public void testClosingMorphTextKeepsTheRealUrlInsetAndWidthBeforeTheHandoff() {
+        setAddressBarOnTop(false);
+        BareTabsStyle.setStyle(BareTabsStyle.SHEET);
+        FrameLayout bar = new FrameLayout(mActivity);
+        bar.setId(org.chromium.chrome.R.id.location_bar);
+        TextView url = new TextView(mActivity);
+        url.setId(org.chromium.chrome.R.id.url_bar);
+        url.setText("https://www.example.com/a/rather/long/path/that/does/not/fit/in/the/bar.html");
+        url.setSingleLine(true);
+        url.setEllipsize(TextUtils.TruncateAt.END);
+        // The glyphs start 12px inside the url view, and end 30px short of its edge.
+        url.setPaddingRelative(px(12), 0, px(30), 0);
+        FrameLayout.LayoutParams urlParams =
+                new FrameLayout.LayoutParams(px(240), ViewGroup.LayoutParams.WRAP_CONTENT);
+        urlParams.gravity = Gravity.CENTER_VERTICAL | Gravity.START;
+        urlParams.leftMargin = px(20);
+        bar.addView(url, urlParams);
+        android.widget.ImageView favicon = new android.widget.ImageView(mActivity);
+        favicon.setId(org.chromium.chrome.R.id.location_bar_site_favicon);
+        pullOpenOnABar(bar, favicon, 0.004f, 0.2f, 0.45f);
+        startTheClose();
+        TextView copy = (TextView) findTag("morph_from_text");
+        assertNotNull(copy);
+        float[] real = glyphOrigin(url);
+
+        for (float progress : CLOSE_TRAVEL) {
+            mDrawer.applyProgressForTesting(progress);
+        }
+        assertEquals(View.VISIBLE, copy.getVisibility());
+        float[] before = glyphOrigin(copy);
+        assertEquals("x before the hand-off", real[0], before[0], 1f);
+        assertEquals("baseline before the hand-off", real[1], before[1], 1f);
+        // The inset comes from the pill's own padding, not from a shift that happens to cancel it.
+        assertEquals(0f, copy.getTranslationX(), 1f);
+        // And the text has the width the real url text has, so it ellipsizes where that does.
+        int copyWidth = copy.getWidth() - copy.getCompoundPaddingLeft() - copy.getCompoundPaddingRight();
+        int urlWidth = url.getWidth() - url.getCompoundPaddingLeft() - url.getCompoundPaddingRight();
+        assertEquals(urlWidth, copyWidth, 1);
+
+        mDrawer.endAnimationForTesting();
