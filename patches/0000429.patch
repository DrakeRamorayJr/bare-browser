+    @Test
+    public void testModelIndexForDropRemovesThenInserts() {
+        // Down one: [0, 1, 2] with 0 dropped on 1. Lands at the old index of 1.
+        assertEquals(1, dropIndex(java.util.Arrays.asList(1, 0, 2), 1, 0));
+        // Down several, to the end.
+        assertEquals(2, dropIndex(java.util.Arrays.asList(1, 2, 0), 2, 0));
+        // Up one.
+        assertEquals(1, dropIndex(java.util.Arrays.asList(0, 2, 1), 1, 2));
+        // Up to the top: just before the tab now at row 1.
+        assertEquals(0, dropIndex(java.util.Arrays.asList(2, 0, 1), 0, 2));
+
+        // A closing tab hides model index 1, so the rows are 0, 2, 3.
+        // Down one, from 0 onto the row whose model index is 2.
+        assertEquals(2, dropIndex(java.util.Arrays.asList(2, 0, 3), 1, 0));
+        // Down to the end.
+        assertEquals(3, dropIndex(java.util.Arrays.asList(2, 3, 0), 2, 0));
+        // Up one. Insert at the model index of the row now below, which is 2.
+        assertEquals(2, dropIndex(java.util.Arrays.asList(0, 3, 2), 1, 3));
+        // Up to the top, just before model index 0.
+        assertEquals(0, dropIndex(java.util.Arrays.asList(3, 0, 2), 0, 3));
+    }
