+    private java.util.List<String> actionLabels(View view) {
+        AccessibilityNodeInfo node = AccessibilityNodeInfo.obtain();
+        androidx.core.view.ViewCompat.onInitializeAccessibilityNodeInfo(
+                view, androidx.core.view.accessibility.AccessibilityNodeInfoCompat.wrap(node));
+        java.util.List<String> labels = new java.util.ArrayList<>();
+        for (AccessibilityNodeInfo.AccessibilityAction action : node.getActionList()) {
+            CharSequence label = action.getLabel();
+            if (label != null) labels.add(label.toString());
+        }
+        node.recycle();
+        return labels;
+    }
