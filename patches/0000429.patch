+        /** Moves one card from {@code from} onto {@code to}. Returns whether it moved. */
+        boolean moveLocal(int from, int to) {
+            if (from == to || from < 0 || to < 0 || from >= mTabs.size() || to >= mTabs.size()) {
+                return false;
+            }
+            Tab dragged = mTabs.get(from);
+            Tab target = mTabs.get(to);
+            if (!canMoveOnto(dragged, target)) return false;
+            mTabs = new ArrayList<>(mTabs);
+            // One step is a swap. A longer jump removes the card and inserts it at the new index.
+            if (Math.abs(to - from) == 1) {
+                Collections.swap(mTabs, from, to);
+            } else {
+                mTabs.add(to, mTabs.remove(from));
+            }
+            notifyItemMoved(from, to);
+            return true;
+        }
