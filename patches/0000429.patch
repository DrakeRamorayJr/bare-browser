+    /**
+     * Whether {@code dragged} may take the place of {@code target}. Pinned tabs stay among the
+     * pinned tabs. A tab in a group stays in that group. A tab with no group may pass any tab
+     * that has the same pinned state; the model pulls it back out of a group on commit.
+     */
+
+    /**
+     * Whether the drop point sits inside the card. The right and bottom edges belong to the
+     * next card, so a point exactly on a shared border is not inside this one.
+     */
+    static boolean dropPointHitsCard(int cx, int cy, int left, int top, int right, int bottom) {
+        return cx >= left && cx < right && cy >= top && cy < bottom;
+    }
+
+    static boolean canMoveOnto(Tab dragged, Tab target) {
+        if (dragged.getIsPinned() != target.getIsPinned()) return false;
+        @Nullable Token group = dragged.getTabGroupId();
+        if (group == null) return true;
+        return Objects.equals(group, target.getTabGroupId());
+    }
+
+    /**
+     * The index for {@code TabModel.moveTab} after a drop. moveTab removes the tab, then inserts
+     * it at {@code newIndex}.
+     *
+     * <p>{@code adapterModelIndices} are the model indexes of the rows after the local move, still
+     * the indexes from before the commit. {@code droppedPosition} is the row the tab landed on.
+     * Moving down inserts at the old model index of the row now above the tab: removing the tab
+     * first shifts that row left, so that old index is already the slot just after it. Moving up
+     * inserts at the old model index of the row now below the tab, which is the slot just before
+     * that row. At the top there is no row above, so the insert index is the row below. A closing
+     * tab is missing from the list, so these indexes are not adapter positions.
+     */
+    static int modelIndexForDrop(
+            List<Integer> adapterModelIndices, int droppedPosition, int fromModelIndex) {
+        int count = adapterModelIndices.size();
+        if (droppedPosition < 0 || droppedPosition >= count) return fromModelIndex;
+        if (droppedPosition == 0) {
+            if (count < 2) return fromModelIndex;
+            int successor = adapterModelIndices.get(1);
+            // Already above that tab: removing this one shifts it left by one.
+            return fromModelIndex < successor ? successor - 1 : successor;
+        }
+        int predecessor = adapterModelIndices.get(droppedPosition - 1);
+        if (fromModelIndex < predecessor) return predecessor;
+        if (droppedPosition + 1 < count) return adapterModelIndices.get(droppedPosition + 1);
+        return predecessor + 1;
+    }
+
+    /** Runs the same move and drop-commit path a drag uses. */
+    void moveForTesting(int fromPosition, int toPosition) {
+        TabAdapter adapter = mAdapter;
+        if (adapter == null || fromPosition == toPosition) return;
+        if (!startReorder(fromPosition)) return;
+        int step = Integer.compare(toPosition, fromPosition);
+        int position = fromPosition;
+        while (position != toPosition) {
+            if (!adapter.moveLocal(position, position + step)) break;
+            position += step;
+        }
+        commitIfMoved();
+        refreshAfterReorder();
+    }
+
+    private boolean startReorder(int adapterPosition) {
+        TabAdapter adapter = mAdapter;
+        TabModel model = currentModel();
+        if (adapter == null || model == null) return false;
+        Tab tab = adapter.tabAt(adapterPosition);
+        if (tab == null) return false;
+        mDragTab = tab;
+        mDragFromAdapterPosition = adapterPosition;
+        mDragFromModelIndex = model.indexOf(tab);
+        mDragging = true;
+        return true;
+    }
+
+    /** Drops the drag state without committing. A refused step never changed the order. */
+    private void cancelReorder() {
+        mDragging = false;
+        mDragTab = null;
+        mDragFromModelIndex = -1;
+        mDragFromAdapterPosition = -1;
+        if (mRefreshPending) refreshAfterReorder();
+    }
+
+    /**
+     * Commits the drop once, if the card's row changed. The model index comes from
+     * {@link #modelIndexForDrop}. Selection is left alone.
+     */
+    private void commitIfMoved() {
+        Tab tab = mDragTab;
+        int fromModel = mDragFromModelIndex;
+        int fromAdapter = mDragFromAdapterPosition;
+        boolean was = mDragging;
+        int dest = -1;
+        if (was && tab != null && fromModel >= 0) {
+            int dropped = adapterIndexOf(tab);
+            if (dropped >= 0 && dropped != fromAdapter) {
+                int index = destinationIndex(dropped, fromModel);
+                if (index >= 0 && index != fromModel) dest = index;
+            }
+        }
+        mDragging = false;
+        mDragTab = null;
+        mDragFromModelIndex = -1;
+        mDragFromAdapterPosition = -1;
+        if (dest < 0 || tab == null) return;
+        TabModel model = currentModel();
+        // The list may have switched models, or the tab moved, while it was held.
+        if (model == null || model.indexOf(tab) != fromModel) return;
+        model.moveTab(tab.getId(), dest);
+    }
+
+    private void refreshAfterReorder() {
+        mRefreshPending = false;
+        refreshSoon();
+    }
+
+    private int adapterIndexOf(Tab tab) {
+        TabAdapter adapter = mAdapter;
+        if (adapter == null) return -1;
+        return adapter.indexOf(tab);
+    }
+
+    private int destinationIndex(int droppedPosition, int fromModelIndex) {
+        TabAdapter adapter = mAdapter;
+        TabModel model = currentModel();
+        if (adapter == null || model == null) return fromModelIndex;
+        List<Integer> indices = new ArrayList<>();
+        for (int i = 0; i < adapter.getItemCount(); i++) {
+            Tab item = adapter.tabAt(i);
+            if (item == null) return fromModelIndex;
+            indices.add(model.indexOf(item));
+        }
+        return modelIndexForDrop(indices, droppedPosition, fromModelIndex);
+    }
+
+    /**
+     * Moves {@code tab} one row and commits it the way a drop does. The caller plays the drop
+     * haptic and then posts the refresh.
+     */
+    private boolean moveOne(Tab tab, int delta) {
+        if (mDragging) return false;
+        TabAdapter adapter = mAdapter;
+        if (adapter == null) return false;
+        int from = adapter.indexOf(tab);
+        if (from < 0 || !startReorder(from)) return false;
+        if (!adapter.moveLocal(from, from + delta)) {
+            cancelReorder();
+            return false;
+        }
+        commitIfMoved();
+        return true;
+    }
+
+    /** A solid rounded fill, so a lifted list row stays visible. Grid cards are already opaque. */
+    private void liftCard(View card) {
+        card.setScaleX(1.03f);
+        card.setScaleY(1.03f);
+        if (mGrid) return;
+        if (mLiftedCard == card) return;
+        View previous = mLiftedCard;
+        if (previous != null) restoreCard(previous);
+        mLiftedCard = card;
+        mSavedDragBackground = card.getBackground();
+        GradientDrawable fill = new GradientDrawable();
+        fill.setCornerRadius(dp(13));
+        fill.setColor(color(0xFF303137, 0xFFE3E3E8));
+        card.setBackground(fill);
+    }
+
+    private void restoreCard(View card) {
+        card.setScaleX(1f);
+        card.setScaleY(1f);
+        if (mLiftedCard != card) return;
+        mLiftedCard = null;
+        Drawable saved = mSavedDragBackground;
+        mSavedDragBackground = null;
+        if (saved != null) card.setBackground(saved);
+    }
