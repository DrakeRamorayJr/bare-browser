+    /**
+     * Drops the compositor's toolbar texture while the morph is the only pill.
+     * View alpha does not change that texture. Set only when the flag changes:
+     * the supplier notifies observers even if the boolean is the same.
+     */
+    private void suppressToolbarSceneLayer(boolean suppress) {
+        // Same value must not notify. The supplier fires observers even when the
+        // boolean did not change, and this runs from layout.
+        if (suppress == mToolbarSceneSuppressed) return;
+        mToolbarSceneSuppressed = suppress;
+        // The last toolbar texture is drawn about one bar above the view for a
+        // frame after this. Cover that strip, then drop the extra on the next frames.
+        mGhostCoverFrames = suppress ? 4 : 0;
+        if (!(mActivity instanceof ChromeActivity chromeActivity)) return;
+        if (chromeActivity.getToolbarManager() == null) return;
+        chromeActivity.getToolbarManager().setBareSheetHidesToolbarSceneLayer(suppress);
+    }
