+package org.chromium.chrome.browser.bare;
+
+import android.view.MotionEvent;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.browser_ui.widget.gesture.SwipeGestureListener.ScrollDirection;
+import org.chromium.components.browser_ui.widget.gesture.SwipeGestureListener.SwipeHandler;
+
+/**
+ * Lets a vertical drag on the address bar pull the tab sheet out with the finger.
+ *
+ * <p>It wraps the toolbar's own swipe handler instead of listening to touches itself. The
+ * toolbar's gesture listener already settles a drag's direction once, when the finger has moved
+ * far enough: a sideways drag goes on to switch tabs as before and never reaches the sheet, and a
+ * drag that started vertical stays with the sheet even if it later drifts sideways. Taps and long
+ * presses never become a swipe, so they reach the address bar and its buttons untouched.
+ *
+ * <p>Only the drag away from the address bar is taken, and only while the sheet is the chosen
+ * tabs style: up from a bottom address bar, down from a top one. Every other gesture, and every
+ * gesture with the side drawer, goes to the wrapped handler unchanged.
+ */
+@NullMarked
+public final class BareTabSheetToolbarSwipe implements SwipeHandler {
+    /** The sheet a toolbar drag moves. */
+    public interface Sheet {
+        /** Whether a drag on the toolbar should move the sheet now. */
+        boolean wantsToolbarPull();
+
+        /** Whether the sheet opens downward, from a top address bar. */
+        boolean opensDownward();
+
+        /** The drag has started: show the sheet where it is, without animating. */
+        void beginToolbarPull();
+
+        /** The finger is {@code openingPx} pixels past where the drag started, away from the bar. */
+        void updateToolbarPull(float openingPx);
+
+        /**
+         * The finger has lifted. {@code velocityY} is in pixels per second on the screen, positive
+         * downward, or 0 when the finger was not flung.
+         */
+        void endToolbarPull(float velocityY);
+    }
+
+    private final @Nullable SwipeHandler mDelegate;
+    private final Sheet mSheet;
+    private boolean mPulling;
+    private boolean mDownward;
+    private float mFlingVelocityY;
+
+    public BareTabSheetToolbarSwipe(@Nullable SwipeHandler delegate, Sheet sheet) {
+        mDelegate = delegate;
+        mSheet = sheet;
+    }
+
+    /** The direction that pulls the sheet out, or UNKNOWN when the sheet does not want drags. */
+    private @ScrollDirection int pullDirection() {
+        if (!mSheet.wantsToolbarPull()) return ScrollDirection.UNKNOWN;
+        return mSheet.opensDownward() ? ScrollDirection.DOWN : ScrollDirection.UP;
+    }
+
+    @Override
+    public boolean isSwipeEnabled(@ScrollDirection int direction, MotionEvent triggerEvent) {
+        if (direction != ScrollDirection.UNKNOWN && direction == pullDirection()) return true;
+        return mDelegate != null && mDelegate.isSwipeEnabled(direction, triggerEvent);
+    }
+
+    @Override
+    public void onSwipeStarted(@ScrollDirection int direction, MotionEvent triggerEvent) {
+        mPulling = false;
+        mFlingVelocityY = 0f;
+        if (direction != ScrollDirection.UNKNOWN && direction == pullDirection()) {
+            mPulling = true;
+            mDownward = direction == ScrollDirection.DOWN;
+            mSheet.beginToolbarPull();
+            return;
+        }
+        if (mDelegate != null) mDelegate.onSwipeStarted(direction, triggerEvent);
+    }
+
+    @Override
+    public void onSwipeUpdated(
+            MotionEvent current, float tx, float ty, float distanceX, float distanceY) {
+        if (mPulling) {
+            mSheet.updateToolbarPull(mDownward ? ty : -ty);
+            return;
+        }
+        if (mDelegate != null) mDelegate.onSwipeUpdated(current, tx, ty, distanceX, distanceY);
+    }
+
+    @Override
+    public void onFling(
+            @ScrollDirection int direction,
+            MotionEvent current,
+            float tx,
+            float ty,
+            float velocityX,
+            float velocityY) {
+        if (mPulling) {
+            mFlingVelocityY = velocityY;
+            return;
+        }
+        if (mDelegate != null) {
+            mDelegate.onFling(direction, current, tx, ty, velocityX, velocityY);
+        }
+    }
+
+    @Override
+    public void onSwipeFinished() {
+        if (mPulling) {
+            mPulling = false;
+            float velocity = mFlingVelocityY;
+            mFlingVelocityY = 0f;
+            mSheet.endToolbarPull(velocity);
+            return;
+        }
+        if (mDelegate != null) mDelegate.onSwipeFinished();
+    }
+}
