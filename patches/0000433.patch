+
+    /** Stands in for the toolbar's own handler: takes every direction and records what it gets. */
+    private static final class Delegate implements SwipeHandler {
+        final List<Integer> mStarted = new ArrayList<>();
+        int mUpdates;
+        int mFinished;
+        int mFlings;
+
+        @Override
+        public void onSwipeStarted(@ScrollDirection int direction, MotionEvent triggerEvent) {
+            mStarted.add(direction);
+        }
+
+        @Override
+        public void onSwipeUpdated(MotionEvent current, float tx, float ty, float dx, float dy) {
+            mUpdates++;
+        }
+
+        @Override
+        public void onSwipeFinished() {
+            mFinished++;
+        }
+
+        @Override
+        public void onFling(
+                @ScrollDirection int direction,
+                MotionEvent current,
+                float tx,
+                float ty,
+                float vx,
+                float vy) {
+            mFlings++;
+        }
+    }
