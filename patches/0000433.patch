+    private void send(int action, float x, float y) {
+        MotionEvent event = MotionEvent.obtain(mDownTime, mTime, action, x, y, 0);
+        mListener.onTouchEvent(event);
+        event.recycle();
+    }
+
+    private void down(float x, float y) {
+        mDownTime = SystemClock.uptimeMillis();
+        mTime = mDownTime;
+        send(MotionEvent.ACTION_DOWN, x, y);
+    }
+
+    private void move(float x, float y) {
